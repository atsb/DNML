x = (yyn < 0 ? -yyn : 0);	       x < (sizeof(yytname) / sizeof(char *)); x++)	    if (yycheck[x + yyn] == x)	      size += strlen(yytname[x]) + 15, count++;	  msg = (char *) malloc(size + 15);	  if (msg != 0)	    {	      strcpy(msg, "parse error");	      if (count < 5)		{		  count = 0;		  for (x = (yyn < 0 ? -yyn : 0);		       x < (sizeof(yytname) / sizeof(char *)); x++)		    if (yycheck[x + yyn] == x)		      {			strcat(msg, count == 0 ? ", expecting `" : " or `");			strcat(msg, yytname[x]);			strcat(msg, "'");			count++;		      }		}	      YY_DnmlParse_ERROR(msg);	      free(msg);	    }	  else	    YY_DnmlParse_ERROR ("parse error; also virtual memory exceeded");	}      else#endif /* YY_DnmlParse_ERROR_VERBOSE */	YY_DnmlParse_ERROR("parse error");    }  YYGOTO(yyerrlab1);YYLABEL(yyerrlab1)   /* here on error raised explicitly by an action */  if (yyerrstatus == 3)    {      /* if just tried and failed to reuse lookahead token after an error, discard it.  */      /* return failure if at end of input */      if (YY_DnmlParse_CHAR == YYEOF)	YYABORT;#if YY_DnmlParse_DEBUG != 0      if (YY_DnmlParse_DEBUG_FLAG)	fprintf(stderr, "Discarding token %d (%s).\n", YY_DnmlParse_CHAR, yytname[yychar1]);#endif      YY_DnmlParse_CHAR = YYEMPTY;    }  /* Else will try to reuse lookahead token     after shifting the error token.  */  yyerrstatus = 3;              /* Each real token shifted decrements this */  YYGOTO(yyerrhandle);YYLABEL(yyerrdefault)  /* current state does not do anything special for the error token. */#if 0  /* This is wrong; only states that explicitly want error tokens     should shift them.  */  yyn = yydefact[yystate];  /* If its default is to accept any token, ok.  Otherwise pop it.*/  if (yyn) YYGOTO(yydefault);#endifYYLABEL(yyerrpop)   /* pop the current state because it cannot handle the error token */  if (yyssp == yyss) YYABORT;  yyvsp--;  yystate = *--yyssp;#ifdef YY_DnmlParse_LSP_NEEDED  yylsp--;#endif#if YY_DnmlParse_DEBUG != 0  if (YY_DnmlParse_DEBUG_FLAG)    {      short *ssp1 = yyss - 1;      fprintf (stderr, "Error: state stack now");      while (ssp1 != yyssp)	fprintf (stderr, " %d", *++ssp1);      fprintf (stderr, "\n");    }#endifYYLABEL(yyerrhandle)  yyn = yypact[yystate];  if (yyn == YYFLAG)    YYGOTO(yyerrdefault);  yyn += YYTERROR;  if (yyn < 0 || yyn > YYLAST || yycheck[yyn] != YYTERROR)    YYGOTO(yyerrdefault);  yyn = yytable[yyn];  if (yyn < 0)    {      if (yyn == YYFLAG)	YYGOTO(yyerrpop);      yyn = -yyn;      YYGOTO(yyreduce);    }  else if (yyn == 0)    YYGOTO(yyerrpop);  if (yyn == YYFINAL)    YYACCEPT;#if YY_DnmlParse_DEBUG != 0  if (YY_DnmlParse_DEBUG_FLAG)    fprintf(stderr, "Shifting error token, ");#endif  *++yyvsp = YY_DnmlParse_LVAL;#ifdef YY_DnmlParse_LSP_NEEDED  *++yylsp = YY_DnmlParse_LLOC;#endif  yystate = yyn;  YYGOTO(yynewstate);/* end loop, in which YYGOTO may be used. */  YYENDGOTO}/* END */#ifdef YY_USE_CLASSYY_DnmlParse_CLASS::#endif~YY_DnmlParse_CLASS(){	for (int i = 0; i < tagArray->GetCount(); i++) {		TagBasic	*btag = *(TagBasic**)(tagArray->GetItemPtr(i));		switch (btag->getTagType()) {			case T_A:				delete ((TagA*)btag);				break;			case T_ACT:				delete ((TagAct*)btag);				break;			case T_ALIAS:				delete ((TagAlias*)btag);				break;			case T_ALIAS_E:				delete ((TagEAlias*)btag);				break;			case T_B:				delete ((TagB*)btag);				break;			case T_B_E:				delete ((TagEB*)btag);				break;			case T_BACKGROUND:				delete ((TagBackground*)btag);				break;			case T_BGM:				delete ((TagBgm*)btag);				break;			case T_BGM_E:				delete ((TagEBgm*)btag);				break;			case T_BOOKMARK:				delete ((TagBookmark*)btag);				break;			case T_BR:				delete ((TagBr*)btag);				break;			case T_CARD:				delete ((TagCard*)btag);				break;			case T_CLIP:				delete ((TagClip*)btag);				break;			case T_CLIP_E:				delete ((TagEClip*)btag);				break;			case T_COMMAND:				delete ((TagCommand*)btag);				break;			case T_COVER:				delete ((TagCover*)btag);				break;			case T_CURSOR:				delete ((TagCursor*)btag);				break;			case T_CURTAIN:				delete ((TagCurtain*)btag);				break;			case T_CURTAIN_E:				delete ((TagECurtain*)btag);				break;			case T_END:				delete ((TagEnd*)btag);				break;			case T_ENTER:				delete ((TagEnter*)btag);				break;			case T_EVENT:				delete ((TagEvent*)btag);				break;			case T_EVENT_E:				delete ((TagEEvent*)btag);				break;			case T_EXIT:				delete ((TagExit*)btag);				break;			case T_FONT:				delete ((TagFont*)btag);				break;			case T_FONT_E:				delete ((TagEFont*)btag);				break;			case T_FORM:				delete ((TagForm*)btag);				break;			case T_FORM_E:				delete ((TagEForm*)btag);				break;			case T_I:				delete ((TagI*)btag);				break;			case T_I_E:				delete ((TagEI*)btag);				break;			case T_ICON:				delete ((TagIcon*)btag);				break;			case T_ICON_E:				delete ((TagEIcon*)btag);				break;			case T_INDENT:				delete ((TagIndent*)btag);				break;			case T_INDENT_E:				delete ((TagEIndent*)btag);				break;			case T_INPUT:				delete ((TagInput*)btag);				break;			case T_KICK:				delete ((TagKick*)btag);				break;			case T_MEMO:				delete ((TagMemo*)btag);				break;			case T_NL:				delete ((TagNewline*)btag);				break;			case T_NP:				delete ((TagNewpage*)btag);				break;			case T_P:				delete ((TagP*)btag);				break;			case T_PLAY:				delete ((TagPlay*)btag);				break;			case T_PLAY_E:				delete ((TagEPlay*)btag);				break;			case T_PLUGIN:				delete ((TagPlugin*)btag);				break;			case T_POSITION:				delete ((TagPosition*)btag);				break;			case T_QUESTION:				delete ((TagQuestion*)btag);				break;			case T_RECORD:				delete ((TagRecord*)btag);				break;			case T_RECORD_E:				delete ((TagERecord*)btag);				break;			case T_S:				delete ((TagS*)btag);				break;			case T_S_E:				delete ((TagES*)btag);				break;			case T_SCREEN:				delete ((TagScreen*)btag);				break;			case T_SHADOW:				delete ((TagShadow*)btag);				break;			case T_SHADOW_E:				delete ((TagEShadow*)btag);				break;			case T_SNAP:				delete ((TagSnap*)btag);				break;			case T_SOUND:				delete ((TagSound*)btag);				break;			case T_SOUND_E:				delete ((TagESound*)btag);				break;			case T_SPACE:				delete ((TagSpace*)btag);				break;			case T_STAGE:				delete ((TagStage*)btag);				break;			case T_SUNGLASS:				delete ((TagSunglass*)btag);				break;			case T_SUNGLASS_E:				delete ((TagESunglass*)btag);				break;			case T_TIMER:				delete ((TagTimer*)btag);				break;			case T_TITLE:				delete ((TagTitle*)btag);				break;			case T_TRAP:				delete ((TagTrap*)btag);				break;			case T_U:				delete ((TagU*)btag);				break;			case T_U_E:				delete ((TagEU*)btag);				break;			case T_W:				delete ((TagW*)btag);				break;			case T_WAIT:				delete ((TagWait*)btag);				break;			case T_WAIT_E:				delete ((TagEWait*)btag);				break;			case T_WINDOW:				delete ((TagWindow*)btag);				break;			case T_WINDOW_E:				delete ((TagEWindow*)btag);				break;			case T_WRITE:				delete ((TagWrite*)btag);				break;			case TEXT:				delete ((StrText*)btag);				break;			case CARD:				delete ((StrCard*)btag);				break;			default:				break;		}	}	delete tagArray;}