ype)(yy_try_NUL_trans_(c)))#endif#ifndef YY_USE_CLASS#ifdef YY_DnmlLex_LEX_DEFINEDYY_DnmlLex_LEX_RETURN YY_DnmlLex_LEX ( YY_DnmlLex_LEX_PARAM )YY_DnmlLex_LEX_PARAM_DEF#elseYY_DECL#endif#elseYY_DnmlLex_LEX_RETURN YY_DnmlLex_CLASS::YY_DnmlLex_LEX ( YY_DnmlLex_LEX_PARAM)#endif    {    register yy_state_type yy_current_state;    register YY_DnmlLex_CHAR *yy_cp, *yy_bp;    register int yy_act;/* % user's declarations go here */ /* % end of prolog */     if ( yy_init )	{	 	 {	 YY_USER_INIT;	 }	if ( ! yy_start )	    yy_start = 1;       /* first start state */	if ( ! yy___in )	    yy___in = YY_DnmlLex_IFILE_DEFAULT;	if ( ! yy___out )	    yy___out = YY_DnmlLex_OFILE_DEFAULT;	if ( YY_DnmlLex_CURRENT_BUFFER )	    YY_DnmlLex_INIT_BUFFER( YY_DnmlLex_CURRENT_BUFFER, yy___in );	else	    YY_DnmlLex_CURRENT_BUFFER = YY_DnmlLex_CREATE_BUFFER( yy___in, YY_BUF_SIZE );	YY_DnmlLex_LOAD_BUFFER_STATE();	yy_init=0;	}    while ( 1 )         /* loops until end-of-file is reached */	{/* % yymore()-related code goes here */ 	yy_cp = yy_c_buf_p;	/* support of yy___text */	*yy_cp = yy_hold_char;	/* yy_bp points to the position in yy_ch_buf of the start of the	 * current run.	 */	yy_bp = yy_cp;/* % code to set up and find next match goes here */ 	yy_current_state = yy_start;	if ( yy_bp[-1] == '\n' )	    ++yy_current_state;yy_match:	do	    {	    register YY_CHAR yy_c = yy_ec[*yy_cp];	    if ( yy_accept[yy_current_state] )		{		yy_last_accepting_state = yy_current_state;		yy_last_accepting_cpos = yy_cp;		}	    while ( yy_chk[yy_base[yy_current_state] + yy_c] != yy_current_state )		{		yy_current_state = yy_def[yy_current_state];		if ( yy_current_state >= 482 )		    yy_c = yy_meta[yy_c];		}	    yy_current_state = yy_nxt[yy_base[yy_current_state] + yy_c];	    ++yy_cp;	    }	while ( yy_current_state != 481 );	yy_cp = yy_last_accepting_cpos;	yy_current_state = yy_last_accepting_state;yy_find_action:/* % code to find the action number goes here */ 	yy_act = yy_accept[yy_current_state];	YY_DO_BEFORE_ACTION;	YY_USER_ACTION;do_action:      /* this label is used only to access EOF actions */#if YY_DnmlLex_DEBUG != 0	if ( yy___flex_debug )		{		if ( yy_act == 0 )#ifndef YY_DnmlLex_IOSTREAM			fprintf( yy___stderr , "--scanner backtracking\n" );#else			yy___stderr <<"--scanner backtracking"<<endl;#endif		else if ( yy_act < YY_END_OF_BUFFER -1 )#ifndef YY_DnmlLex_IOSTREAM			fprintf( yy___stderr , 			 "--accepting rule at line %d (\"%s\")\n",			 yy_rule_linenum[yy_act], yy___text );#else			yy___stderr <<"--accepting rule at line "                          <<(int)yy_rule_linenum[yy_act]                          <<" (\""<<(char *)yy___text<<"\")"<<endl;#endif		else if ( yy_act == YY_END_OF_BUFFER -1 )#ifndef YY_DnmlLex_IOSTREAM			fprintf( yy___stderr , 			 "--accepting default rule (\"%s\")\n",			 yy___text );#else			yy___stderr <<"--accepting default rule"                          <<" (\""<<(char *)yy___text<<"\")"<<endl;#endif		else if ( yy_act == YY_END_OF_BUFFER )#ifndef YY_DnmlLex_IOSTREAM			fprintf( yy___stderr , "--(end of buffer or a NUL)\n" );#else			yy___stderr <<"--(end of buffer or a NUL)"<<endl;#endif		else#ifndef YY_DnmlLex_IOSTREAM			fprintf( yy___stderr , "--EOF\n" );#else			yy___stderr <<"--EOF"<<endl;#endif		}#endif	switch ( yy_act )	    {/* % actions go here */ 	    case 0: /* must backtrack */	    /* undo the effects of YY_DO_BEFORE_ACTION */	    *yy_cp = yy_hold_char;	    yy_cp = yy_last_accepting_cpos;	    yy_current_state = yy_last_accepting_state;	    goto yy_find_action;case 1:{/*			printf("\nTAG_START:"); */			BEGIN(TAG);			return DnmlParse::LP;		}	YY_BREAKcase 2:{			int a,b;					a = input();			while (a != EOF) {				b = yyinput();				if (a == '#' && b == '>') {					if ((a = yyinput()) != '\n') {						unput(a);					}					break;				} else {					a = b;				}			}			if (a == EOF) {				return DnmlParse::CMT_ERROR;			}		}	YY_BREAKcase 3:{/*			int a;					while ((a = yyinput()) != EOF) {				if (a == '\n') {					if ((a = yyinput()) != 0x0a) {						unput(a);					}					break;				} else				if (a & 0x80) {					a = yyinput();				}			}*/		}	YY_BREAKcase 4:	YY_BREAKcase 5:	YY_BREAKcase 6:{/*			printf("\n"); *//*			fflush(stdout); *//*			strcpy(YY_DnmlParse_LVAL->name, "\n"); *//*			return DnmlParse::TEXT; */		}	YY_BREAKcase 7:{//			if ( !include_flag ) {/*				printf("\nTAG_END:\n"); *//*				fflush(stdout); *//*			} else {				char	fName[256];		        include_stack[++include_count] = YY_CURRENT_BUFFER;				inFile[++infile_count] = new ifstream();				if (include_flag == 0x0f) {					sprintf(fName, "%s%s", includeFolder, include_file);				} else {					if (include_file[0] == '/' ||						include_file[0] == '\\') {						strcpy(fName, include_file);					} else {						sprintf(fName, "%s%s", currentFolder, include_file);					}				}				convertNative(fName);				inFile[infile_count]->open(fName, ios::in);				if (inFile[infile_count]->is_open()) {					yyin = inFile[infile_count];					yy_switch_to_buffer(yy_create_buffer(yyin, YY_BUF_SIZE));				} else {					delete inFile[infile_count--];				} 				include_flag = 0;				strcpy(include_file, "");			}*/			BEGIN(INITIAL);			return DnmlParse::RP;		}	YY_BREAKcase YY_STATE_EOF(TAG):{			BEGIN(INITIAL);			return DnmlParse::RP;		}	YY_BREAKcase YY_STATE_EOF(INITIAL):case YY_STATE_EOF(B_COVER):case YY_STATE_EOF(S_CURTAIN):case YY_STATE_EOF(INCLUDE):{//			if ( include_count >= 0 ){//				inFile[infile_count]->close();//				delete inFile[infile_count--];//				yy_delete_buffer(YY_CURRENT_BUFFER);//				yy_switch_to_buffer(include_stack[include_count--]);//			} else {				yyterminate();//			}		}	YY_BREAKcase 10:	YY_BREAKcase 11:{			if ( !include_flag ) {/*				printf(" =:"); */			}			return yytext[0];		}	YY_BREAKcase 12:{			char	*p, c;			strcpy((char *)yytext, "");			for (p = (char *)yytext; ; p++) {				c = yyinput();				if ((c)>=0x81 && (c)<=0x9F || (c)>=0xE0 && (c)<=0xFC) {					*p++ = c;					*p = yyinput();				} else {					if (c == '>') {						if ((c = yyinput()) == '>') {							break;						}						unput(c);						c = '>';					} else					if (c == EOF) {						*p = '\0';						return DnmlParse::STR_ERROR;					}					*p = c;				}			}			*p = '\0';/*			printf(" CRD:[%s]", yytext); *//*			fflush(stdout); */			strcpy(YY_DnmlParse_LVAL->name, (char *)yytext);			BEGIN(INITIAL);			return DnmlParse::CARD;		}	YY_BREAKcase 13:{			char	*p, c;			strcpy((char *)yytext, "");			for (p = (char *)yytext; ; p++) {				c = yyinput();				if ((c)>=0x81 && (c)<=0x9F || (c)>=0xE0 && (c)<=0xFC) {					*p++ = c;					*p = yyinput();				} else {					if (c == '"') {						break;					} else					if (c == '\n') {						break;					} else					if (c == EOF) {						*p = '\0';						return DnmlParse::STR_ERROR;					}					*p = c;				}			}			*p = '\0';/*			if ( include_flag == 0x0003 ) {				strcpy(include_file, (char *)yytext);				include_flag |= 0x0004;			} else			if ( include_flag == 0x000f ) {				if (!strcmp((char *)yytext, "PLAYER") ||					!strcmp((char *)yytext, "player") ) {					strcpy(includeFolder, playerFolder);					strcpy(YY_DnmlParse_LVAL->name, playerFolder);				} else				if (!strcmp((char *)yytext, "CURRENT") ||					!strcmp((char *)yytext, "current") ) {					strcpy(includeFolder, currentFolder);					strcpy(YY_DnmlParse_LVAL->name, currentFolder);				} else {					if (yytext[0] == '/') {						strcpy(includeFolder, (char *)yytext);					} else {						sprintf(includeFolder, "%s%s", currentFolder, (char *)yytext);					}					if (includeFolder[strlen(includeFolder)-1] != '/') {						includeFolder[strlen(includeFolder)]   = '/';						includeFolder[strlen(includeFolder)+1] = '\0';					}					strcpy(YY_DnmlParse_LVAL->name, currentFolder);				}			} else {*//*				printf(" STR: