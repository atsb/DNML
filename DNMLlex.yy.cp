Y:[%s]", yytext); */			return DnmlParse::K_GENRE;		}	YY_BREAKcase 136:{/*			printf("\nTAG_END:\n"); *//*			fflush(stdout); */			BEGIN(INITIAL);			return DnmlParse::RP;		}	YY_BREAKcase 137:{			char	*p, cbuff[1024], c;						memset(cbuff, '\0', sizeof(cbuff));			if ((c = yytext[0]) != 0x0a) {				for (p = cbuff; ; ) {					if (c == EOF) {						break;					} else					if ((c)>=0x81 && (c)<=0x9F || (c)>=0xE0 && (c)<=0xFC) {						*p++ = c;						if ((c = yyinput()) == EOF) {							p--;							break;						}					} else {						if (c == ' ') {							if (p == cbuff) {								c = yyinput();								continue;							}						} else						if (c == '\t') {							c = yyinput();							continue;						} else						if (c == 0x0a) {							c = yyinput();							for ( ; c == ' ' || c == '\t'; c = yyinput())								;							continue;						} else						if (c == 0x0d) {							c = yyinput();							for ( ; c == ' ' || c == '\t'; c = yyinput())								;							continue;						} else						if (c == '<') {							unput(c);							break;						} else						if (c == EOF) {							break;						}					}					*p++ = c;					c = yyinput();				}				*p = '\0';/*				printf("\nTEXT:[\n%s]\n", cbuff); *//*				fflush(stdout); */				if (cbuff[strlen(cbuff)-1] == '\n') {					cbuff[strlen(cbuff)-1] = '\0';				}				strcpy(YY_DnmlParse_LVAL->name, cbuff);				return DnmlParse::TEXT;			}		}	YY_BREAKcase 138:ECHO;	YY_BREAK	    case YY_END_OF_BUFFER:		{		/* amount of text matched not including the EOB char */		int yy_amount_of_matched_text = yy_cp - yy___text - 1;		/* undo the effects of YY_DO_BEFORE_ACTION */		*yy_cp = yy_hold_char;		/* note that here we test for yy_c_buf_p "<=" to the position		 * of the first EOB in the buffer, since yy_c_buf_p will		 * already have been incremented past the NUL character		 * (since all states make transitions on EOB to the end-		 * of-buffer state).  Contrast this with the test in yyinput().		 */		if ( yy_c_buf_p <= &YY_DnmlLex_CURRENT_BUFFER->yy_ch_buf[yy_n_chars] )		    /* this was really a NUL */		    {		    yy_state_type yy_next_state;		    yy_c_buf_p = yy___text + yy_amount_of_matched_text;		    yy_current_state = yy_get_previous_state();		    /* okay, we're now positioned to make the		     * NUL transition.  We couldn't have		     * yy_get_previous_state() go ahead and do it		     * for us because it doesn't know how to deal		     * with the possibility of jamming (and we		     * don't want to build jamming into it because		     * then it will run more slowly)		     */#ifndef YY_USE_CLASS		    yy_next_state = yy_try_NUL_trans( yy_current_state );#else		    yy_next_state = yy_try_NUL_trans( (long)yy_current_state );#endif		    yy_bp = yy___text + YY_MORE_ADJ;		    if ( yy_next_state )			{			/* consume the NUL */			yy_cp = ++yy_c_buf_p;			yy_current_state = yy_next_state;			goto yy_match;			}		    else			{/* % code to do backtracking for compressed tables and set up yy_cp goes here */ 			    yy_cp = yy_last_accepting_cpos;			    yy_current_state = yy_last_accepting_state;			goto yy_find_action;			}		    }		else switch ( yy_get_next_buffer() )		    {		    case EOB_ACT_END_OF_FILE:			{			yy_did_buffer_switch_on_eof = 0;			if ( yywrap() )			    {			    /* note: because we've taken care in			     * yy_get_next_buffer() to have set up yy___text,			     * we can now set up yy_c_buf_p so that if some			     * total hoser (like flex itself) wants			     * to call the scanner after we return the			     * YY_NULL, it'll still work - another YY_NULL			     * will get returned.			     */			    yy_c_buf_p = yy___text + YY_MORE_ADJ;			    yy_act = YY_STATE_EOF((yy_start - 1) / 2);			    goto do_action;			    }			else			    {			    if ( ! yy_did_buffer_switch_on_eof )				YY_NEW_FILE;			    }			}			break;		    case EOB_ACT_CONTINUE_SCAN:			yy_c_buf_p = yy___text + yy_amount_of_matched_text;			yy_current_state = yy_get_previous_state();			yy_cp = yy_c_buf_p;			yy_bp = yy___text + YY_MORE_ADJ;			goto yy_match;		    case EOB_ACT_LAST_MATCH:			yy_c_buf_p =			    &YY_DnmlLex_CURRENT_BUFFER->yy_ch_buf[yy_n_chars];			yy_current_state = yy_get_previous_state();			yy_cp = yy_c_buf_p;			yy_bp = yy___text + YY_MORE_ADJ;			goto yy_find_action;		    }		break;		}	    default:#if YY_DnmlLex_DEBUG != 0#ifndef YY_DnmlLex_IOSTREAM		fprintf(yy___stderr , "action # %d\n", yy_act );#else		yy___stderr <<"action # "<<(int)yy_act<<endl;#endif#endif		YY_FATAL_ERROR(			"fatal flex scanner internal error--no action found" );	    }	}	yyterminate();/* avoid the no return value error message on MS-C7/dos */    }/* yy_get_next_buffer - try to read in a new buffer * * synopsis *     int yy_get_next_buffer(); *      * returns a code representing an action *     EOB_ACT_LAST_MATCH -  *     EOB_ACT_CONTINUE_SCAN - continue scanning from current position *     EOB_ACT_END_OF_FILE - end of file */#ifndef YY_USE_CLASSstatic int yy_get_next_buffer()#elseint YY_DnmlLex_CLASS::yy_get_next_buffer()#endif    {    register YY_DnmlLex_CHAR *dest = YY_DnmlLex_CURRENT_BUFFER->yy_ch_buf;    register YY_DnmlLex_CHAR *source = yy___text - 1; /* copy prev. char, too */    register int number_to_move, i;    int ret_val;    if ( yy_c_buf_p > &YY_DnmlLex_CURRENT_BUFFER->yy_ch_buf[yy_n_chars + 1] )	YY_FATAL_ERROR(		"fatal flex scanner internal error--end of buffer missed" );    /* try to read more data */    /* first move last chars to start of buffer */    number_to_move = yy_c_buf_p - yy___text;    for ( i = 0; i < number_to_move; ++i )	*(dest++) = *(source++);    if ( YY_DnmlLex_CURRENT_BUFFER->yy_eof_status != EOF_NOT_SEEN )	/* don't do the read, it's not guaranteed to return an EOF,	 * just force an EOF	 */	yy_n_chars = 0;    else	{	int num_to_read = YY_DnmlLex_CURRENT_BUFFER->yy_buf_size - number_to_move - 1;	if ( num_to_read > YY_READ_BUF_SIZE )	    num_to_read = YY_READ_BUF_SIZE;	else if ( num_to_read <= 0 )	    YY_FATAL_ERROR( "fatal error - scanner input buffer overflow" );	/* read in more data */	YY_INPUT( (&YY_DnmlLex_CURRENT_BUFFER->yy_ch_buf[number_to_move]),		  yy_n_chars, num_to_read );	}    if ( yy_n_chars == 0 )	{	if ( number_to_move - YY_MORE_ADJ == 1 )	    {	    ret_val = EOB_ACT_END_OF_FILE;	    YY_DnmlLex_CURRENT_BUFFER->yy_eof_status = EOF_DONE;	    }	else	    {	    ret_val = EOB_ACT_LAST_MATCH;	    YY_DnmlLex_CURRENT_BUFFER->yy_eof_status = EOF_PENDING;	    }	}    else	ret_val = EOB_ACT_CONTINUE_SCAN;    yy_n_chars += number_to_move;    YY_DnmlLex_CURRENT_BUFFER->yy_ch_buf[yy_n_chars] = YY_END_OF_BUFFER_CHAR;    YY_DnmlLex_CURRENT_BUFFER->yy_ch_buf[yy_n_chars + 1] = YY_END_OF_BUFFER_CHAR;    /* yy___text begins at the second character in yy_ch_buf; the first     * character is the one which preceded it before reading in the latest     * buffer; it needs to be kept around in case it's a newline, so     * yy_get_previous_state() will have with '^' rules active     */    yy___text = &YY_DnmlLex_CURRENT_BUFFER->yy_ch_buf[1];    return ( ret_val );    }/* yy_get_previous_state - get the state just before the EOB char was reached * * synopsis *     yy_state_type yy_get_previous_state(); */#ifndef YY_USE_CLASSstatic yy_state_type yy_get_previous_state()#elselong YY_DnmlLex_CLASS::yy_get_previous_state_()#endif    {    register yy_state_type yy_current_state;    register YY_DnmlLex_CHAR *yy_cp;/* % code to get the start state into yy_current_state goes here */     register YY_CHAR *yy_bp = yy___text;    yy_current_state = yy_start;    if ( yy_bp[-1] == '\n' )	++yy_current_state;    for ( yy_cp = yy___text + YY_MORE_ADJ; yy_cp < yy_c_buf_p; ++yy_cp )	{/* % code to find the next state goes here */ 	register YY_CHAR yy_c = (*yy_cp ? yy_ec[*yy_cp] : 1);	if ( yy_accept[yy_current_state] )	    {	    yy_last_accepting_state = yy_current_state;	    yy_last_accepting_cpos = yy_cp;	    }	while ( yy_chk[yy_base[yy_current_state] + yy_c] != yy_current_state )	    {	    yy_current_state = yy_def[yy_current_state];	    if ( yy_current_state >= 482 )		yy_c = yy_meta[yy_c];	    }	yy_current_state = yy_nxt[yy_base[yy_current_state] + yy_c];	}#ifndef YY_USE_CLASS    return ( yy_current_state );#else    return (long)( yy_current_state );#endif    }/* yy_try_NUL_trans - try to make a transition on the NUL character * * synopsis *     next_state = yy_try_NUL_trans( current_state ); */#ifndef YY_USE_CLASS#ifdef YY_USE_PROTOSstatic yy_state_type yy_try_NUL_trans( register yy_state_type yy_current_state )#elsestatic yy_state_type yy_try_NUL_trans( yy_current_state )register yy_state_type yy_current_state;#endif#elselong YY_DnmlLex_CLASS::yy_try_NUL_trans_(long yy_current_state_)#endif    {#ifndef YY_USE_CLASS#else    yy_state_type yy_current_state=(yy_state_type)yy_current_state_;#endif    register int yy_is_jam;/* % code to find the next state, and perhaps do backtracking, goes here */     register YY_CHAR *yy_cp = yy_c_buf_p;    register YY_CHAR yy_c = 1;    if ( yy_accept[yy_current_state] )	{	yy_last_accepting_state = yy_current_state;	yy_last_accepting_cpos = yy_cp;	}    while ( yy_chk[yy_base[yy_current_state] + yy_c] != yy_current_state )	{	yy_current_state = yy_def[yy_current_state];	if ( yy_current_state >= 482 )	    yy_c = yy_meta[yy_c];	}    yy_current_state = yy_nxt[yy_base[yy_current_state] + yy_c];    yy_is_jam = (yy_current_state == 481);#ifndef YY_USE_CLASS    return ( yy_is_jam ? 0 : yy_current_state );#else    return (long)( yy_is_jam ? 0 : yy_current_state );#endif    }#ifndef YY_USE_CLASS#ifdef YY_USE_PROTOSstatic void yyunput( YY_DnmlLex_CHAR c, register YY_DnmlLex_CHAR *yy_bp )#elsestatic void yyunput( c, yy_bp )YY_DnmlLex_CHAR c;register YY_DnmlLex_CHAR *yy_bp;#endif#elsevoid YY_DnmlLex_CLASS::yyunput( YY_DnmlLex_CHAR c, YY_DnmlLex_CHAR *yy_bp )#endif    {    register YY_DnmlLex_CHAR *yy_cp = yy_c_buf_p;    /* undo effects of setting up yy___text */    *yy_cp = yy_hold_char;    if ( yy_cp < YY_DnmlLex_CURRENT_BUFFER->yy_ch_buf + 2 )	{ /* need to shift things up to make room */	register int number_to_move = yy_n_chars + 2; /* +2 for EOB chars */	register YY_DnmlLex_CHAR *dest =	    &YY_DnmlLex_CURRENT_BUFFER->yy_ch_buf[YY_DnmlLex_CURRENT_BUFFER->yy_buf_size + 2];	register YY_DnmlLex_CHAR *source =	    &YY_DnmlLex_CURRENT_BUFFER->yy_ch_buf[number_to_move];	while ( source > YY_DnmlLex_CURRENT_BUFFER->yy_ch_buf )	    *--dest = *--source;	yy_cp += dest - source;	yy_bp += dest - source;	yy_n_chars = YY_DnmlLex_CURRENT_BUFFER->yy_buf_size;	if ( yy_cp < YY_DnmlLex_CURRENT_BUFFER->yy_ch_buf + 2 )	    YY_FATAL_ERROR( "flex scanner push-back overflow" );	}    if ( yy_cp > yy_bp && yy_cp[-1] == '\n' )	yy_cp[-2] = '\n';    *--yy_cp = c;    /* note: the formal parameter *must* be called "yy_bp" for this     *       macro to now work correctly     */    YY_LINECOUNT_DOWN;   /* restore old yy___lineno before last token read */    YY_DO_BEFORE_ACTION; /* set up yy___text and yy___lineno again */    }#ifndef YY_USE_CLASS#ifdef __cplusplusstatic int yyinput()#elsestatic int input()#endif#elseint YY_DnmlLex_CLASS::input()#endif    {    int c;    YY_DnmlLex_CHAR *yy_cp = yy_c_buf_p;    *yy_cp = yy_hold_char;    if ( *yy_c_buf_p == YY_END_OF_BUFFER_CHAR )	{	/* yy_c_buf_p now points to the character we want to return.	 * If this occurs *before* the EOB characters, then it's a	 * valid NUL; if not, then we've hit the end of the buffer.	 */	if ( yy_c_buf_p < &YY_DnmlLex_CURRENT_BUFFER->yy_ch_buf[yy_n_chars] )	    /* this was really a NUL */	    *yy_c_buf_p = '\0';	else	    { /* need more input */	    yy___text = yy_c_buf_p;	    ++yy_c_buf_p;	    switch ( yy_get_next_buffer() )		{		case EOB_ACT_END_OF_FILE:		    {		    if ( yywrap() )			{			yy_c_buf_p = yy___text + YY_MORE_ADJ;			return ( EOF );			}		    YY_NEW_FILE;#ifndef YY_USE_CLASS#ifdef __cplusplus		    return ( yyinput() );#else		    return ( input() );#endif#else		    return ( input() );#endif		    }		    break;		case EOB_ACT_CONTINUE_SCAN:		    yy_c_buf_p = yy___text + YY_MORE_ADJ;		    break;		case EOB_ACT_LAST_MATCH:#ifndef YY_USE_CLASS#ifdef __cplusplus		    YY_FATAL_ERROR( "unexpected last match in yyinput()" );#else		    YY_FATAL_ERROR( "unexpected last match in input()" );#endif#else		    YY_FATAL_ERROR( "unexpected last match in YY_DnmlLex_CLASS::input()" );#endif		}	    }	}    c = *yy_c_buf_p;    yy_hold_char = *++yy_c_buf_p;    return ( c );    }#ifndef YY_USE_CLASS#ifdef YY_USE_PROTOSvoid YY_DnmlLex_RESTART( YY_DnmlLex_IFILE  *input_file )#elsevoid YY_DnmlLex_RESTART( input_file )YY_DnmlLex_IFILE  *input_file;#endif#elsevoid YY_DnmlLex_CLASS::YY_DnmlLex_RESTART ( YY_DnmlLex_IFILE  *input_file )#endif    {    YY_DnmlLex_INIT_BUFFER( YY_DnmlLex_CURRENT_BUFFER, input_file );    YY_DnmlLex_LOAD_BUFFER_STATE();    }#ifndef YY_USE_CLASS#ifdef YY_USE_PROTOSvoid YY_DnmlLex_SWITCH_TO_BUFFER( YY_BUFFER_STATE new_buffer )#elsevoid YY_DnmlLex_SWITCH_TO_BUFFER( new_buffer )YY_BUFFER_STATE new_buffer;#endif#elsevoid YY_DnmlLex_CLASS::YY_DnmlLex_SWITCH_TO_BUFFER( YY_BUFFER_STATE new_buffer )#endif    {    if ( YY_DnmlLex_CURRENT_BUFFER == new_buffer )	return;    if ( YY_DnmlLex_CURRENT_BUFFER )	{	/* flush out information for old buffer */	*yy_c_buf_p = yy_hold_char;	YY_DnmlLex_CURRENT_BUFFER->yy_buf_pos = yy_c_buf_p;	YY_DnmlLex_CURRENT_BUFFER->yy_n_chars = yy_n_chars;	}    YY_DnmlLex_CURRENT_BUFFER = new_buffer;    YY_DnmlLex_LOAD_BUFFER_STATE();    /* we don't actually know whether we did this switch during     * EOF (yywrap()) processing, but the only time this flag     * is looked at is after yywrap() is called, so it's safe     * to go ahead and always set it.     */    yy_did_buffer_switch_on_eof = 1;    }#ifndef YY_USE_CLASS#ifdef YY_USE_PROTOSvoid YY_DnmlLex_LOAD_BUFFER_STATE( void )#elsevoid YY_DnmlLex_LOAD_BUFFER_STATE()#endif#elsevoid YY_DnmlLex_CLASS::YY_DnmlLex_LOAD_BUFFER_STATE(  )#endif    {    yy_n_chars = YY_DnmlLex_CURRENT_BUFFER->yy_n_chars;    yy___text = yy_c_buf_p = YY_DnmlLex_CURRENT_BUFFER->yy_buf_pos;    yy___in = YY_DnmlLex_CURRENT_BUFFER->yy_input_file;    yy_hold_char = *yy_c_buf_p;    }#ifndef YY_USE_CLASS#ifdef YY_USE_PROTOSYY_BUFFER_STATE YY_DnmlLex_CREATE_BUFFER( YY_DnmlLex_IFILE  *file, int size )#elseYY_BUFFER_STATE YY_DnmlLex_CREATE_BUFFER( file, size )YY_DnmlLex_IFILE  *file;int size;#endif#elseYY_BUFFER_STATE YY_DnmlLex_CLASS::YY_DnmlLex_CREATE_BUFFER( YY_DnmlLex_IFILE  *file, int size )#endif    {    YY_BUFFER_STATE b;    b = (YY_BUFFER_STATE) malloc( sizeof( struct yy_buffer_state ) );    if ( ! b )	YY_FATAL_ERROR( "out of dynamic memory in YY_DnmlLex_CREATE_BUFFER()" );    b->yy_buf_size = size;    /* yy_ch_buf has to be 2 characters longer than the size given because     * we need to put in 2 end-of-buffer characters.     */    b->yy_ch_buf = (YY_DnmlLex_CHAR *) malloc( (unsigned) (b->yy_buf_size + 2) );    if ( ! b->yy_ch_buf )	YY_FATAL_ERROR( "out of dynamic memory in YY_DnmlLex_CREATE_BUFFER()" );    YY_DnmlLex_INIT_BUFFER( b, file );    return ( b );    }#ifndef YY_USE_CLASS#ifdef YY_USE_PROTOSvoid YY_DnmlLex_DELETE_BUFFER( YY_BUFFER_STATE b )#elsevoid YY_DnmlLex_DELETE_BUFFER( b )YY_BUFFER_STATE b;#endif#elsevoid YY_DnmlLex_CLASS::YY_DnmlLex_DELETE_BUFFER( YY_BUFFER_STATE b )#endif    {    if ( b == YY_DnmlLex_CURRENT_BUFFER )	YY_DnmlLex_CURRENT_BUFFER = (YY_BUFFER_STATE) 0;    free( (char *) b->yy_ch_buf );    free( (char *) b );    }#ifndef YY_USE_CLASS#ifdef YY_USE_PROTOSvoid YY_DnmlLex_INIT_BUFFER( YY_BUFFER_STATE b, YY_DnmlLex_IFILE  *file )#elsevoid YY_DnmlLex_INIT_BUFFER( b, file )YY_BUFFER_STATE b;YY_DnmlLex_IFILE  *file;#endif#elsevoid YY_DnmlLex_CLASS::YY_DnmlLex_INIT_BUFFER( YY_BUFFER_STATE b, YY_DnmlLex_IFILE  *file)#endif    {    b->yy_input_file = file;    /* we put in the '\n' and start reading from [1] so that an     * initial match-at-newline will be true.     */    b->yy_ch_buf[0] = '\n';    b->yy_n_chars = 1;    /* we always need two end-of-buffer characters.  The first causes     * a transition to the end-of-buffer state.  The second causes     * a jam in that state.     */    b->yy_ch_buf[1] = YY_END_OF_BUFFER_CHAR;    b->yy_ch_buf[2] = YY_END_OF_BUFFER_CHAR;    b->yy_buf_pos = &b->yy_ch_buf[1];    b->yy_eof_status = EOF_NOT_SEEN;    }void#ifdef YY_USE_CLASSYY_DnmlLex_CLASS::#endifconvertNative(char *str)	{	Boolean	absFlag = (*str == '/' || *str == '\\') ? true : false;	char	*sp, *dp, tmp[256];	for (sp = str, dp = tmp; *sp != '\0'; sp++) {		if (*sp & 0x80) {			*dp++ = *sp++;		} else		if (*sp == '.') {			if (*(sp+1) == '.' && (*(sp+2) == '/' || *(sp+2) == '\\')) {				*dp++ = ':';				sp += 2;				continue;			} else			if (*(sp+1) == '/' || *(sp+1) == '\\') {				sp++;				continue;			}		} else		if (*sp == '/' || *sp == '\\') {			if (sp != (str)) *dp++ = ':';			continue;		}		*dp++ = *sp;	}	*dp = '\0';	if (absFlag) {		strcpy(str, tmp);	} else {		sprintf(str, ":%s", tmp);	}}		