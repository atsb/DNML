tType = 0;					resultVal  = yyval.lval;				;    break;}case 13:{					yyval.lval =  yyvsp[-2].lval * yyvsp[0].lval;					resultType = 0;					resultVal  = yyval.lval;				;    break;}case 14:{					yyval.lval =  yyvsp[-2].lval / yyvsp[0].lval;					resultType = 0;					resultVal  = yyval.lval;				;    break;}case 15:{					yyval.lval =  yyvsp[-2].lval % yyvsp[0].lval;					resultType = 0;					resultVal  = yyval.lval;				;    break;}case 16:{					if (resultType == 1) {						if (!cardList->existCard(curCardName)) {							yyval.lval = 0;						} else {							yyval.lval = cardList->cmpCardStr(curCardName, resultStr);						}					} else {						yyval.lval =  (yyvsp[-2].lval == yyvsp[0].lval);					}					resultVal  = yyval.lval;					resultType = 0;				;    break;}case 17:{					yyval.lval = yyvsp[-2].lval;					resultType = 2;					resultStr  = yyvsp[0].name;					resultVal  = yyval.lval;				;    break;}case 18:{					yyval.lval = !yyvsp[0].lval;					resultType = 0;					resultVal  = yyval.lval;				;    break;}case 19:{					yyval.lval =  yyvsp[-1].lval;					resultType = 0;					resultVal  = yyval.lval;				;    break;}case 20:{					yyval.lval =  yyvsp[0].lval;					resultType = 0;					resultVal  = yyval.lval;				;    break;}case 21:{					yyval.lval =  -yyvsp[0].lval;					resultType = 0;					resultVal  = yyval.lval;				;    break;}case 22:{					resultType = 1;					resultStr  = yyvsp[-1].name;					yyval.lval = 1;				;    break;}case 23:{					resultType = 1;					if (!cardList->existCard(yyvsp[-1].name)) {						yyval.lval = 0;						resultStr = "";					} else {						yyval.lval        = cardList->getCardVal(yyvsp[-1].name);						resultStr = cardList->getCardStr(yyvsp[-1].name);					}				;    break;}case 24:{					strcpy(curCardName, yyvsp[0].name);					if (!cardList->existCard(yyvsp[0].name)) {						yyval.lval = 0;					} else {						yyval.lval = cardList->getCardVal(yyvsp[0].name);					}				;    break;}case 25:{					if (resultType == 0) {						if (!cardList->existCard(yyvsp[-2].name)) {							cardList->addCard(yyvsp[-2].name);						}						char	tmp[32];						sprintf(tmp, "%d", yyvsp[0].lval);						cardList->setCardStr(yyvsp[-2].name, tmp);						cardList->setCardVal(yyvsp[-2].name, yyvsp[0].lval);						yyval.lval = yyvsp[0].lval;					} else {						if (!cardList->existCard(yyvsp[-2].name)) {							cardList->addCard(yyvsp[-2].name);							cardList->setCardVal(yyvsp[-2].name, 1);						}						if (!atoi(cardList->getCardStr(yyvsp[-2].name))) {							char	tmp[32];							sprintf(tmp, "%d", yyvsp[0].lval);							cardList->setCardStr(yyvsp[-2].name, tmp);						} else {							cardList->setCardStr(yyvsp[-2].name, resultStr);						}						yyval.lval = cardList->getCardVal(yyvsp[-2].name);					}				;    break;}}   /* the action file gets copied in in place of this dollarsign  */  yyvsp -= yylen;  yyssp -= yylen;#ifdef YY_CardParse_LSP_NEEDED  yylsp -= yylen;#endif#if YY_CardParse_DEBUG != 0  if (YY_CardParse_DEBUG_FLAG)    {      short *ssp1 = yyss - 1;      fprintf (stderr, "state stack now");      while (ssp1 != yyssp)	fprintf (stderr, " %d", *++ssp1);      fprintf (stderr, "\n");    }#endif  *++yyvsp = yyval;#ifdef YY_CardParse_LSP_NEEDED  yylsp++;  if (yylen == 0)    {      yylsp->first_line = YY_CardParse_LLOC.first_line;      yylsp->first_column = YY_CardParse_LLOC.first_column;      yylsp->last_line = (yylsp-1)->last_line;      yylsp->last_column = (yylsp-1)->last_column;      yylsp->text = 0;    }  else    {      yylsp->last_line = (yylsp+yylen-1)->last_line;      yylsp->last_column = (yylsp+yylen-1)->last_column;    }#endif  /* Now "shift" the result of the reduction.     Determine what state that goes to,     based on the state we popped back to     and the rule number reduced by.  */  yyn = yyr1[yyn];  yystate = yypgoto[yyn - YYNTBASE] + *yyssp;  if (yystate >= 0 && yystate <= YYLAST && yycheck[yystate] == *yyssp)    yystate = yytable[yystate];  else    yystate = yydefgoto[yyn - YYNTBASE];  YYGOTO(yynewstate);YYLABEL(yyerrlab)   /* here on detecting error */  if (! yyerrstatus)    /* If not already recovering from an error, report this error.  */    {      ++YY_CardParse_NERRS;#ifdef YY_CardParse_ERROR_VERBOSE      yyn = yypact[yystate];      if (yyn > YYFLAG && yyn < YYLAST)	{	  int size = 0;	  char *msg;	  int x, count;	  count = 0;	  /* Start X at -yyn if nec to avoid negative indexes in yycheck.  */	  for (x = (yyn < 0 ? -yyn : 0);	       x < (sizeof(yytname) / sizeof(char *)); x++)	    if (yycheck[x + yyn] == x)	      size += strlen(yytname[x]) + 15, count++;	  msg = (char *) malloc(size + 15);	  if (msg != 0)	    {	      strcpy(msg, "parse error");	      if (count < 5)		{		  count = 0;		  for (x = (yyn < 0 ? -yyn : 0);		       x < (sizeof(yytname) / sizeof(char *)); x++)		    if (yycheck[x + yyn] == x)		      {			strcat(msg, count == 0 ? ", expecting `" : " or `");			strcat(msg, yytname[x]);			strcat(msg, "'");			count++;		      }		}	      YY_CardParse_ERROR(msg);	      free(msg);	    }	  else	    YY_CardParse_ERROR ("parse error; also virtual memory exceeded");	}      else#endif /* YY_CardParse_ERROR_VERBOSE */	YY_CardParse_ERROR("parse error");    }  YYGOTO(yyerrlab1);YYLABEL(yyerrlab1)   /* here on error raised explicitly by an action */  if (yyerrstatus == 3)    {      /* if just tried and failed to reuse lookahead token after an error, discard it.  */      /* return failure if at end of input */      if (YY_CardParse_CHAR == YYEOF)	YYABORT;#if YY_CardParse_DEBUG != 0      if (YY_CardParse_DEBUG_FLAG)	fprintf(stderr, "Discarding token %d (%s).\n", YY_CardParse_CHAR, yytname[yychar1]);#endif      YY_CardParse_CHAR = YYEMPTY;    }  /* Else will try to reuse lookahead token     after shifting the error token.  */  yyerrstatus = 3;              /* Each real token shifted decrements this */  YYGOTO(yyerrhandle);YYLABEL(yyerrdefault)  /* current state does not do anything special for the error token. */#if 0  /* This is wrong; only states that explicitly want error tokens     should shift them.  */  yyn = yydefact[yystate];  /* If its default is to accept any token, ok.  Otherwise pop it.*/  if (yyn) YYGOTO(yydefault);#endifYYLABEL(yyerrpop)   /* pop the current state because it cannot handle the error token */  if (yyssp == yyss) YYABORT;  yyvsp--;  yystate = *--yyssp;#ifdef YY_CardParse_LSP_NEEDED  yylsp--;#endif#if YY_CardParse_DEBUG != 0  if (YY_CardParse_DEBUG_FLAG)    {      short *ssp1 = yyss - 1;      fprintf (stderr, "Error: state stack now");      while (ssp1 != yyssp)	fprintf (stderr, " %d", *++ssp1);      fprintf (stderr, "\n");    }#endifYYLABEL(yyerrhandle)  yyn = yypact[yystate];  if (yyn == YYFLAG)    YYGOTO(yyerrdefault);  yyn += YYTERROR;  if (yyn < 0 || yyn > YYLAST || yycheck[yyn] != YYTERROR)    YYGOTO(yyerrdefault);  yyn = yytable[yyn];  if (yyn < 0)    {      if (yyn == YYFLAG)	YYGOTO(yyerrpop);      yyn = -yyn;      YYGOTO(yyreduce);    }  else if (yyn == 0)    YYGOTO(yyerrpop);  if (yyn == YYFINAL)    YYACCEPT;#if YY_CardParse_DEBUG != 0  if (YY_CardParse_DEBUG_FLAG)    fprintf(stderr, "Shifting error token, ");#endif  *++yyvsp = YY_CardParse_LVAL;#ifdef YY_CardParse_LSP_NEEDED  *++yylsp = YY_CardParse_LLOC;#endif  yystate = yyn;  YYGOTO(yynewstate);/* end loop, in which YYGOTO may be used. */  YYENDGOTO}/* END */#ifdef YY_USE_CLASSYY_CardParse_CLASS::#endif~YY_CardParse_CLASS(){	delete cardList;}