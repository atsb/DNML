%name CardLex%define IOSTREAM 1%{#include <Timer.h>#include <stdio.h>#include <stdlib.h>#include <string.h>#include "CardParse.tab.h"#undef	YY_INPUT#define	YY_INPUT(buf,result,max_size)								\	if (input_done != -1) {											\		if (strlen(input_buff+input_done) > max_size-1) {			\			memcpy((buf), input_buff+input_done, max_size-1);		\			(buf)[max_size-1] = '\0';								\			input_done += max_size - 1;								\			(result) = max_size - 1;								\		} else {													\			strcpy((char*)(buf), input_buff+input_done);			\			(result) = strlen(input_buff+input_done);				\			input_done = -1;										\		}															\	} else {														\		(result) = 0;												\	}#undef	ECHO#define	ECHO				{}%}%define	LEX_PARAM	YY_CardParse_STYPE*YY_CardParse_LVAL%define	MEMBERS		char 		input_buff[4096];			\					int			input_done;					\					int			buffer_created;				\					int			sub_nest;					\					void		setBuffer(char *str);		\					void		cardParse(char *str);%define	CONSTRUCTOR_CODE	{								\		memset(input_buff, '\0', sizeof(input_buff));		\		input_done     = -1;								\		buffer_created = 0;									\		sub_nest       = 0;									\	}KANJI	([\x81-\x9f]|[\xe0-\xfc]).ALPHA	[_A-Za-z]+NUMERIC	[0-9]+CRLF	([\n][\r]?)+SPACE	[ \t]*OP		[(|\)\=\|\&\>\<\!\+\-\*\/\%\?{}\[\]]%x		SUBCMD%%<SUBCMD>"("		{					char	*dp = YY_CardParse_LVAL->name;					int		c;					sub_nest = 1;					*dp++ = '(';					do {						if ((c = yyinput()) == EOF) {							break;						}						if (c == '(') {							sub_nest++;						} else						if (c == ')') {							if (--sub_nest == 0) {								*dp++ = c;								break;							}						} else						if ((c >= 0x81 && c <= 0x9F) ||							(c >= 0xE0 && c <= 0xFC)) {							*dp++ = c;							c = yyinput();						}						*dp++ = c;					} while (sub_nest != 0);					*dp = '\0';					BEGIN	INITIAL;					return CardParse::STR;				};[ \t]*			{};{CRLF}*			{};{OP}			{					return yytext[0];				};">="			{					return CardParse::GTE;				};"<="			{					return CardParse::LTE;				};{NUMERIC}		{					YY_CardParse_LVAL->lval = atol((char *)yytext);					return CardParse::NUMBER;				};[@]{NUMERIC}	{					qd.randSeed = LMGetTicks();					YY_CardParse_LVAL->lval = abs(Random()%(atoi((char *)yytext + 1)+1));					return CardParse::NUMBER;				};({KANJI}|{ALPHA}|{NUMERIC})+	{					strcpy(YY_CardParse_LVAL->name, (char *)yytext);					return CardParse::VAR;				}"^"				{					BEGIN	SUBCMD;					return yytext[0];				};.				{};%%void#ifdef YY_USE_CLASSYY_CardLex_CLASS::#endifsetBuffer(char *str)	{	memset(input_buff, '\0', sizeof(input_buff));	strcpy(input_buff, str);	input_done = 0;	if (buffer_created) {		yy_delete_buffer(YY_CURRENT_BUFFER);	}	yy_initialize();	buffer_created = 1;}