// =================================================================================================//	CSystem.cp//		DNML for Macintosh ＤＮＭＬエンコード処理////	Copyright 2001, A.Iisaka// =================================================================================================#include "CSystem.h"#include "CTagBGM.h"#include "CTagSOUND.h"#include "CForm.h"/*************************************************************************************		サポート情報（2001/04/28）***********************************************************************************///	対応サウンド（サウンドファイル）形式：//		・QuickTimeでサポートしているものなら！！（但し、MIDIは貧弱かな？！）//		・ＣＤＤＡ//		----------------------------------------------------------------------------////	対応画像形式：//		・ＰＤＡ形式（ビジュアルアーツ系）//		・QuickTimeでサポートしているものなら！！//		----------------------------------------------------------------------------//		予定として、リーフの画像形式←一部実現//		（ＴＩＭもできっかな？）///*************************************************************************************		未実装リスト（2001/04/30）***********************************************************************************///	BOOKMARK	-	DoBOOKMARK()		:	いつ実現できる事やら・・・//	COMMAND		-	実装する予定無し//	CURSOR		-	実装する予定無し//	FORM		-	実装する予定無し//	/FORM		-	実装する予定無し//	INPUT		-	実装する予定無し//	PLAY		-	実装する予定無し//	/PLAY		-	実装する予定無し//	PLUGIN		-	実装する予定無し//	RECORD		-	実装する予定無し//	/RECORD		-	実装する予定無し//	SNAP		-	DoSNAP()			:	いつ実現できる事やら・・・///*************************************************************************************		未確認／不足項目（2001/04/30）***********************************************************************************///	・文字の禁則処理//	・テキストファイルのパース成功時にCeatorをDNMLにする！！//	・ノベルモード（テキスト全画面表示）の際の動作//	・ＤＮＭＬ構文解析の見直し//	・ウィンドウサイズとステージサイズが異なる場合の動作//	・ENTERでの表示順（名前順？）//	・１選択枝が複数行になった時の処理//	・指定サイズ（数値）不良のチェック//	・BOOKMARKができないと、しおりの書込み／読込みができない！！//	・画像ファイルの先読み及びキャッシュ化できるといいな！！//	・その他細かないろいろ////	・・・あと、全体的な処理（効率含む）の見直し　←　これが一番難しい！！////	CGraphicsクラス：//		エフェクト機能を更に充実したいな！！（処理の最適化も含む）////*********************************************************************************//*************************************************************************************		Constructor & Deconstructor***********************************************************************************/// ---------------------------------------------------------------------------------//		･ CSystem// ---------------------------------------------------------------------------------CSystem::CSystem(	char		*fileName,	PresetPtr	preset ){	mPreset      = preset;		mInProgress  = false;			// 処理継続中   for all tags	mCurTag      = nil;	mPushMouse   = false;			// マウスボタン for TEXT/T_BR/T_P/T_W	mSelectSkip  = false;			// メッセージ読み飛ばし	mFlagText    = false;			// 枠表示中	mBgmTimeout  = 5000;			// BGM timeout value	// システム環境	strcpy(mTopFile, fileName);	mStackDNML = new CStackDNML();	mDNML      = new dnmlparse(fileName);	mCARD      = new cardparse();	mAlias     = new CAlias();	mGraphics  = nil;	mSound     = new CSound();	mEnter     = nil;	mTextStr   = new CChar();	mFont      = new FONT;	strcpy(mTitle, "");	// 表示効果（背景）	mEffectBACKG    = new EFFECT;	memset(mEffectBACKG, '\0', sizeof(EFFECT));	mTimeBACKG      = mPreset->backSpeed;	mEDefaultBACKG  = EF_NORMAL;	// 表示効果（人物）	mEffectSPACE    = new EFFECT;	memset(mEffectSPACE, '\0', sizeof(EFFECT));	mTimeSPACE      = mPreset->charSpeed;	mEDefaultSPACE  = EF_FADEIN;	// 表示効果（メッセージウィンドウ）	mEffectSCREEN   = new EFFECT;	memset(mEffectSCREEN, '\0', sizeof(EFFECT));	mTimeSCREEN     = mPreset->wakuSpeed;	mEDefaultSCREEN = EF_FADEIN;	// 表示効果（カーテン ）	mEffectCURTAIN   = new EFFECT;	memset(mEffectCURTAIN, '\0', sizeof(EFFECT));	mTimeCURTAIN     = 20;	mEDefaultCURTAIN = mEDefaultBACKG;	mCurtainFlag     = false;	// 文字表示速度	mTimeTEXT        = mPreset->textSpeed;	// フェード時間		mFadeTime        = mPreset->wakuSpeed;	// for full-screen	mWindowOffset.h = 0;	mWindowOffset.v = 0;	mWindowSize.h   = 640;	mWindowSize.v   = 480; 	// STAGE default	mStageSize.h = 640;	mStageSize.v = 480;	// SCREEN default	mScreenPoint.h = 0;	mScreenPoint.v = 0;	mScreenSize.h  = mStageSize.h;	mScreenSize.v  = mStageSize.v;	mScreenShut    = SHUT_AUTO;	// SPACE default	mSpacePoint.h = 0;	mSpacePoint.v = 0;	mSpaceSize.h  = mStageSize.h;	mSpaceSize.v  = mStageSize.v;	// WINDOW default	mWakuFlag    = false;	mWakuPoint.h = mScreenPoint.h;	mWakuPoint.v = mScreenPoint.v;	mWakuSize.h  = mScreenSize.h;	mWakuSize.v  = mScreenSize.v;	mWakuShut    = SHUT_AUTO;	mWakuActive  = false;		// FONT default	FontInfo	finfo;	int			fontSize;	mFont          = new FONT;	mFont->fontID  = 16436;			// Osaka-等幅//	mFont->x       = fontSize = 27 - 1;	mFont->x       = fontSize = 27;	mFont->y       = 30;	mFont->r       = 0xff;	mFont->g       = 0xff;	mFont->b       = 0xff;	mFont->style   = normal;	mFont->sh      = true;	mFont->er      = false;	do {		FetchFontInfo(mFont->fontID, fontSize, normal, &finfo);		fontSize--;	} while (finfo.ascent + finfo.descent > mFont->y ||			 finfo.widMax > mFont->x);	mFont->s       = fontSize;	// ICON	mActiveBR     = false;	mActiveP      = false;	// KICK	mKickLoop     = 0;	// W	mWTime        = 0;	// WAIT	mWaitIndex    = -1;		// 表示制御用	mStackFont   = new CStackFont();	mStackClip   = new CStackClip();	mStackIndent = new CStackIndent();	mIndentPrev  = 0;	mIX          = mScreenPoint.h;	mCurX        = mScreenPoint.h;	mCurY        = mScreenPoint.v;	mCurH        = 0;	mCurCol      = 0;	mTextPtr     = nil;	mTextValid   = false;	mCurTextTime = mTimeTEXT;	mSelectCount = 0;	mSelectList  = -1;	mSelectText  = 0;	if (!mDNML->yyparse()) {		mCARD->parse("(DNML_VERSION=226)");		mAlias->addItem("PLAYER", mDNML->playerFolder);		mAlias->addItem("player", mDNML->playerFolder);		mAlias->addItem("EF_DEFAULT_BACK", "EF_NORMAL");		mAlias->addItem("EF_DEFAULT_CHAR", "EF_FADEIN");			CGameWindow	*theWindow = dynamic_cast<CGameWindow*>(LWindow::FindWindowByID(PPob_GameWindow));		theWindow->SetScreenSize(mStageSize.h, mStageSize.v);		theWindow->GetScreenSize(&mWindowSize.h, &mWindowSize.v);		theWindow->GetWindowOffset(&mWindowOffset);		if ((mGraphics = new CGraphics(this, theWindow->GetWindowPtr())) != nil) {			mGraphics->FillRect(0, 0, mWindowSize.h - 1, mWindowSize.v - 1, 0, 0, 0, 0);			mGraphics->AllCopy(0, CGB_STAGE,   0);		// for STAGE			mGraphics->AllCopy(0, CGB_BACKG,   0);		// for BACKG			mGraphics->AllCopy(0, CGB_BACKG01, 0);		// for BACKG loading file			mGraphics->AllCopy(0, CGB_WAKUG,   0);		// for WAKUG			mGraphics->AllCopy(0, CGB_WAKUG01, 0);		// for WAKUG loading file			mGraphics->AllCopy(0, CGB_MESWIN,  0);		// for MESWIN			mGraphics->AllCopy(0, CGB_CURTAIN, 0);		// for CURTAIN			mGraphics->AllCopy(0, CGB_BACKUP,  0);		// for BACKUP			mGraphics->AllCopy(0, CGB_HIDE,    0);		// for HIDE			mGraphics->AllCopy(0, CGB_STRETCH, 0);		// for STRETCH			// for SPACE			CGBuffer	*cgb = new CGBuffer(mWindowSize.h, mWindowSize.v, 3, mWindowSize.h*3, true, 0);			mGraphics->SetPDT(CGB_SPACE, cgb);			mGraphics->ResetTimer();			mGraphics->SetAntiAlias(mPreset->antiAlias);		}		// TIMER		mTimerWait    = 0;		mTimerBase    = mGraphics->GetCurrentTimer();		mEnter    = new CEnter(mGraphics);		// 処理の実装		mStartBGM   = false;		mTagBGM     = new CTagBGM(&mDNML, &mCARD, &mAlias, &mGraphics, &mSound);					// <BGM>, </BGM>		mStartSOUND = false;		mTagSOUND   = new CTagSOUND(&mDNML, &mCARD, &mAlias, &mGraphics, &mSound);					// <SOUND>, </SOUND>			// オプションフラグ		mTagBGM->setActive(mPreset->bgmActive);			// ＢＧＭ有効		mTagBGM->setVolume(mPreset->bgmVolume);		mTagSOUND->setActive(mPreset->sndActive);		// 効果音有効		mTagSOUND->setVolume(mPreset->sndVolume);		mActiveText = true;					// 文字表示有効		mActiveIcon = true;					// アイコン表示有効		mNovelMode  = true;					// 全画面文字列表示		mGraphics->FillRect(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_WAKUG, 0, 0, 0);		CGBuffer		*cgb = mGraphics->GetPDT(CGB_WAKUG);		unsigned char	*msk = cgb->GetMaskBuffer();		memset(msk, 0x80, cgb->GetSizeX() * cgb->GetSizeY());		mWakuFlag       = true;		mWakuActive     = false;		mWakuShut       = SHUT_AUTO;	}}// ---------------------------------------------------------------------------------//		･ ~CSystem// ---------------------------------------------------------------------------------CSystem::~CSystem(){	if (mTagBGM)			delete mTagBGM;	if (mTagSOUND)			delete mTagSOUND;	if (mStackFont)			delete mStackFont;	if (mStackClip)			delete mStackClip;	if (mStackIndent)		delete mStackIndent;	if (mEffectCURTAIN)		delete mEffectCURTAIN;	if (mEffectSCREEN)		delete mEffectSCREEN;	if (mEffectSPACE)		delete mEffectSPACE;	if (mEffectBACKG)		delete mEffectBACKG;	if (mDNML)				delete mDNML;	if (mCARD)				delete mCARD;	if (mAlias)				delete mAlias;	if (mGraphics)			delete mGraphics;	if (mSound)				delete mSound;	if (mEnter)				delete mEnter;	if (mTextStr)			delete mTextStr;	if (mFont)				delete mFont;}/*************************************************************************************		DNML制御***********************************************************************************/// ---------------------------------------------------------------------------------//		･ DnmlTaskEnd// ---------------------------------------------------------------------------------voidCSystem::DnmlTaskEnd(void){	CGameWindow		*theWindow = dynamic_cast<CGameWindow*>(LWindow::FindWindowByID(PPob_GameWindow));	mSound->BGM_Stop();	mGraphics->FillRect(0, 0, mWindowSize.h - 1, mWindowSize.v - 1, 0, 0, 0, 0);	mGraphics->UpdateScreen();	DoEXIT(nil);	while ( mDNML->getNextScenario() )		;	theWindow->SetDescriptor("\pDNML for Macintosh");}// ---------------------------------------------------------------------------------//		･ DnmlTask// ---------------------------------------------------------------------------------BooleanCSystem::DnmlTask(	Point		inPort,	Boolean		inFlag ){	char			aChar;	CGameWindow		*theWindow = dynamic_cast<CGameWindow*>(LWindow::FindWindowByID(PPob_GameWindow));	ThrowIfNil_(theWindow);	EventRecord		*theEvent  = theWindow->GetEvent();		if (theEvent) {		switch (theEvent->what) {			case keyDown:			case autoKey:				aChar = (theEvent->message & charCodeMask);				if ((theEvent->modifiers & cmdKey) && (aChar = 'Q' || aChar == 'q')) {					return false;				} else				if (aChar == 0x0d) {					if (!mActiveText) {						SwitchText();						aChar          = 0;						theEvent->what = nullEvent;						return true;					}					if (mInProgress) {						mPushMouse = true;					}				} else				if (aChar == 's' || aChar == 'S') {					SetSkipStatus(true);				} else				if (aChar == kUpArrowCharCode || aChar == kDownArrowCharCode) {					mPushMouse = false;				} else {					mPushMouse = false;					aChar      = 0;				}				break;			case mouseDown:				if (!mActiveText) {					SwitchText();					mPushMouse     = false;					theEvent->what = nullEvent;					return true;				} else {					mPushMouse = (!(theEvent->modifiers & controlKey)) ? true : false;				}				break;			default:				mPushMouse = false;				break;		}		theEvent = nil;	}	if (!mActiveText) {		DoSoundIdle();		return true;	}	if (!mInProgress) {		if (!(mCurTag = mDNML->getNextScenario())) {			if (!mStackDNML->pop(&mDNML)) {				theWindow->SetDescriptor("\pDNML for Macintosh");				return false;			}		}	}	switch (mCurTag->getTagType()) {		case	DnmlParse::TEXT:			{	/*** TEXT ***/				if (!mInProgress) {					StrText			*tag = (StrText*)mCurTag;					mTextValid = false;					if (tag->string_data) {						if (strcmp(CSTR(tag->string_data), "\n")) {							mTextPtr = CSTR(tag->string_data);//							for (; *mTextPtr == ' ' || *mTextPtr == '\t'; mTextPtr++)//								;							if (mCurtainFlag || mPreset->textDisable) {								DispMesWin(CGB_STAGE);								PutStr(mTextPtr);							} else {								unsigned char	cbuff[32], *p = (unsigned char *)mTextPtr;								if ((*p >= 0x81 && *p <= 0x9F) ||									(*p >= 0xE0 && *p <= 0xFC)) {									cbuff[0] = *p;									cbuff[1] = *(p+1);									cbuff[2] = '\0';									mTextPtr += 2;								} else {									if (!strncmp(mTextPtr, "&lt;", 4) ||										!strncmp(mTextPtr, "&LT;", 4)) {										strcpy((char *)cbuff, "<");										mTextPtr += 4;									} else									if (!strncmp(mTextPtr, "&gt;", 4) ||										!strncmp(mTextPtr, "&GT;", 4)) {										strcpy((char *)cbuff, ">");										mTextPtr += 4;									} else									if (!strncmp(mTextPtr, "&amp;", 5) ||										!strncmp(mTextPtr, "&AMP;", 5)) {										strcpy((char *)cbuff, "&");										mTextPtr += 5;									} else									if (!strncmp(mTextPtr, "&quot;", 6) ||										!strncmp(mTextPtr, "&QUOT;", 6)) {										strcpy((char *)cbuff, "\"");										mTextPtr += 6;									} else									if (!strncmp(mTextPtr, "&nbsp;", 6) ||										!strncmp(mTextPtr, "&NBSP;", 6)) {										strcpy((char *)cbuff, " ");										mTextPtr += 6;									} else {										cbuff[0] = *p;										cbuff[1] = '\0';										mTextPtr++;									}								}								if (strcmp((char *)cbuff, "\n") &&									strcmp((char *)cbuff, "\r") &&									strcmp((char *)cbuff, "\t") &&									strcmp((char *)cbuff, " ")  &&									cbuff[0] != '\0') {									DispMesWin(CGB_STAGE);									PutChar((unsigned char *)cbuff, true);									if (strcmp((char *)cbuff, "　")) {										mTextValid = true;									}								}								mInProgress = true;								mGraphics->ResetTimer();							}						}					}				} else {					if (mPushMouse) {						PutStr(mTextPtr);						mInProgress = false;						mPushMouse  = false;						mTextValid  = false;					} else {						if (mGraphics->GetTimer() >= mTimeTEXT) {							if (*mTextPtr == '\0') {								mInProgress = false;								mTextValid  = false;							} else {								unsigned char	cbuff[32], *p = (unsigned char *)mTextPtr;								if ((*p >= 0x81 && *p <= 0x9F) ||									(*p >= 0xE0 && *p <= 0xFC)) {									cbuff[0] = *p;									cbuff[1] = *(p+1);									cbuff[2] = '\0';									mTextPtr += 2;								} else {									if (!strncmp(mTextPtr, "&lt;", 4) ||										!strncmp(mTextPtr, "&LT;", 4)) {										strcpy((char *)cbuff, "<");										mTextPtr += 4;									} else									if (!strncmp(mTextPtr, "&gt;", 4) ||										!strncmp(mTextPtr, "&GT;", 4)) {										strcpy((char *)cbuff, ">");										mTextPtr += 4;									} else									if (!strncmp(mTextPtr, "&amp;", 5) ||										!strncmp(mTextPtr, "&AMP;", 5)) {										strcpy((char *)cbuff, "&");										mTextPtr += 5;									} else									if (!strncmp(mTextPtr, "&quot;", 6) ||										!strncmp(mTextPtr, "&QUOT;", 6)) {										strcpy((char *)cbuff, "\"");										mTextPtr += 6;									} else									if (!strncmp(mTextPtr, "&nbsp;", 6) ||										!strncmp(mTextPtr, "&NBSP;", 6)) {										strcpy((char *)cbuff, " ");										mTextPtr += 6;									} else {										cbuff[0] = *p;										cbuff[1] = '\0';										mTextPtr++;									}								}								if (strcmp((char *)cbuff, "\n") &&									strcmp((char *)cbuff, "\r") &&									strcmp((char *)cbuff, " ")  &&									cbuff[0] != '\0') {									PutChar((unsigned char *)cbuff, true);									if (strcmp((char *)cbuff, "　")) {										mTextValid = true;									}								} else {									if (!strcmp((char *)cbuff, "\n")) {										char	*skip;										for (skip = mTextPtr; *skip == ' ' || *skip == '\t'; skip++)											;										mTextPtr = skip;									} else									if (mTextValid && !strcmp((char *)cbuff, " ")) {										PutChar((unsigned char *)cbuff, true);									}								}								mGraphics->ResetTimer();							}						}					}				}			}			break;		case	DnmlParse::CARD:			{	/*** <<...>> ***/				// none			}			break;		case	DnmlParse::T_A:			{	/*** <A> ***/				DoA(theWindow);			}			break;		case	DnmlParse::T_ACT:			{	/*** <ACT> ***/				DoACT(theWindow);			}			break;		case	DnmlParse::T_ALIAS:			{	/*** <ALIAS> ***/				TagAlias	*tag = (TagAlias*)mCurTag;				if (tag->k_src && tag->k_dest) {					mAlias->addItem(CSTR(tag->k_src), CSTR(tag->k_dest));				}			}			break;		case	DnmlParse::T_ALIAS_E:			{	/*** </ALIAS> ***/				TagAlias	*tag = (TagAlias*)mCurTag;				mAlias->delItem(CSTR(tag->k_src));			}			break;		case	DnmlParse::T_B:			{	/*** <B> ***/				DoB(theWindow);			}			break;		case	DnmlParse::T_B_E:			{	/*** </B> ***/				popFont();			}			break;		case	DnmlParse::T_BACKGROUND:			{	/*** <BACKGROUND> ***/				DoBACKGROUND(theWindow);			}			break;		case	DnmlParse::T_BGM:			{	/*** <BGM> ***/				mInProgress = mTagBGM->run(mCurTag);				if (mTagBGM->getActive()) {					mStartBGM = true;				}			}			break;					case	DnmlParse::T_BGM_E:			{	/*** </BGM> ***/				mInProgress = mTagBGM->stop(mCurTag);				if (mTagBGM->getActive()) {					mStartBGM = false;				}			}			break;					case	DnmlParse::T_BOOKMARK:			{	/*** <BOOKMARK> ***/				//				// 未実装 - 実装方法が検討つかない！！				//			}			break;		case	DnmlParse::T_BR:			{	/*** <BR> ***/				DoBR(theWindow);			}			break;		case	DnmlParse::T_CARD:			{	/*** <CARD> ***/				DoCARD(theWindow);			}			break;		case	DnmlParse::T_CLIP:			{	/*** <CLIP> ***/				pushClip();			}			break;		case	DnmlParse::T_CLIP_E:			{	/*** </CLIP> ***/				popClip();			}			break;		case	DnmlParse::T_COMMAND:			{	/*** <COMMAND> ***/				//				// 未実装 - 実装する予定無し				//			}			break;		case	DnmlParse::T_COVER:			{	/*** <COVER> ***/				// none			}			break;		case	DnmlParse::T_CURSOR:			{	/*** <CURSOR> ***/				//				// 未実装 - 実装する予定無し				//			}			break;		case	DnmlParse::T_CURTAIN:			{	/*** <CURTAIN> ***/				DoCURTAIN(theWindow);			}			break;		case	DnmlParse::T_CURTAIN_E:			{	/*** </CURTAIN> ***/				DoCURTAIN_E(theWindow);			}			break;		case	DnmlParse::T_END:			{	/*** <END> ***/				DoEND(theWindow);			}			return false;		case	DnmlParse::T_ENTER:			{	/*** <ENTER> ***/				DoENTER(theWindow);			}			break;		case	DnmlParse::T_EVENT:			{	/*** <EVENT> ***/				DoEVENT(theWindow);			}			break;		case	DnmlParse::T_EVENT_E:			{	/*** </EVENT> ***/				// none			}			break;		case	DnmlParse::T_EXIT:			{	/*** <EXIT> ***/				DoEXIT(theWindow);			}			break;		case	DnmlParse::T_FONT:			{	/*** <FONT> ***/				DoFONT(theWindow);			}			break;		case	DnmlParse::T_FONT_E:			{	/*** </FONT> ***/				popFont();			}			break;		case	DnmlParse::T_FORM:			{	/*** <FORM> ***/				//				// 未実装 - 実装する予定無し				//			}			break;		case	DnmlParse::T_FORM_E:			{	/*** </FORM> ***/				//				// 未実装 - 実装する予定無し				//			}			break;		case	DnmlParse::T_I:			{	/*** <I> ***/				DoI(theWindow);			}			break;		case	DnmlParse::T_I_E:			{	/*** </I> ***/				popFont();			}			break;		case	DnmlParse::T_ICON:			{	/*** <ICON> ***/				DoICON(theWindow);			}			break;		case	DnmlParse::T_ICON_E:			{	/*** </ICON> ***/				DoICON_E(theWindow);			}			break;		case	DnmlParse::T_INCLUDE:			{	/*** <INCLUDE> ***/				TagInclude		*tag = (TagInclude*)mCurTag;				char			fileName[256], curDir[256];					// パラメータの置換				string	*c_src         = GetNativeParam(tag->k_src,         true);				string	*c_folder      = GetNativeParam(tag->k_folder,      true);				strcpy(curDir, mDNML->currentFolder);								strcpy(fileName, "");				if (c_folder) {					strcat(fileName, CSTR(c_folder));					if (fileName[strlen(fileName)-1] != '/') {						strcat(fileName, "/");					}				} else {					strcpy(fileName, mDNML->currentFolder);				}				if (c_src) {					strcat(fileName, CSTR(c_src));					mStackDNML->push(&mDNML, fileName);				}				strcpy(mDNML->currentFolder, curDir);				// パラメータの後始末				if (c_src)			delete c_src;				if (c_folder)		delete c_folder;			}			break;		case	DnmlParse::T_INDENT:			{	/*** <INDENT> ***/				pushIndent();				mIX = mCurX;			}			break;		case	DnmlParse::T_INDENT_E:			{	/*** </INDENT> ***/				popIndent();			}			break;		case	DnmlParse::T_INPUT:			{	/*** <INPUT> ***/				//				// 未実装 - 実装する予定無し				//			}			break;		case	DnmlParse::T_KICK:			{	/*** <KICK> ***/				DoKICK(theWindow);			}			break;		case	DnmlParse::T_MEMO:			{	/*** <MEMO> ***/				DoMEMO(theWindow);			}			break;		case	DnmlParse::T_NL:			{	/*** <NL> or <NEWLINE> ***/				PutChar((unsigned char *)"\n", true);			}			break;		case	DnmlParse::T_NP:			{	/*** <NP> or <NEWPAGE> ***///				if (!mWakuFlag) {					ClearTEXT();//				}				DispCreate(CGB_STAGE, true);				mGraphics->Copy(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_STAGE,								(mCurtainFlag) ? 0 : CSYS_OFFX(0),								(mCurtainFlag) ? 0 : CSYS_OFFY(0),								(mCurtainFlag) ? CGB_CURTAIN : 0,								0);			}			break;		case	DnmlParse::T_P:			{	/*** <P> ***/				DoP(theWindow);			}			break;		case	DnmlParse::T_PLAY:			{	/*** <PLAY> ***/				//				// 未実装 - 実装する予定無し				//			}			break;		case	DnmlParse::T_PLAY_E:			{	/*** </PLAY> ***/				//				// 未実装 - 実装する予定無し				//			}			break;		case	DnmlParse::T_PLUGIN:			{	/*** <PLUGIN> ***/				//				// 未実装 - 実装する予定無し				//			}			break;		case	DnmlParse::T_POSITION:			{	/*** <POSITION> ***/				DoPOSITION(theWindow);			}			break;		case	DnmlParse::T_QUESTION:			{	/*** <QUESTION> ***/				DoQUESTION(theWindow);			}			break;		case	DnmlParse::T_RECORD:			{	/*** <RECORD> ***/				//				// 未実装 - 実装する予定無し				//			}			break;		case	DnmlParse::T_RECORD_E:			{	/*** </RECORD> ***/				//				// 未実装 - 実装する予定無し				//			}			break;		case	DnmlParse::T_S:			{	/*** <S> ***/				mFont->er = true;			}			break;		case	DnmlParse::T_S_E:			{	/*** </S> ***/				mFont->er = false;			}			break;		case	DnmlParse::T_SCREEN:			{	/*** <SCREEN> ***/				DoSCREEN(theWindow);			}			break;		case	DnmlParse::T_SHADOW:			{	/*** <SHADOW> ***/				mFont->sh = true;			}			break;		case	DnmlParse::T_SHADOW_E:			{	/*** </SHADOW> ***/				mFont->sh = false;			}			break;		case	DnmlParse::T_SNAP:			{	/*** <SNAP> ***/				//				// 未実装				//			}			break;		case	DnmlParse::T_SOUND:			{	/*** <SOUND> ***/				mInProgress = mTagSOUND->run(mCurTag);				if (mTagSOUND->getActive()) {					mStartSOUND = true;				}			}			break;		case	DnmlParse::T_SOUND_E:			{	/*** </SOUND> ***/				mInProgress = mTagSOUND->stop(mCurTag);				if (mTagSOUND->getActive()) {					mStartSOUND = false;				}			}			break;		case	DnmlParse::T_SPACE:			{	/*** <SPACE> ***/				DoSPACE(theWindow);			}			break;		case	DnmlParse::T_STAGE:			{	/*** <STAGE> ***/				DoSTAGE(theWindow);			}			break;		case	DnmlParse::T_SUNGLASS:			{	/*** <SUNGLASS> ***/				DoSUNGLASS(theWindow);			}			break;		case	DnmlParse::T_SUNGLASS_E:			{	/*** </SUNGLASS> ***/				mSunglass = false;			}			break;		case	DnmlParse::T_TIMER:			{	/*** <TIMER> ***/				DoTIMER(theWindow);			}			break;		case	DnmlParse::T_TITLE:			{	/*** <TITLE> ***/				DoTITLE(theWindow);			}			break;		case	DnmlParse::T_TRAP:			{	/*** <TRAP> ***/				DoTRAP(theWindow);			}			break;		case	DnmlParse::T_U:			{	/*** <U> ***/				DoU(theWindow);			}			break;		case	DnmlParse::T_U_E:			{	/*** </U> ***/				popFont();			}			break;		case	DnmlParse::T_W:			{	/*** <W> ***/				DoW(theWindow);			}			break;		case	DnmlParse::T_WAIT:			{	/*** <WAIT> ***/				DoWAIT(theWindow);			}			break;		case	DnmlParse::T_WAIT_E:			{	/*** </WAIT> ***/				popWait();			}			break;		case	DnmlParse::T_WINDOW:			{	/*** <WINDOW> ***/				DoWINDOW(theWindow);			}			break;		case	DnmlParse::T_WINDOW_E:			{	/*** </WINDOW> ***/				EraseMesWin(true);				mWakuFlag  = false;			}			break;		case	DnmlParse::T_WRITE:			{	/*** <WRITE> ***/				DoWRITE(theWindow);			}			break;		default:			break;	}	// 画面表示制御	DoDisplayIdle();		// 選択枝表示制御	DoSelectList(inFlag, inPort.h, inPort.v, aChar);	// サウンドチェック	DoSoundIdle();	return true;}// ---------------------------------------------------------------------------------//		･ SetSkipStatus// ---------------------------------------------------------------------------------voidCSystem::SetSkipStatus(void){	if (!mSelectSkip) {		mSelectSkip  = true;		mCurTextTime = mTimeTEXT;		mTimeTEXT    = 1;		mPushMouse   = false;		mActiveIcon  = false;	} else {		mSelectSkip  = false;		mTimeTEXT    = mCurTextTime;		mActiveIcon  = true;	}}voidCSystem::SetSkipStatus(	Boolean			inSkip ){	if (inSkip) {		mSelectSkip  = true;		mCurTextTime = mTimeTEXT;		mTimeTEXT    = 1;		mPushMouse   = false;		mActiveIcon  = false;	} else {		mSelectSkip  = false;		mTimeTEXT    = mCurTextTime;		mActiveIcon  = true;	}}/*************************************************************************************		ＢＧＭ／サウンド監視***********************************************************************************/// ---------------------------------------------------------------------------------//		･ DoSoundIdle// ---------------------------------------------------------------------------------voidCSystem::DoSoundIdle(void){	// BGM	if (mTagBGM->getActive() && mStartBGM) {		mTagBGM->idle();	}	// Sound	if (mTagSOUND->getActive() && mStartSOUND) {		mTagSOUND->idle();	}}/*************************************************************************************		表示制御***********************************************************************************/// ---------------------------------------------------------------------------------//		･ DoDisplayIdle// ---------------------------------------------------------------------------------voidCSystem::DoDisplayIdle(void){	if (mEffectBACKG->cmd) {		mGraphics->Effect(mSelectSkip, mEffectBACKG);	}	if (mEffectCURTAIN->cmd) {		mGraphics->Effect(mSelectSkip, mEffectCURTAIN);	}	if (mEffectSPACE->cmd) {		mGraphics->Effect(mSelectSkip, mEffectSPACE);	}	if (mEffectSCREEN->cmd) {		mGraphics->Effect(mSelectSkip, mEffectSCREEN);	}	if (mActiveBR) {		mGraphics->DispBIcon(mActiveIcon, mSelectSkip, mCurX, mCurY);	}	if (mActiveP) {		mGraphics->DispPIcon(mActiveIcon, mSelectSkip, mCurX, mCurY);	}	if (mKickLoop) {		int		x1, y1, x2, y2, dx, dy;		if (mGraphics->GetTimer() >= mKickTime) {			if (mKickDirection == 0) {				dx = 0;					dy = 0;				x1 = 0;					y1 = mKickWidth;				x2 = mStageSize.h - 1;	y2 = mStageSize.v - 1;			} else			if (mKickDirection == 1) {				dx = 0;					dy = mKickWidth;				x1 = 0;					y1 = 0;				x2 = mStageSize.h - 1;	y2 = mStageSize.v - 1 - mKickWidth;			} else			if (mKickDirection == 2) {				dx = 0;					dy = 0;				x1 = mKickWidth;		y1 = 0;				x2 = mStageSize.h - 1;	y2 = mStageSize.v - 1;			} else			if (mKickDirection == 3) {				dx = mKickWidth;					dy = 0;				x1 = 0;								y1 = 0;				x2 = mStageSize.h - 1 - mKickWidth;	y2 = mStageSize.v - 1;			}			mGraphics->Copy(x1, y1, x2, y2, CGB_BACKUP,							CSYS_OFFX(dx), CSYS_OFFY(dy), 0, 0);			if (++mKickDirection > 3) {				--mKickLoop;				mKickDirection = 0;			}			mGraphics->ResetTimer();		}	}}// ---------------------------------------------------------------------------------//		･ DispCreate// ---------------------------------------------------------------------------------voidCSystem::DispCreate(	int			inBufNo,	Boolean		inTextFlag ){	Boolean		doFlag = false;		mGraphics->AllCopy(CGB_BACKG, inBufNo, 0);	mGraphics->MaskCopy(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_SPACE,						0, 0, inBufNo, 0);	if (mWakuFlag) {		if (mWakuShut == SHUT_NONE) {			doFlag = true;		} else {			if (!inTextFlag) {//				if (mTextStr->getCharCount()) {//					doFlag = true;//				}				mWakuActive = false;			} else {				ClearTEXT();				if (mWakuActive) {					doFlag = true;				}			}		}	}	if (doFlag) {		mGraphics->MaskCopy(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_WAKUG,							0, 0, inBufNo, 0);		if (!inTextFlag && mTextStr->getCharCount()) {			DispStrBuffer(inBufNo);		}		mWakuActive = true;	}}// ---------------------------------------------------------------------------------//		･ DispAll// ---------------------------------------------------------------------------------voidCSystem::DispAll(	int			inBufNo,	Boolean		inDirect ){	mGraphics->AllCopy(CGB_BACKG, inBufNo, 0);	mGraphics->MaskCopy(0,						0,						mStageSize.h - 1,						mStageSize.v - 1,						CGB_SPACE,						0,						0,						inBufNo, 0);	mFlagText = false;	if (mActiveText) {		DispMesWin(inBufNo);	}	if (inDirect) {		CSYS_COPYFROM(inBufNo);	}};// ---------------------------------------------------------------------------------//		･ EraseBACKG// ---------------------------------------------------------------------------------voidCSystem::EraseBACKG(	int			inBufNo,	Boolean		inDirect ){	mGraphics->FillRect(0, 0, mStageSize.h - 1, mStageSize.v - 1, inBufNo, 0, 0, 0);	mGraphics->MaskCopy(0,						0,						mStageSize.h - 1,						mStageSize.v - 1,						CGB_SPACE,						0,						0,						inBufNo, 0);	DispMesWin(inBufNo);	if (inDirect) {		CSYS_COPYFROM(inBufNo);	}}// ---------------------------------------------------------------------------------//		･ EraseSpace// ---------------------------------------------------------------------------------voidCSystem::EraseSpace(	int			inBufNo,	Boolean		inDirect ){	mGraphics->AllCopy(CGB_BACKG, inBufNo, 0);	DispMesWin(inBufNo);	if (inDirect) {		CSYS_COPYFROM(inBufNo);	}}// ---------------------------------------------------------------------------------//		･ EraseMesWin// ---------------------------------------------------------------------------------voidCSystem::EraseMesWin(	Boolean		inWinFlag ){	Boolean		doFlag = false;		memcpy(mEffectSCREEN, '\0', sizeof(EFFECT));	if (inWinFlag) {		if (mWakuFlag && mWakuActive && !mCurtainFlag) {			doFlag = true;		}	} else {		if (mWakuFlag && mWakuActive && !mCurtainFlag && mWakuShut == SHUT_AUTO) {			doFlag = true;		}	}	if (doFlag) {		mGraphics->AllCopy(CGB_BACKG, CGB_STAGE, 0);		mGraphics->MaskCopy(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_SPACE,							0, 0, CGB_STAGE, 0);		if (mPreset->wakuDisable) {			mGraphics->Copy(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_STAGE,							CSYS_OFFX(0), CSYS_OFFY(0), 0, 0);		} else {			mEffectSCREEN->cmd      = mEDefaultSCREEN;			mEffectSCREEN->sx1      = 0;			mEffectSCREEN->sy1      = 0;			mEffectSCREEN->sx2      = mStageSize.h - 1;			mEffectSCREEN->sy2      = mStageSize.v - 1;			mEffectSCREEN->src      = CGB_STAGE;			mEffectSCREEN->dx       = CSYS_OFFX(0);			mEffectSCREEN->dy       = CSYS_OFFY(0);			mEffectSCREEN->dst      = 0;			mEffectSCREEN->steptime = mTimeSCREEN;			mEffectSCREEN->prevtime = mGraphics->GetCurrentTimer();			mEffectSCREEN->step     = 16;			mEffectSCREEN->curcount = 0;			while (mEffectSCREEN->cmd) {				mGraphics->Effect(mSelectSkip, mEffectSCREEN);//				DoSoundIdle();			}		}		mWakuActive = false;		if (inWinFlag) {//			ClearTEXT();			if (!mTextStr) {				delete mTextStr;			}			mTextStr  = new CChar();		}	}}// ---------------------------------------------------------------------------------//		･ DispMesWin// ---------------------------------------------------------------------------------voidCSystem::DispMesWin(	int				inBufNo ){	memcpy(mEffectSCREEN, '\0', sizeof(EFFECT));	if (!mWakuActive) {		mGraphics->AllCopy(CGB_BACKG, inBufNo, 0);		mGraphics->MaskCopy(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_SPACE,							0, 0, inBufNo, 0);		if (mWakuFlag) {			mGraphics->MaskCopy(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_WAKUG,								0, 0, inBufNo, 0);		}		if (mTextStr->getCharCount()) {			DispStrBuffer(inBufNo);		}		if (mPreset->wakuDisable) {			mGraphics->Copy(0, 0, mStageSize.h - 1, mStageSize.v - 1, inBufNo,							(!mCurtainFlag) ? CSYS_OFFX(0) : 0,							(!mCurtainFlag) ? CSYS_OFFY(0) : 0,							(!mCurtainFlag) ? 0 : CGB_CURTAIN,							0);		} else {			mEffectSCREEN->cmd      = (!mCurtainFlag) ? mEDefaultSCREEN : EF_NONE;			mEffectSCREEN->sx1      = 0;			mEffectSCREEN->sy1      = 0;			mEffectSCREEN->sx2      = mStageSize.h - 1;			mEffectSCREEN->sy2      = mStageSize.v - 1;			mEffectSCREEN->src      = inBufNo;			mEffectSCREEN->dx       = (!mCurtainFlag) ? CSYS_OFFX(0) : 0;			mEffectSCREEN->dy       = (!mCurtainFlag) ? CSYS_OFFY(0) : 0;			mEffectSCREEN->dst      = (!mCurtainFlag) ? 0 : CGB_CURTAIN;			mEffectSCREEN->steptime = mTimeSCREEN;			mEffectSCREEN->prevtime = mGraphics->GetCurrentTimer();			mEffectSCREEN->step     = 16;			mEffectSCREEN->curcount = 0;			while (mEffectSCREEN->cmd) {				mGraphics->Effect(mSelectSkip, mEffectSCREEN);//				DoSoundIdle();			}		}		mWakuActive = true;	}}// ---------------------------------------------------------------------------------//		･ BusyMesWin// ---------------------------------------------------------------------------------BooleanCSystem::BusyMesWin(void){	return (!mEffectSCREEN->cmd) ? false : true;}// ---------------------------------------------------------------------------------//		･ SwitchText// ---------------------------------------------------------------------------------voidCSystem::SwitchText(void){	if (mActiveText) {		mActiveText = false;	} else {		mActiveText = true;		mWakuActive = false;	}	DispAll(CGB_STAGE, true);}// ---------------------------------------------------------------------------------//		･ ClearTEXT// ---------------------------------------------------------------------------------voidCSystem::ClearTEXT(void){	mCurX     = mScreenPoint.h;	mCurY     = mScreenPoint.v;	mCurH     = mFont->y;	mCurCol   = 0;	if (!mTextStr) {		delete mTextStr;	}	mTextStr  = new CChar();}// ---------------------------------------------------------------------------------//		･ MakeSunglass// ---------------------------------------------------------------------------------voidCSystem::MakeSunglass(	int			inBufNo ){	CGBuffer	*cgb = mGraphics->GetPDT(inBufNo);	if (mSunglassMode == SUN_COLOR) {		mGraphics->MakeBrightMask(0,								  0,								  cgb->GetSizeX() - 1,								  cgb->GetSizeY() - 1,								  inBufNo,								  mSunglassR, mSunglassG, mSunglassB);	} else	if (mSunglassMode == SUN_INVERSE) {		mGraphics->MakeInvert(0,							  0,							  cgb->GetSizeX() - 1,							  cgb->GetSizeY() - 1,							  inBufNo);	} else	if (mSunglassMode == SUN_MONO ||		mSunglassMode == SUN_SEPIA) {		mGraphics->MakeMonochrome(0,								  0,								  cgb->GetSizeX() - 1,								  cgb->GetSizeY() - 1,								  inBufNo);		if (mSunglassMode == SUN_SEPIA) {			mGraphics->MakeColorMask(0,									 0,									 cgb->GetSizeX() - 1,									 cgb->GetSizeY() - 1,									 inBufNo,									 0xff, 0xff, 0x70);		}	} else	if (mSunglassMode == SUN_LIGHT) {		mGraphics->MakeBrightMask(0,								  0,								  cgb->GetSizeX() - 1,								  cgb->GetSizeY() - 1,								  inBufNo,								  0xc0, 0xc0, 0xc0);	} else	if (mSunglassMode == SUN_NIGHT) {		mGraphics->MakeColorMask(0,								 0,								 cgb->GetSizeX() - 1,								 cgb->GetSizeY() - 1,								 inBufNo,								 0x50, 0x50, 0x50);	} else	if (mSunglassMode == SUN_MIDNIGHT) {		mGraphics->MakeColorMask(0,								 0,								 cgb->GetSizeX() - 1,								 cgb->GetSizeY() - 1,								 inBufNo,								 0x20, 0x20, 0x20);	}}/*************************************************************************************		文字表示制御***********************************************************************************/static unsigned short SpCharTable[0x60] = {/* 8740 */	0x8540, 0x8541, 0x8542, 0x8543, 0x8544, 0x8545, 0x8546, 0x8547,/* 8748 */	0x8548, 0x8549, 0x854a, 0x854b, 0x854c, 0x854d, 0x854e, 0x854f,/* 8750 */	0x8550, 0x8551, 0x8552, 0x8553, 0x859f, 0x85a0, 0x85a1, 0x85a2,/* 8758 */	0x85a3, 0x85a4, 0x85a5, 0x85a6, 0x85a7, 0x85a8, 0x8140, 0x879f,/* 8760 */	0x87a2, 0x87a0, 0x87a1, 0x87a9, 0x87ab, 0x87a7, 0x87a8, 0x87ac,/* 8768 */	0x87af, 0x87b0, 0x87b3, 0x87b2, 0x87b5, 0x87ad, 0x87b4, 0x8640,/* 8770 */	0x8642, 0x8648, 0x864a, 0x864c, 0x864d, 0x8646, 0x8140, 0x8140,/* 8778 */	0x8140, 0x8140, 0x8140, 0x8140, 0x8140, 0x8140, 0x87e8, 0x8140,/* 8780 */	0x8854, 0x8855, 0x869b, 0x869c, 0x869d, 0x8793, 0x8794, 0x8795,/* 8788 */	0x8796, 0x8797, 0x874d, 0x8750, 0x874b, 0x87e5, 0x87e6, 0x87e7,/* 8790 */	0x81e0, 0x81df, 0x81e7, 0x8840, 0x83b0, 0x81e3, 0x81db, 0x81da,/* 8798 */	0x8841, 0x8842, 0x81e6, 0x81bf, 0x81be, 0x8140, 0x8140, 0x8140};// ---------------------------------------------------------------------------------//		･ PutChar// ---------------------------------------------------------------------------------voidCSystem::PutChar(	unsigned char	*inStr,	Boolean			savFlag ){	int		inc;	//	if (savFlag) {//		mTextStr->addChar(mCurX, mCurY, mCurH, mCurCol, mFont, (char *)inStr);//	}	if (*inStr == '\n') {		mCurX        = mIX;		mCurY       += mCurH;		mCurCol      = 0;		// auto-newpage		if (mCurY + mCurH > mScreenPoint.v + mScreenSize.v) {			ClearTEXT();			DispCreate(CGB_STAGE, true);			mGraphics->Copy(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_STAGE,							(mCurtainFlag) ? 0 : CSYS_OFFX(0),							(mCurtainFlag) ? 0 : CSYS_OFFY(0),							(mCurtainFlag) ? CGB_CURTAIN : 0,							0);		}	} else {		if ((*inStr >= 0x81 && *inStr <=0x9F) || (*inStr >= 0xE0 && *inStr <= 0xFC)) {			if (inStr[0] == 0x87) {				if ((inStr[1] >= 0x40) && (inStr[1] < 0xa0)) {					*((unsigned short*)inStr) = SpCharTable[inStr[1]-0x40];				}			}			if (mCurX + mFont->x > mScreenPoint.h + mScreenSize.h) {				mCurX   = mIX;				mCurY  += mCurH;				mCurCol = 0;			}			if (savFlag) {				mTextStr->addChar(mCurX, mCurY, mCurH, mCurCol, mFont, (char *)inStr);			}			mGraphics->DrawString(mCurX + mWindowOffset.h,								  mCurY + mWindowOffset.v,								  (savFlag) ? ((mCurtainFlag) ? CGB_CURTAIN : 0)								  			: CGB_STAGE,								  mFont->r, mFont->g, mFont->b, (char *)inStr);			mCurX   += mFont->x;			mCurCol += 2;		} else {			inc = (mCurCol % 2) ? ((mFont->x/2)+(mFont->x%2))								: (mFont->x/2);			if (mCurX + inc > mScreenPoint.h + mScreenSize.h) {				mCurX   = mIX;				mCurY  += mCurH;				mCurCol = 0;			}			if (savFlag) {				mTextStr->addChar(mCurX, mCurY, mCurH, mCurCol, mFont, (char *)inStr);			}			mGraphics->DrawString(mCurX + mWindowOffset.h,								  mCurY + mWindowOffset.v,								  (savFlag) ? ((mCurtainFlag) ? CGB_CURTAIN : 0)								  			: CGB_STAGE,								  mFont->r, mFont->g, mFont->b, (char *)inStr);			mCurX   += inc;			mCurCol++;		}	}}// ---------------------------------------------------------------------------------//		･ PutStr// ---------------------------------------------------------------------------------voidCSystem::PutStr(	char			*inStr){	unsigned char	*sp, *dp, cbuff[4];		for (sp = (unsigned char *)inStr, dp = cbuff; *sp != '\0'; sp++) {		if ((*sp >= 0x81 && *sp <=0x9F) || (*sp >= 0xE0 && *sp <= 0xFC)) {			cbuff[0] = *sp++;			cbuff[1] = *sp;			cbuff[2] = '\0';		} else {			cbuff[0] = *sp;			cbuff[1] = '\0';		}		PutChar(cbuff, true);	}}// ---------------------------------------------------------------------------------//		･ DispStrBuffer// ---------------------------------------------------------------------------------voidCSystem::DispStrBuffer(	int				inBufNo ){	char	*str;	int		x, y, h, c;	FONT	f;	FONT	savFont;		memcpy(&savFont, mFont, sizeof(FONT));	mTextStr->resetPos();	while (mTextStr->getChar(&x, &y, &h, &c, &f, &str)) {		if (*str != '\n') {			memcpy(mFont, &f, sizeof(FONT));			if (!inBufNo) {				mGraphics->DrawString(CSYS_OFFX(x),									  CSYS_OFFY(y),									  0,									  f.r, f.g, f.b, str);			} else {				mGraphics->DrawString(x,									  y,									  inBufNo,									  f.r, f.g, f.b, str);			}		}	}	memcpy(mFont, &savFont, sizeof(FONT));}/*************************************************************************************		選択枝表示制御***********************************************************************************/// ---------------------------------------------------------------------------------//		･ ClearSelectText// ---------------------------------------------------------------------------------intCSystem::ClearSelectText(void){	mSelectText = 0;	for (int i = 0; i < MAX_SELECT; i++) {		SetRect(&mSelectRect[i], 0, 0, 0, 0);	}	mSelectList   = -1;	return 0;}// ---------------------------------------------------------------------------------//		･ PrintSelectText// ---------------------------------------------------------------------------------voidCSystem::PrintSelectText(	char		*inStr){	int		x1, x2;	char	*p = inStr;		if (*p == '\n') {		PutChar((unsigned char *)"\n", true);		p++;	}	if ((mWakuPoint.h <= mCurX && mCurX <= mWakuPoint.h + mWakuSize.h - 1) &&		(mWakuPoint.v <= mCurY && mCurY <= mWakuPoint.v + mWakuSize.v - 1)) {		x1 = (mScreenPoint.h < mWakuPoint.h) ? mWakuPoint.h + 8 : mScreenPoint.h;		x2 = (mScreenPoint.h + mScreenSize.h - 1 > mWakuPoint.h + mWakuSize.h - 1) ? mWakuPoint.h + mWakuSize.h - 9																				   : mScreenPoint.h + mScreenSize.h - 1;	} else {		x1 = mScreenPoint.h;		x2 = mScreenPoint.h + mScreenSize.h - 1;	}	SetRect(&mSelectRect[mSelectText++],			x1,			mCurY,			x2,			mCurY + mFont->y - 1);	PutStr(p);}// ---------------------------------------------------------------------------------//		･ SaveSelectView// ---------------------------------------------------------------------------------voidCSystem::SaveSelectView(void){	// 非選択状態を保存	mGraphics->Copy(CSYS_OFFX(mScreenPoint.h),					CSYS_OFFY(mScreenPoint.v),					CSYS_OFFX(mScreenPoint.h + mScreenSize.h - 1),					CSYS_OFFY(mScreenPoint.v + mScreenSize.v - 1 + 18),					0,					mScreenPoint.h,					mScreenPoint.v,					CGB_MESWIN,					0);}// ---------------------------------------------------------------------------------//		･ DispSelectList// ---------------------------------------------------------------------------------voidCSystem::DispSelectList(	TagA		*inFirst ){	char	*cbuff = new char[256];//	if (mActiveText && !mFlagText) {		DispMesWin(CGB_STAGE);//	}	mSelectCount = mDNML->getSelectList(inFirst, mTagSelectList,												MAX_SELECT, mCARD);	for (int j = 0; j < mSelectCount; j++) {		if (j == 0) {			sprintf(cbuff, "%s", CSTR(mTagSelectList[j]->k_alt));		} else {			sprintf(cbuff, "\n%s", CSTR(mTagSelectList[j]->k_alt));		}		PrintSelectText(cbuff);	}	mInProgress = true;	mSelectSkip = false;	mTimeTEXT   = mCurTextTime;	SaveSelectView();	delete[] cbuff;}// ---------------------------------------------------------------------------------//		･ DispSelectLine// ---------------------------------------------------------------------------------voidCSystem::DispSelectLine(void){	// 非選択状態を表示領域に描画	mGraphics->Copy(mScreenPoint.h,					mScreenPoint.v,					mScreenPoint.h + mScreenSize.h - 1,					mScreenPoint.v + mScreenSize.v - 1 + 18,					CGB_MESWIN,					CSYS_OFFX(mScreenPoint.h),					CSYS_OFFY(mScreenPoint.v),					0,					0);	// 選択されている行を反転表示	mGraphics->MakeInvert(CSYS_OFFX(mSelectRect[mSelectList].left  ),						  CSYS_OFFY(mSelectRect[mSelectList].top   ),						  CSYS_OFFX(mSelectRect[mSelectList].right ),						  CSYS_OFFY(mSelectRect[mSelectList].bottom),						  0);}// ---------------------------------------------------------------------------------//		･ CheckSelectList// ---------------------------------------------------------------------------------BooleanCSystem::CheckSelectList(	int				inSel ){	Boolean		ret = true;		if (mTagSelectList[inSel]->k_enable) {		mCARD->setBuffer(CSTR(mTagSelectList[inSel]->k_enable));		if (!mCARD->yyparse()) {			if (!mCARD->resultVal) {				ret = false;			}		} else {			ret = false;		}	}	return ret;}// ---------------------------------------------------------------------------------//		･ DoSelectList// ---------------------------------------------------------------------------------voidCSystem::DoSelectList(	Boolean		inMouseFlag,	int			inX,	int			inY,	char		inChar ){	int			sel = -1;		if (mSelectText) {		mActiveIcon  = true;		if (inMouseFlag) {			if ((sel = GetSelFromMouse(inX, inY)) != -1) {				if (CheckSelectList(sel)) {					mSelectList = sel;					DispSelectLine();				}			}		} else {			if (inChar == kUpArrowCharCode) {				sel = (mSelectList == -1) ? GetSelectPrev(mSelectText) :											GetSelectPrev(mSelectList);			} else			if (inChar == kDownArrowCharCode) {				sel = (mSelectList == -1) ? GetSelectNext(-1) :											GetSelectNext(mSelectList);			}			if (sel != -1 && sel != mSelectList) {				mSelectList = sel;				DispSelectLine();			}		}	}}// ---------------------------------------------------------------------------------//		･ GetSelFromMouse// ---------------------------------------------------------------------------------intCSystem::GetSelFromMouse(	int			inMouseX,	int			inMouseY ){	int		sel;	for (sel = 0; sel < mSelectText; sel++) {		if ( (CSYS_OFFY(mSelectRect[sel].top ) <= inMouseY    &&			  inMouseY <= CSYS_OFFY(mSelectRect[sel].bottom)) &&			 (CSYS_OFFX(mSelectRect[sel].left) <= inMouseX    &&			  inMouseX <= CSYS_OFFX(mSelectRect[sel].right))) {			break;		}	}	return ((sel != mSelectText) && (sel != mSelectList)) ? sel : -1;}// ---------------------------------------------------------------------------------//		･ GetSelectPrev// ---------------------------------------------------------------------------------intCSystem::GetSelectPrev(	int			inSel ){	int			sel;	for (sel = inSel - 1; sel >= 0; sel--) {		if (CheckSelectList(sel)) {			break;		}	}	return (sel >= 0) ? sel : -1;}// ---------------------------------------------------------------------------------//		･ GetSelectNext// ---------------------------------------------------------------------------------intCSystem::GetSelectNext(	int			inSel ){	int			sel;	for (sel = inSel + 1; sel < mSelectText; sel++) {		if (CheckSelectList(sel)) {			break;		}	}	return (sel == mSelectText) ? -1 : sel;}/*************************************************************************************		汎用関数***********************************************************************************/// ---------------------------------------------------------------------------------//		･ Hex2Int// ---------------------------------------------------------------------------------intCSystem::Hex2Int(	char	*inStr ){	int		res = 0;	char	*sp;		for (sp = inStr; *sp != '\0'; sp++) {		res *= 16;		if ('0' <= *sp && *sp <= '9') {			res += (int)(*sp - '0');		} else		if ('A' <= *sp && *sp <= 'F') {			res += (int)(*sp - 'A' + 10);		} else		if ('a' <= *sp && *sp <= 'f') {			res += (int)(*sp - 'a' + 10);		} else {			res /= 16;			break;		}	}	return res;}// ---------------------------------------------------------------------------------//		･ Time2Long(ms)// ---------------------------------------------------------------------------------longCSystem::Time2Long(	char	*inStr ){	long	ret = 0, minutes = 0, seconds = 0, ticks = 0;	char	*sp, *dp;	char	*buff = new char[256];		// minutes	for (sp = inStr, dp = buff; *sp != '\0' && *sp != ':'; sp++, dp++) {		*dp = *sp;	}	*dp = '\0';	minutes = atol(buff);	// seconds	if (*sp) {		for (++sp, dp = buff; *sp != '\0' && *sp != ':'; sp++, dp++) {			*dp = *sp;		}		*dp = '\0';		seconds = atol(buff);	}	// ticks	if (*sp) {		for (++sp, dp = buff; *sp != '\0' && *sp != ':'; sp++, dp++) {			*dp = *sp;		}		*dp = '\0';		ticks = atol(buff);	}	delete[] buff;	return((minutes*60 + seconds) * 1000 + ticks * 100 / 6);}// ---------------------------------------------------------------------------------//		･ Position2Int// ---------------------------------------------------------------------------------intCSystem::Position2Int(	char	*inVal,	int		inStart,	int		inEnd,	int		inCur,	Boolean	inXDir ){	int			ret, svTag;	char		*buff = new char[128];	TagBasic	*btag;		if (*inVal == '+' || *inVal == '-') {		ret = atoi(inVal) + inCur;	} else	if (inVal[strlen(inVal)-1] == '%') {		memset(buff, '\0', 128);		memcpy(buff, inVal, strlen(inVal) - 1);		ret  = inStart + (inEnd - inStart + 1) * atoi(buff) / 100;		if (inXDir) {			svTag = mDNML->getCurrentTag();			btag  = mDNML->getNextScenario();			if (btag->getTagType() == DnmlParse::TEXT) {				StrText		*tag = (StrText*)btag;				int			len  = strlen(CSTR(tag->string_data));				ret -= (((len / 2) * mFont->x) + ((len % 2) * (mFont->x/2))) / 2;			}			mDNML->setCurrentTag(svTag);		} else {			ret -= mFont->y / 2;		}	} else {		ret = atoi(inVal);	}	if (ret < inStart) {		ret = inStart;	} else	if (ret > inEnd) {		ret = (inXDir) ? inEnd - mFont->x : inEnd - mFont->y;	}	delete[] buff;	return ret;}// ---------------------------------------------------------------------------------//		･ stricmp// ---------------------------------------------------------------------------------intCSystem::stricmp(	char	*inSrc,	char	*inDst ){	char	*sp, *src = new char[1024];	char	*dp, *dst = new char[1024];	int		ret;		// source to upper case	for (sp = inSrc, dp = src; *sp != '\0'; sp++, dp++) {		if ((*sp >= 0x81 && *sp <= 0x9F) ||			(*sp >= 0xE0 && *sp <= 0xFC)) {			*dp++ = *sp++;			*dp   = *sp;		} else {			*dp   = toupper(*sp);		}	}	*dp = '\0';		// destination to upper case	for (sp = inDst, dp = dst; *sp != '\0'; sp++, dp++) {		if (*sp & 0x80) {			*dp++ = *sp++;			*dp   = *sp;		} else {			*dp   = toupper(*sp);		}	}	*dp = '\0';	ret = strcmp(src, dst);	delete[] src;	delete[] dst;	return ret;}// ---------------------------------------------------------------------------------//		･ isdigits// ---------------------------------------------------------------------------------intCSystem::isdigits(	char			*inStr ){	char	*sp;	Boolean	digFlag = true;		for (sp = inStr; *sp != '\0'; sp++) {		if (*sp < '0' || '9' < *sp) {			digFlag = false;			break;		}	}	return (digFlag) ? atoi(inStr) : -1;}/*************************************************************************************		ＴＡＧ処理関数***********************************************************************************/// ---------------------------------------------------------------------------------//		･ DoA// ---------------------------------------------------------------------------------voidCSystem::DoA(	CGameWindow		*inWindow ){	if (!mInProgress) {		// 処理開始		TagA	*tag = (TagA*)mCurTag;		// パラメータの置換		string	*c_name   = GetNativeParam(tag->k_name,   true);		string	*c_href   = GetNativeParam(tag->k_href,   true);		string	*c_alt    = GetNativeParam(tag->k_alt,    true);		string	*c_answer = GetNativeParam(tag->k_answer, false);		string	*c_view   = GetNativeParam(tag->k_view,   false);		string	*c_enable = GetNativeParam(tag->k_enable, false);		if (!c_name) {			if (c_alt) {				if (strcmp(CSTR(c_alt), "")) {					// 選択枝表示					mSelectCount = ClearSelectText();					if (c_view) {						mCARD->parse(c_view, true);						if (mCARD->resultType == 0 && mCARD->resultVal > 0) {							DispSelectList(tag);						}					} else {						DispSelectList(tag);					}				} else				if (c_href) {					// 分岐					GotoHREF(CSTR(c_href));				}			} else {				if (c_href) {					// 分岐					Boolean		jmpFlag = true;					if (c_view) {						mCARD->parse(c_view, true);						if (mCARD->resultType == 0 && mCARD->resultVal > 0) {							if (c_answer) {								mCARD->parse(c_answer, false);							}						} else {							jmpFlag = false;						}					}					if (jmpFlag) {						GotoHREF(CSTR(c_href));					}				} else				if (c_answer) {					mCARD->parse(c_answer, false);					char	*p = nil;				}			}		}		// パラメータの後始末		if (c_name)		delete c_name;		if (c_href)		delete c_href;		if (c_alt)		delete c_alt;		if (c_answer)	delete c_answer;		if (c_view)		delete c_view;		if (c_enable)	delete c_enable;	} else {		// 処理中（基本的に選択枝関連）		if (mPushMouse) {			if (mSelectList != -1) {				// パラメータの置換				string	*c_href   = nil;				string	*c_answer = nil;				ClearTEXT();				DispCreate(CGB_STAGE, true);				mGraphics->Copy(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_STAGE,								(mCurtainFlag) ? 0 : CSYS_OFFX(0),								(mCurtainFlag) ? 0 : CSYS_OFFY(0),								(mCurtainFlag) ? CGB_CURTAIN : 0,								0);				if (mTagSelectList[mSelectList]->k_answer) {					c_answer = GetNativeParam(mTagSelectList[mSelectList]->k_answer, false);					mCARD->parse(c_answer, false);				}				if (mTagSelectList[mSelectList]->k_href) {					c_href   = GetNativeParam(mTagSelectList[mSelectList]->k_href, true);					GotoHREF(CSTR(c_href));				}				mInProgress  = false;				mPushMouse   = false;				mSelectList  = -1;				mSelectCount = ClearSelectText();				// パラメータの後始末				if (c_href)		delete c_href;				if (c_answer)	delete c_answer;			}		}	}}// ---------------------------------------------------------------------------------//		･ DoACT// ---------------------------------------------------------------------------------voidCSystem::DoACT(	CGameWindow		*inWindow ){	TagAct			*tag = (TagAct*)mCurTag;	Boolean			actFlag = true, waitMode = true;	char			*aName, fname[256];	EnterElement	*ee = nil;	int				mmsk = MASK_AUTO, mr = -1, mg = -1, mb = -1;	int				efct = EF_NONE;	Boolean			alphaFlag = false;	if (!mInProgress) {		// パラメータの置換		string	*c_name        = GetNativeParam(tag->k_name,        true);		string	*c_src         = GetNativeParam(tag->k_src,         true);		string	*c_folder      = GetNativeParam(tag->k_folder,      true);		string	*c_mode        = GetNativeParam(tag->k_mode,        true);		string	*c_top         = GetNativeParam(tag->k_top,         true);		string	*c_left        = GetNativeParam(tag->k_left,        true);		string	*c_width       = GetNativeParam(tag->k_width,       true);		string	*c_height      = GetNativeParam(tag->k_height,      true);		string	*c_effect      = GetNativeParam(tag->k_effect,      true);		string	*c_alpha       = GetNativeParam(tag->k_alpha,       true);		string	*c_subfolder   = GetNativeParam(tag->k_subfolder,   true);		string	*c_transparent = GetNativeParam(tag->k_transparent, true);		// check for ENTER		if (!c_name) {			goto exit_DoACT;		}		if ((ee = mEnter->getItem(aName = CSTR(c_name))) == nil) {			goto exit_DoACT;		}		efct = ee->getEffect();		// check TRANSPARENT		if (c_transparent) {			if (!stricmp(CSTR(c_transparent), "NONE")) {				mmsk = MASK_NONE;			} else			if (!stricmp(CSTR(c_transparent), "AUTO")) {				mmsk = MASK_AUTO;			} else {				mmsk = MASK_COLOR;				if (!GetParamColor(CSTR(c_transparent), &mr, &mg, &mb)) {					mr = mg = mb = 0;				}			}		}		// check ALPHA		char	alphaName[256];		if (c_alpha) {			if (isdigits(CSTR(c_alpha)) == -1) {				if (!c_subfolder) {					alphaFlag = GetParamFileName(c_folder, c_alpha, alphaName);				} else {					alphaFlag = GetParamFileName(c_subfolder, c_alpha, alphaName);				}				if (alphaFlag) {					mmsk = MASK_ALPHA;				}			}		}		// check SRC/FOLDER		if (!GetParamFileName(c_folder, c_src, fname)) {			goto exit_DoACT;		}		CGBuffer		*imageCGB;		mEnter->loadFile(aName, fname, mmsk, mr, mg, mb);		imageCGB = mGraphics->GetPDT(mEnter->getBufNo(aName));		unsigned char	*imageMsk = imageCGB->GetMaskBuffer();		int				alp;				if (c_alpha) {			int		imageX = imageCGB->GetSizeX();			int		imageY = imageCGB->GetSizeY();			if ((alp = isdigits(CSTR(c_alpha))) == -1) {				if (alphaFlag) {					mGraphics->LoadFile(alphaName, CGB_ENTERTM, MASK_NONE, -1, -1, -1);					CGBuffer		*alphaCGB = mGraphics->GetPDT(CGB_ENTERTM);					unsigned char	*alphaSrc = alphaCGB->GetBuffer();					int				alphaX = alphaCGB->GetSizeX();					int				alphaY = alphaCGB->GetSizeY();					int				alphaB = alphaCGB->GetBPP();					mGraphics->MakeMonochrome(0,											  0,											  alphaX - 1,											  alphaY - 1,											  CGB_ENTERTM);					int		maxX = (alphaX < imageX) ? alphaX													 : imageX;					int		maxY = (alphaY < imageY) ? alphaY													 : imageY;					for (int y = 0; y < maxY; y++) {						for (int x = 0; x < maxX; x++) {							*imageMsk++ = *alphaSrc;							alphaSrc += alphaB;						}					}				}			} else {				alp = (!alp) ? 0 : alp * 4 / 5 + 20;				for (int y = 0; y < imageY; y++) {					for (int x = 0; x < imageX; x++) {						*imageMsk = (unsigned char)((int)*imageMsk * alp / 100);						imageMsk++;					}				}			}		}		if (mSunglass) {			MakeSunglass(mEnter->getBufNo(aName));		}		// check EFFECT		if (c_effect) {			if ((efct = getEffectType(CSTR(c_effect))) == EF_BLACK_WIPE) {				efct = EF_BRUSH_FROM_LEFT;			}		}		// check MODE		if (c_mode) {			if (!stricmp(CSTR(c_mode), "PASS") ||				!stricmp(CSTR(c_mode), "GHOST")) {				waitMode = false;			}		}		if (waitMode) {			// 通常は一度メッセージウィンドウを消去する			EraseMesWin(false);		}		// 座標系の計算		int		x = -1, y = -1, w, h;		int		sx = mSpacePoint.h;		int		sy = mSpacePoint.v;		int		sw = mSpaceSize.h;		int		sh = mSpaceSize.v;		Boolean	stretchFlag = false;		GetParamWidthHeight(c_width, c_height, BASE_FILE, mEnter->getBufNo(aName), &w, &h);		if (w != mEnter->getSizeX(aName) || h != mEnter->getSizeY(aName)) {			stretchFlag = true;		}		if (stretchFlag) {			CGBuffer		*imgCGB = mGraphics->GetPDT(mEnter->getBufNo(aName));			CGBuffer		*strCGB = mGraphics->GetPDT(CGB_ENTER00);			delete strCGB;			strCGB = new CGBuffer(w, h, 3, w*3, true, 0);			unsigned char	*strBuf = strCGB->GetBuffer();			unsigned char	*strMsk = strCGB->GetMaskBuffer();			mGraphics->SetPDT(CGB_ENTER00, strCGB);			mGraphics->StretchCopyWideWithMask(0,											   0,											   imgCGB->GetSizeX() - 1,											   imgCGB->GetSizeY() - 1,											   imgCGB,											   0,											   0,											   w - 1,											   h - 1,											   CGB_ENTER00);			delete imgCGB;			mGraphics->SetPDT(mEnter->getBufNo(aName), strCGB);			mGraphics->SetPDT(CGB_ENTER00, nil);		}		if (c_left) {			if (tag->k_put) {				x = atoi(CSTR(c_left)) + mEnter->getPos(CSTR(tag->k_put))->h;			} else {				x = atoi(CSTR(c_left)) + mSpacePoint.h;			}		} else {			switch (mEnter->getAlign(aName)) {				case A_LEFT:		x = (sw - 2*w) / 4;			break;				case A_RIGHT:		x = (3*sw - 2*w) / 4;		break;				case A_LEFTSIDE:	x = 0;						break;				case A_RIGHTSIDE:	x = sw - w;					break;				case A_CENTER:				default:					x = (sw - w) / 2;					break;			}		}		if (c_top) {			if (tag->k_put) {				y = atoi(CSTR(c_top)) + mEnter->getPos(CSTR(tag->k_put))->v;			} else {				y = atoi(CSTR(c_top)) + mSpacePoint.v;			}		} else {			switch (mEnter->getVAlign(aName)) {				case A_TOP:			y = (sh - 2*h) / 4;			break;				case A_BOTTOM:		y = (3*sh - 2*h) / 4;		break;				case A_ROOF:		y = 0;						break;				case A_MIDDLE:		y = (sh - h) / 2;			break;				case A_FLOOR:				default:					y = sh - h;					break;			}		}		Point	*pt = mEnter->getPos(aName);		Rect	*rc = mEnter->getRect(aName);		pt->h      = x;		pt->v      = y;		rc->top    = 0;		rc->left   = 0;		rc->bottom = h - 1;		rc->right  = w - 1;				if (waitMode) {			// 全ての出演者を CGB_SPACE に格納する			mGraphics->FillRect(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_SPACE, 0, 0, 0);			CGBuffer		*cgb = mGraphics->GetPDT(CGB_SPACE);			unsigned char	*msk = cgb->GetMaskBuffer();			memset(msk, 0, cgb->GetSizeX() * cgb->GetSizeY());			for (int i = 1; i <= mEnter->getCount(); i++) {				EnterElement	*enter = mEnter->getItem(i);				if (enter) {					if (enter->getLoadFlag()) {						enter->resetCGBuffer();						mGraphics->CopyWithMask(enter->getRect()->left,												enter->getRect()->top,												enter->getRect()->right,												enter->getRect()->bottom,												enter->getBufNo(),												enter->getPos()->h,												enter->getPos()->v,												CGB_SPACE,												enter->getAlpha(),												0);					}				}			}			// 画像を合成する			DispCreate(CGB_STAGE, false);			// 効果付きで画像を表示			memset(mEffectSPACE, '\0', sizeof(EFFECT));			if (mPreset->charDisable || efct == EF_NONE) {				mGraphics->Copy(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_STAGE,								(mCurtainFlag) ? 0 : CSYS_OFFX(0),								(mCurtainFlag) ? 0 : CSYS_OFFY(0),								(mCurtainFlag) ? CGB_CURTAIN : 0,								0);			} else {				mEffectSPACE->cmd      = (mCurtainFlag) ? EF_NONE : efct;				mEffectSPACE->sx1      = 0;				mEffectSPACE->sy1      = 0;				mEffectSPACE->sx2      = mStageSize.h - 1;				mEffectSPACE->sy2      = mStageSize.v - 1;				mEffectSPACE->src      = CGB_STAGE;				mEffectSPACE->dx       = (mCurtainFlag) ? 0 : CSYS_OFFX(0);				mEffectSPACE->dy       = (mCurtainFlag) ? 0 : CSYS_OFFY(0);				mEffectSPACE->dst      = (mCurtainFlag) ? CGB_CURTAIN : 0;				mEffectSPACE->steptime = mTimeSPACE;				mEffectSPACE->prevtime = mGraphics->GetCurrentTimer();				mEffectSPACE->step     = 8;				mEffectSPACE->curcount = 0;				mInProgress = true;//				while (mEffectSPACE->cmd) {//					mGraphics->Effect(mSelectSkip, mEffectSPACE);//				}			}		}exit_DoACT:		// パラメータの後始末		if (c_name)			delete c_name;		if (c_src)			delete c_src;		if (c_folder)		delete c_folder;		if (c_mode)			delete c_mode;		if (c_top)			delete c_top;		if (c_left)			delete c_left;		if (c_width)		delete c_width;		if (c_height)		delete c_height;		if (c_effect)		delete c_effect;		if (c_alpha)		delete c_alpha;		if (c_subfolder)	delete c_subfolder;		if (c_transparent)	delete c_transparent;	} else {		if (!mEffectSPACE->cmd) {//			if (!mCurtainFlag && mWakuShut == SHUT_AUTO && mWakuFlag && mTextStr->getCharCount()) {//				DispMesWin(CGB_STAGE, mEDefaultSCREEN, (mScreenShut == SHUT_NONE) ? true : false);//				do {//					DoDisplayIdle();//				} while (BusyMesWin());//			}			mInProgress = false;		}	}}// -------------------------------------------------------------------------------------------------//	･ DoALIAS// -------------------------------------------------------------------------------------------------// 少ない関数呼び出しだけなので関数化しない。//void//CSystem::DoALIAS(//	CGameWindow		*inWindow )//{//	TagAlias	*tag = (TagAlias*)mCurTag;//	mAlias->addItem(CSTR(tag->k_src), CSTR(tag->k_dest));//}// -------------------------------------------------------------------------------------------------//	･ DoALIAS_E// -------------------------------------------------------------------------------------------------// 少ない関数呼び出しだけなので関数化しない。//void//CSystem::DoALIAS_E(//	CGameWindow		*inWindow )//{//	TagAlias	*tag = (TagAlias*)mCurTag;//	mAlias->delItem(CSTR(tag->k_src));//}// -------------------------------------------------------------------------------------------------//	･ DoB																	[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoB(	CGameWindow		*inWindow ){	int				fontSize;	FontInfo		finfo;		pushFont();	mFont->style |= bold;	fontSize      = mFont->x;	do {		FetchFontInfo(mFont->fontID, fontSize, mFont->style, &finfo);		fontSize--;	} while (finfo.ascent + finfo.descent > mFont->y ||			 finfo.widMax > mFont->x);	mFont->s       = fontSize;}// -------------------------------------------------------------------------------------------------//	･ DoB_E// -------------------------------------------------------------------------------------------------// 単一関数呼び出しだけなので関数化しない。//void//CSystem::DoB_E(//	CGameWindow		*inWindow )//{//	popFont();//}// ---------------------------------------------------------------------------------//		･ DoBACKGROUND// ---------------------------------------------------------------------------------voidCSystem::DoBACKGROUND(	CGameWindow		*inWindow ){	TagBackground	*tag = (TagBackground*)mCurTag;	char			fname[256];	int				r, g, b, iEff, step = 16;		if (!mInProgress) {		// パラメータの置換		string	*c_color       = GetNativeParam(tag->k_color,       true);		string	*c_src         = GetNativeParam(tag->k_src,         true);		string	*c_folder      = GetNativeParam(tag->k_folder,      true);		string	*c_top         = GetNativeParam(tag->k_top,         true);		string	*c_left        = GetNativeParam(tag->k_left,        true);		string	*c_width       = GetNativeParam(tag->k_width,       true);		string	*c_height      = GetNativeParam(tag->k_height,      true);		string	*c_transparent = GetNativeParam(tag->k_transparent, true);		string	*c_effect      = GetNativeParam(tag->k_effect,      true);		// 通常は一度メッセージウィンドウを消去する		EraseMesWin(false);		if (c_effect) {			iEff = mEDefaultCURTAIN = getEffectType(CSTR(c_effect));		} else {			iEff = getEffectType("EF_DEFAULT_BACK");		}		if (c_color) {			// カラー指定の場合			if (GetParamColor(CSTR(c_color), &r, &g, &b)) {				mGraphics->FillRect(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_BACKG, r, g, b);			}		} else {			// ファイル指定の場合			if (GetParamFileName(c_folder, c_src, fname)) {				int		mode;				int		t = 0, l = 0, w = mStageSize.h, h = mStageSize.v;				// 画像ファイルのロード				r = g = b = -1;				if (c_transparent) {					if (!stricmp(CSTR(c_transparent), "NONE")) {						mode = MASK_NONE;					} else					if (!stricmp(CSTR(c_transparent), "AUTO")) {						mode = MASK_AUTO;					} else {						if (!GetParamColor(CSTR(c_transparent), &r, &g, &b)) {							r = g = b = 0;						}						mode = MASK_COLOR;					}				} else {					mode = MASK_NONE;				}				mGraphics->LoadFile(fname, CGB_BACKG01, mode, r, g, b);				// 必要に応じて画像サイズ変更				GetParamWidthHeight(c_width, c_height, BASE_FILE, CGB_BACKG01, &w, &h);				CGBuffer	*imgCGB = mGraphics->GetPDT(CGB_BACKG01);				if (w != imgCGB->GetSizeX() || h != imgCGB->GetSizeY()) {					CGBuffer	*strCGB = mGraphics->GetPDT(CGB_BACKG00);					if (strCGB) 	delete strCGB;					strCGB = new CGBuffer(w, h, 3, w*3, true, 0);					mGraphics->SetPDT(CGB_BACKG00, strCGB);					mGraphics->StretchCopyWideWithMask(0, 0, imgCGB->GetSizeX() - 1, imgCGB->GetSizeY() - 1,													   imgCGB,													   0, 0, w - 1, h - 1,													   CGB_BACKG00);					delete imgCGB;					mGraphics->SetPDT(CGB_BACKG01, strCGB);					mGraphics->SetPDT(CGB_BACKG00, nil);				}								if (mSunglass) {		// サングラス対応					MakeSunglass(CGB_BACKG01);				}								// 画像バッファの初期化				mGraphics->FillRect(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_BACKG, 0, 0, 0);				CGBuffer		*cgb = mGraphics->GetPDT(CGB_BACKG);				unsigned char	*msk = cgb->GetMaskBuffer();				memset(msk, 0, cgb->GetSizeX() * cgb->GetSizeY());				// BACKG プレーンへの設定				if (c_top) {					t = atoi(CSTR(c_top));				}				if (c_left) {					l = atoi(CSTR(c_left));				}				mGraphics->CopyWithMask(0, 0, w - 1, h -1, CGB_BACKG01, l, t, CGB_BACKG, 0);			}		}		// 表示用に画面を合成		mGraphics->FillRect(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_SPACE, 0, 0, 0);		CGBuffer		*cgb = mGraphics->GetPDT(CGB_SPACE);		unsigned char	*msk = cgb->GetMaskBuffer();		memset(msk, 0, cgb->GetSizeX() * cgb->GetSizeY());//		for (int i = mEnter->getCount(); i > 0; i--) {		for (int i = 1; i <= mEnter->getCount(); i++) {			EnterElement	*enter = mEnter->getItem(i);			if (enter) {				if (enter->getLoadFlag()) {					mGraphics->CopyWithMask(enter->getRect()->left,											enter->getRect()->top,											enter->getRect()->right,											enter->getRect()->bottom,											enter->getBufNo(),											enter->getPos()->h,											enter->getPos()->v,											CGB_SPACE,											enter->getAlpha(),											0);					if (enter->isPutActive()) {						mGraphics->CopyWithMask(enter->getPutRect()->left,												enter->getPutRect()->top,												enter->getPutRect()->right,												enter->getPutRect()->bottom,												enter->getPutBufNo(),												enter->getPutPos()->h,												enter->getPutPos()->v,												CGB_SPACE,												enter->getAlpha(),												0);					}				}			}		}		DispCreate(CGB_STAGE, false);		if (!mWakuFlag && mTextStr->getCharCount()) {			DispStrBuffer(CGB_STAGE);		}		if (iEff == EF_BLACK_WIPE) {			iEff = EF_BRUSH_FROM_LEFT;			if (!mCurtainFlag) {				mGraphics->FillRect(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_HIDE, 0, 0, 0);				memset(mEffectBACKG, '\0', sizeof(EFFECT));				if (!mPreset->backDisable) {					mEffectBACKG->cmd      = EF_BRUSH_FROM_LEFT;					mEffectBACKG->sx1      = 0;					mEffectBACKG->sy1      = 0;					mEffectBACKG->sx2      = mStageSize.h - 1;					mEffectBACKG->sy2      = mStageSize.v - 1;					mEffectBACKG->src      = CGB_HIDE;					mEffectBACKG->dx       = (mCurtainFlag) ? 0 : CSYS_OFFX(0);					mEffectBACKG->dy       = (mCurtainFlag) ? 0 : CSYS_OFFY(0);					mEffectBACKG->dst      = (mCurtainFlag) ? CGB_CURTAIN : 0;					mEffectBACKG->steptime = mTimeBACKG;					mEffectBACKG->prevtime = mGraphics->GetCurrentTimer();					mEffectBACKG->step     = step = 16;					mEffectBACKG->curcount = 0;					while (mEffectBACKG->cmd) {						mGraphics->Effect(mSelectSkip, mEffectBACKG);					}				}			}		}		memset(mEffectBACKG, '\0', sizeof(EFFECT));		if (mPreset->backDisable || iEff == EF_NONE) {			mGraphics->Copy(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_STAGE,							(mCurtainFlag) ? 0 : CSYS_OFFX(0),							(mCurtainFlag) ? 0 : CSYS_OFFY(0),							(mCurtainFlag) ? CGB_CURTAIN : 0,							0);		} else {			mEffectBACKG->cmd      = (mCurtainFlag) ? EF_NONE : iEff;			mEffectBACKG->sx1      = 0;			mEffectBACKG->sy1      = 0;			mEffectBACKG->sx2      = mStageSize.h - 1;			mEffectBACKG->sy2      = mStageSize.v - 1;			mEffectBACKG->src      = CGB_STAGE;			mEffectBACKG->dx       = (mCurtainFlag) ? 0 : CSYS_OFFX(0);			mEffectBACKG->dy       = (mCurtainFlag) ? 0 : CSYS_OFFY(0);			mEffectBACKG->dst      = (mCurtainFlag) ? CGB_CURTAIN : 0;			mEffectBACKG->steptime = mTimeBACKG;			mEffectBACKG->prevtime = mGraphics->GetCurrentTimer();			mEffectBACKG->step     = step;			mEffectBACKG->curcount = 0;			mInProgress = true;//			while (mEffectBACKG->cmd) {//				mGraphics->Effect(mSelectSkip, mEffectBACKG);//			}		}		// パラメータの後始末		if (c_color)		delete c_color;		if (c_src)			delete c_src;		if (c_folder)		delete c_folder;		if (c_top)			delete c_top;		if (c_left)			delete c_left;		if (c_width)		delete c_width;		if (c_height)		delete c_height;		if (c_transparent)	delete c_transparent;		if (c_effect)		delete c_effect;	} else {		if (!mEffectBACKG->cmd) {//			if (!mCurtainFlag && mWakuShut == SHUT_AUTO && mWakuFlag && mTextStr->getCharCount()) {//				DispMesWin(CGB_STAGE, mEDefaultSCREEN, (mScreenShut == SHUT_NONE) ? true : false);//				do {//					DoDisplayIdle();//				} while (BusyMesWin());//			}			mInProgress = false;		}	}}// -------------------------------------------------------------------------------------------------//	･ DoBR																	[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoBR(	CGameWindow		*inWindow ){	if (!mSelectSkip) {		if (!mInProgress) {			mInProgress = true;			mActiveBR   = true;			mGraphics->UpdateScreen();			CSYS_COPYTO(CGB_BACKUP);		} else {			if (mPushMouse) {				CSYS_COPYFROM(CGB_BACKUP);				mInProgress = false;				mActiveBR   = false;				mPushMouse  = false;				PutChar((unsigned char *)"\n", true);			}		}	} else {		mInProgress = false;		mPushMouse  = false;		PutChar((unsigned char *)"\n", true);	}}// -------------------------------------------------------------------------------------------------//	･ DoCARD																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoCARD(	CGameWindow		*inWindow ){	TagCard			*tag = (TagCard*)mCurTag;	// パラメータの置換	string	*c_name  = GetNativeParam(tag->k_name,  true);	string	*c_value = GetNativeParam(tag->k_value, true);	if (c_name && c_value) {		mCARD->cardList->addCard(CSTR(c_name));		mCARD->cardList->setCardStr(CSTR(c_name), CSTR(c_value));	}	// パラメータの後始末	if (c_name)		delete c_name;	if (c_value)	delete c_value;}// -------------------------------------------------------------------------------------------------//	･ DoCLIP// -------------------------------------------------------------------------------------------------// 単一関数呼び出しだけなので関数化しない。//void//CSystem::DoCLIP(//	CGameWindow		*inWindow )//{//	pushClip();//}// -------------------------------------------------------------------------------------------------//	･ DoCLIP_E// -------------------------------------------------------------------------------------------------// 単一関数呼び出しだけなので関数化しない。//void//CSystem::DoCLIP_E(//	CGameWindow		*inWindow )//{//	popClip();//}// -------------------------------------------------------------------------------------------------//	･ DoCURTAIN																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoCURTAIN(	CGameWindow		*inWindow ){	mGraphics->UpdateScreen();	CSYS_COPYTO(CGB_CURTAIN);	mCurtainFlag = true;}// -------------------------------------------------------------------------------------------------//	･ DoCURTAIN_E															[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoCURTAIN_E(	CGameWindow		*inWindow ){	if (!mInProgress) {		TagECurtain		*tag = (TagECurtain*)mCurTag;		int				ef   = getEffectType("EF_DEFAULT_BACK"), step = 16;				// パラメータの置換		string	*c_effect = GetNativeParam(tag->k_effect, true);		string	*c_wait   = GetNativeParam(tag->k_wait,   true);		if (c_effect) {			ef = getEffectType(CSTR(c_effect));		}		mTimeCURTAIN = (c_wait) ? atoi(CSTR(c_wait)) : mTimeBACKG;		if (mTimeCURTAIN > 100) {			mTimeCURTAIN = 100;		}				if (ef == EF_BLACK_WIPE) {			ef = EF_BRUSH_FROM_LEFT;			mGraphics->FillRect(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_HIDE, 0, 0, 0);			memset(mEffectCURTAIN, '\0', sizeof(EFFECT));			if (mPreset->backDisable) {				mGraphics->Copy(0,								0,								mStageSize.h - 1,								mStageSize.v - 1,								CGB_HIDE,								CSYS_OFFX(0),								CSYS_OFFY(0),								0,								0);			} else {				mEffectCURTAIN->cmd      = EF_BRUSH_FROM_LEFT;				mEffectCURTAIN->sx1      = 0;				mEffectCURTAIN->sy1      = 0;				mEffectCURTAIN->sx2      = mStageSize.h - 1;				mEffectCURTAIN->sy2      = mStageSize.v - 1;				mEffectCURTAIN->src      = CGB_HIDE;				mEffectCURTAIN->dx       = CSYS_OFFX(0);				mEffectCURTAIN->dy       = CSYS_OFFY(0);				mEffectCURTAIN->dst      = 0;				mEffectCURTAIN->steptime = mTimeCURTAIN;				mEffectCURTAIN->prevtime = mGraphics->GetCurrentTimer();				mEffectCURTAIN->step     = step = 16;				mEffectCURTAIN->curcount = 0;				while (mEffectCURTAIN->cmd) {					mGraphics->Effect(mSelectSkip, mEffectCURTAIN);				}			}		}				memset(mEffectCURTAIN, '\0', sizeof(EFFECT));		if (mPreset->backDisable) {			mGraphics->Copy(0,							0,							mStageSize.h - 1,							mStageSize.v - 1,							CGB_CURTAIN,							CSYS_OFFX(0),							CSYS_OFFY(0),							0,							0);		} else {			mEffectCURTAIN->cmd = ef;			mEffectCURTAIN->sx1 = 0;			mEffectCURTAIN->sy1 = 0;			mEffectCURTAIN->sx2 = mStageSize.h - 1;			mEffectCURTAIN->sy2 = mStageSize.v - 1;			mEffectCURTAIN->src = CGB_CURTAIN;			mEffectCURTAIN->dx  = CSYS_OFFX(0);			mEffectCURTAIN->dy  = CSYS_OFFY(0);			mEffectCURTAIN->dst = 0;			mEffectCURTAIN->steptime = mTimeCURTAIN;			mEffectCURTAIN->prevtime = mGraphics->GetCurrentTimer();			mEffectCURTAIN->step     = step;			mEffectCURTAIN->curcount = 0;			mInProgress = true;		}		// パラメータの後始末		if (c_effect)		delete c_effect;		if (c_wait)			delete c_wait;	} else {		if (!mEffectCURTAIN->cmd) {			mCurtainFlag = false;//			if (mActiveText && !mFlagText && mWakuFlag && mTextStr->getCharCount()) {//				DispMesWin(CGB_STAGE, mEDefaultSCREEN, (mScreenShut == SHUT_NONE) ? true : false);//				do {//					DoDisplayIdle();//				} while (BusyMesWin());//			}			mInProgress  = false;		}	}}// -------------------------------------------------------------------------------------------------//	･ DoEND																	[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoEND(	CGameWindow		*inWindow ){	TagEnd	*tag = (TagEnd*)mCurTag;	short	itemHit;	char	msgBuff[256];		// パラメータの置換	string	*c_alt  = GetNativeParam(tag->k_alt,  true);	string	*c_mode = GetNativeParam(tag->k_mode, true);	if (c_alt) {		strcpy(msgBuff, CSTR(c_alt));	} else {		strcpy(msgBuff, "おしまい");	}	C2PStr(msgBuff);	SysBeep(1);	StandardAlert( kAlertNoteAlert, (unsigned char*)msgBuff, nil, nil, &itemHit );	mGraphics->FillRect(0, 0, mWindowSize.h - 1, mWindowSize.v - 1, 0, 0, 0, 0);	mGraphics->UpdateScreen();	while (1) {		if (!mDNML->getNextScenario()) {			if (!mStackDNML->pop(&mDNML)) {				break;			}		}	}	inWindow->SetDescriptor("\pDNML for Macintosh");	if (c_mode) {		if (!stricmp(CSTR(c_mode), "TOP")) {			delete mDNML;			mDNML = new dnmlparse(mTopFile);			mDNML->yyparse();			// 本当はカードやエイリアス環境もクリアした方が良い？？？		}	}		// パラメータの後始末	if (c_alt)			delete c_alt;	if (c_mode)			delete c_mode;}// -------------------------------------------------------------------------------------------------//	･ DoENTER																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoENTER(	CGameWindow		*inWindow ){	TagEnter		*tag = (TagEnter*)mCurTag;	char			*ename, *hal, *val;	int				iHal, iVal, iEff, iAlp;		// パラメータの置換	string	*c_name   = GetNativeParam(tag->k_name,   true);	string	*c_align  = GetNativeParam(tag->k_align,  true);	string	*c_valign = GetNativeParam(tag->k_valign, true);	string	*c_effect = GetNativeParam(tag->k_effect, true);	string	*c_alpha  = GetNativeParam(tag->k_alpha,  true);	if (c_name) {		ename = CSTR(c_name);		if (c_align) {			hal = CSTR(c_align);			if (!stricmp(hal, "LEFT")) {				iHal = A_LEFT;			} else			if (!stricmp(hal, "RIGHT")) {				iHal = A_RIGHT;			} else			if (!stricmp(hal, "CENTER")) {				iHal = A_CENTER;			} else			if (!stricmp(hal, "LEFTSIDE")) {				iHal = A_LEFTSIDE;			} else			if (!stricmp(hal, "RIGHTSIDE")) {				iHal = A_RIGHTSIDE;			} else {				iHal = A_CENTER;			}		} else {			iHal = A_CENTER;		}		if (c_valign) {			val = CSTR(c_valign);			if (!stricmp(val, "TOP")) {				iVal = A_TOP;			} else			if (!stricmp(val, "BOTTOM")) {				iVal = A_BOTTOM;			} else			if (!stricmp(val, "MIDDLE")) {				iVal = A_MIDDLE;			} else			if (!stricmp(val, "ROOF")) {				iVal = A_ROOF;			} else			if (!stricmp(val, "FLOOR")) {				iVal = A_FLOOR;			} else {				iVal = A_FLOOR;			}		} else {			iVal = A_FLOOR;		}		if (c_effect) {			if ((iEff = getEffectType(CSTR(c_effect))) == EF_BLACK_WIPE) {				iEff = EF_BRUSH_FROM_LEFT;			}		} else {			iEff = getEffectType("EF_DEFAULT_CHAR");		}		if (c_alpha) {			if ((iAlp = atoi((char *)CSTR(c_alpha))) > 100) {				iAlp = 100;			} else			if (iAlp < 0) {				iAlp = 0;			}		} else {			iAlp = 100;		}		mEnter->addItem(ename, iHal, iVal, iEff, iAlp, mStageSize.h, mStageSize.v);	}	// パラメータの後始末	if (c_name)			delete c_name;	if (c_align)		delete c_align;	if (c_valign)		delete c_valign;	if (c_effect)		delete c_effect;	if (c_alpha)		delete c_alpha;}// -------------------------------------------------------------------------------------------------//	･ DoEVENT																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoEVENT(	CGameWindow		*inWindow ){	TagEvent		*tag = (TagEvent*)mCurTag;		// パラメータの置換	string	*c_answer = GetNativeParam(tag->k_answer, false);	if (c_answer) {		mCARD->parse(c_answer, true);		if (mCARD->resultType == 0 && mCARD->resultVal <= 0) {			mDNML->skipEvent();		}	} else {		mDNML->skipEvent();	}	// パラメータの後始末	if (c_answer)		delete c_answer;}// -------------------------------------------------------------------------------------------------//	･ DoEXIT																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoEXIT(	CGameWindow		*inWindow ){	TagExit			*tag = (TagExit*)mCurTag;	Boolean			waitFlag = true;	int				efct     = getEffectType("EF_DEFAULT_CHAR");	if (!inWindow) {		if (mEnter) {			delete mEnter;		}		mEnter = new CEnter(mGraphics);		return;	}	if (!mInProgress) {		// パラメータの置換		string	*c_name   = GetNativeParam(tag->k_name,   false);		string	*c_effect = GetNativeParam(tag->k_effect, false);		string	*c_mode   = GetNativeParam(tag->k_mode,   false);				if (c_mode) {			if (!stricmp(CSTR(c_mode), "PASS") ||				!stricmp(CSTR(c_mode), "GHOST")) {				waitFlag = false;			}		}		if (waitFlag) {			// 通常は一度メッセージウィンドウを消去する			EraseMesWin(false);		}		if (c_name) {			if (!stricmp(CSTR(c_name), "ALL")) {				if (mEnter) {					delete mEnter;				}				mEnter = new CEnter(mGraphics);			} else {				efct = mEnter->getEffect(CSTR(c_name));				mEnter->delItem(CSTR(c_name));			}		} else {			EnterElement	*ee;			for (int i = 1; i <= mEnter->getCount(); i++) {				ee = mEnter->getItem(i);				efct = ee->getEffect();			}			if (mEnter) {				delete mEnter;			}			mEnter = new CEnter(mGraphics);		}		if (c_effect) {			if ((efct = getEffectType(CSTR(c_effect))) == EF_BLACK_WIPE) {				efct = EF_BRUSH_FROM_LEFT;			}		}		if (waitFlag) {			// 残り全ての出演者を CGB_SPACE に格納する			mGraphics->FillRect(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_SPACE, 0, 0, 0);			CGBuffer		*cgb = mGraphics->GetPDT(CGB_SPACE);			unsigned char	*msk = cgb->GetMaskBuffer();			memset(msk, 0, cgb->GetSizeX() * cgb->GetSizeY());//			for (int i = mEnter->getCount(); i > 0; i--) {			for (int i = 1; i <= mEnter->getCount(); i++) {				EnterElement	*enter = mEnter->getItem(i);				if (enter) {					if (enter->getLoadFlag()) {						mGraphics->CopyWithMask(enter->getRect()->left,												enter->getRect()->top,												enter->getRect()->right,												enter->getRect()->bottom,												enter->getBufNo(),												enter->getPos()->h,												enter->getPos()->v,												CGB_SPACE,												enter->getAlpha(),												0);						if (enter->isPutActive()) {							mGraphics->CopyWithMask(enter->getPutRect()->left,													enter->getPutRect()->top,													enter->getPutRect()->right,													enter->getPutRect()->bottom,													enter->getPutBufNo(),													enter->getPutPos()->h,													enter->getPutPos()->v,													CGB_SPACE,													enter->getAlpha(),													0);						}					}				}			}			DispCreate(CGB_STAGE, false);			// 効果付きで画像を表示			memset(mEffectSPACE, '\0', sizeof(EFFECT));			if (mPreset->charDisable || efct == EF_NONE) {				mGraphics->Copy(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_STAGE,								(mCurtainFlag) ? 0 : CSYS_OFFX(0),								(mCurtainFlag) ? 0 : CSYS_OFFY(0),								(mCurtainFlag) ? CGB_CURTAIN : 0,								0);			} else {				mEffectSPACE->cmd      = (mCurtainFlag) ? EF_NONE : efct;				mEffectSPACE->sx1      = 0;				mEffectSPACE->sy1      = 0;				mEffectSPACE->sx2      = mStageSize.h - 1;				mEffectSPACE->sy2      = mStageSize.v - 1;				mEffectSPACE->src      = CGB_STAGE;				mEffectSPACE->dx       = (mCurtainFlag) ? 0 : CSYS_OFFX(0);				mEffectSPACE->dy       = (mCurtainFlag) ? 0 : CSYS_OFFY(0);				mEffectSPACE->dst      = (mCurtainFlag) ? CGB_CURTAIN : 0;				mEffectSPACE->steptime = mTimeSPACE;				mEffectSPACE->prevtime = mGraphics->GetCurrentTimer();				mEffectSPACE->step     = 8;				mEffectSPACE->curcount = 0;				mInProgress = true;//				while (mEffectSPACE->cmd) {//					mGraphics->Effect(mSelectSkip, mEffectSPACE);//				}			}		}		// パラメータの後始末		if (c_name)		delete c_name;		if (c_effect)	delete c_effect;		if (c_mode)		delete c_mode;	} else {		if (!mEffectSPACE->cmd) {//			if (!mCurtainFlag && mWakuShut == SHUT_AUTO && mTextStr->getCharCount()) {//				DispMesWin(CGB_STAGE, mEDefaultSCREEN, (mScreenShut == SHUT_NONE) ? true : false);//				do {//					DoDisplayIdle();//				} while (BusyMesWin());//			}			mInProgress = false;		}	}}// -------------------------------------------------------------------------------------------------//	･ DoFONT																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoFONT(	CGameWindow		*inWindow ){	TagFont			*tag = (TagFont*)mCurTag;	short			fid = 0;	int				fontSize;	FontInfo		finfo;		// パラメータの置換	string	*c_face   = GetNativeParam(tag->k_face,   true);	string	*c_height = GetNativeParam(tag->k_height, true);	string	*c_skip   = GetNativeParam(tag->k_skip,   true);	string	*c_color  = GetNativeParam(tag->k_color,  true);	string	*c_size   = GetNativeParam(tag->k_size,   true);	pushFont();	if (c_face) {		if (!stricmp(CSTR(c_face), "USER")) {			mFont->fontID = 16436;		} else {			char		fstr[256];			strcpy(fstr, CSTR(c_face));			C2PStr(fstr);			GetFNum((unsigned char *)fstr, &fid);			mFont->fontID = (fid) ? (int)fid : 16436;		}	}	if (c_height) {		if (!stricmp(CSTR(c_height), "USER")) {//			mFont->x = 27 - 1;			mFont->x = 27;		} else {			mFont->x = atol(CSTR(c_height)) - 1;//			mFont->x = atol(CSTR(c_height));		}	}	if (c_skip) {		if (!stricmp(CSTR(c_skip), "USER")) {			mFont->y = 30;		} else {			mFont->y = atol(CSTR(c_skip));		}	}	if (c_color) {		if (!stricmp(CSTR(c_color), "USER")) {			mFont->r = 0xff;			mFont->g = 0xff;			mFont->b = 0xff;		} else {			GetParamColor(CSTR(c_color), &mFont->r, &mFont->g, &mFont->b);		}	}	if (c_size) {		mFont->x += atol(CSTR(c_size));	}	fontSize = mFont->x;	do {		FetchFontInfo(mFont->fontID, fontSize, mFont->style, &finfo);		fontSize--;	} while (finfo.ascent + finfo.descent > mFont->y ||			 finfo.widMax > mFont->x);	mFont->s = fontSize;	mCurH    = mFont->y;	// パラメータの後始末	if (c_face)		delete c_face;	if (c_height)	delete c_height;	if (c_skip)		delete c_skip;	if (c_color)	delete c_color;	if (c_size)		delete c_size;}// -------------------------------------------------------------------------------------------------//	･ DoFONT_E// -------------------------------------------------------------------------------------------------// 単一関数呼び出しだけなので関数化しない。//void//CSystem::DoFONT_E(//	CGameWindow		*inWindow )//{//	popFont();//}// -------------------------------------------------------------------------------------------------//	･ DoI																	[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoI(	CGameWindow		*inWindow ){	int				fontSize;	FontInfo		finfo;		pushFont();	mFont->style |= italic;	fontSize      = mFont->x;	do {		FetchFontInfo(mFont->fontID, fontSize, mFont->style, &finfo);		fontSize--;	} while (finfo.ascent + finfo.descent > mFont->y ||			 finfo.widMax > mFont->x);	mFont->s = fontSize;}// -------------------------------------------------------------------------------------------------//	･ DoI_E// -------------------------------------------------------------------------------------------------// 単一関数呼び出しだけなので関数化しない。//void//CSystem::DoI_E(//	CGameWindow		*inWindow )//{//	popFont();//}// -------------------------------------------------------------------------------------------------//	･ DoICON																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoICON(	CGameWindow		*inWindow ){	TagIcon			*tag = (TagIcon*)mCurTag;	int				time = -1, x = -1, y = -1;	char			fname[256];	// パラメータの置換	string	*c_src    = GetNativeParam(tag->k_src,    true);	string	*c_folder = GetNativeParam(tag->k_folder, true);	string	*c_time   = GetNativeParam(tag->k_time,   true);	string	*c_top    = GetNativeParam(tag->k_top,    true);	string	*c_left   = GetNativeParam(tag->k_left,   true);	string	*c_mode   = GetNativeParam(tag->k_mode,   true);	if (GetParamFileName(c_folder, c_src, fname)) {		if (c_time) {			time = atoi(CSTR(c_time));		}		if (c_top) {			y = atoi(CSTR(c_top));		}		if (c_left) {			x = atoi(CSTR(c_left));		}		if (c_mode) {			if (!stricmp(CSTR(c_mode), "BR")) {				mGraphics->LoadBIcon(fname, x, y, time);			} else			if (!stricmp(CSTR(c_mode), "P")) {				mGraphics->LoadPIcon(fname, x, y, time);			}		}	}	mActiveIcon = true;		// パラメータの後始末	if (c_src)		delete c_src;	if (c_folder)	delete c_folder;	if (c_time)		delete c_time;	if (c_top)		delete c_top;	if (c_left)		delete c_left;	if (c_mode)		delete c_mode;}// -------------------------------------------------------------------------------------------------//	･ DoICON_E																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoICON_E(	CGameWindow		*inWindow ){	TagEIcon		*tag = (TagEIcon*)mCurTag;	// パラメータの置換	string	*c_mode = GetNativeParam(tag->k_mode, true);	if (c_mode) {		if (!stricmp(CSTR(c_mode), "BR")) {			mGraphics->DeleteBIcon();		} else		if (!stricmp(CSTR(c_mode), "P")) {			mGraphics->DeletePIcon();		}	}	mActiveIcon = false;	// パラメータの後始末	if (c_mode)		delete c_mode;}// -------------------------------------------------------------------------------------------------//	･ DoINDENT// -------------------------------------------------------------------------------------------------// 単一関数呼び出しだけなので関数化しない。//void//CSystem::DoINDENT(//	CGameWindow		*inWindow )//{//	pushIndent();//}// -------------------------------------------------------------------------------------------------//	･ DoINDENT_E// -------------------------------------------------------------------------------------------------// 単一関数呼び出しだけなので関数化しない。//void//CSystem::DoINDENT_E(//	CGameWindow		*inWindow )//{//	popIndent();//}// -------------------------------------------------------------------------------------------------//	･ DoKICK																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoKICK(	CGameWindow		*inWindow ){	TagKick			*tag = (TagKick*)mCurTag;	if (!mInProgress) {		// パラメータの置換		string	*c_width = GetNativeParam(tag->k_width, true);		string	*c_time  = GetNativeParam(tag->k_time,  true);		string	*c_loop  = GetNativeParam(tag->k_loop,  true);		if (c_width) {			mKickWidth = atoi(CSTR(c_width));		} else {			mKickWidth = 40;		}		if (c_time) {			mKickTime = atoi(CSTR(c_time)) / 4;		} else {			mKickTime = 50;		}		if (c_loop) {			mKickLoop = atoi(CSTR(c_loop));		} else {			mKickLoop = 2;		}		mKickDirection = 0;		mInProgress    = true;		mGraphics->UpdateScreen();		CSYS_COPYTO(CGB_BACKUP);		mGraphics->ResetTimer();		// パラメータの後始末		if (c_width)		delete c_width;		if (c_time)			delete c_time;		if (c_loop)			delete c_loop;	} else {		if (!mKickLoop) {			mInProgress = false;			CSYS_COPYFROM(CGB_BACKUP);		}	}}// -------------------------------------------------------------------------------------------------//	･ DoMEMO																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoMEMO(	CGameWindow		*inWindow ){	TagMemo				*tag = (TagMemo*)mCurTag;	FILE				*fp;	char				fname[256], cname[128];	struct	BOOK		book;	struct	BOOKMARK	bookMark;		// パラメータの置換	string	*c_src  = GetNativeParam(tag->k_src,  true);	string	*c_dest = GetNativeParam(tag->k_dest, true);	if (c_src && c_dest) {		if (!stricmp(CSTR(c_src), "CLEAR")) {			if (!stricmp(CSTR(c_dest), "BOOK")) {				sprintf(fname, "%sBOOK", mDNML->playerFolder);			} else			if (!stricmp(CSTR(c_dest), "BOOKMARK")) {				sprintf(fname, "%sBOOKMARK", mDNML->playerFolder);			} else {				strcpy(fname, "");			}			if (*fname) {				mDNML->convertNative(fname);				fp = fopen(fname, "wb");				fclose(fp);			}		} else		if (!stricmp(CSTR(c_src), "BOOK")) {			strcpy(cname, CSTR(c_dest));			sprintf(fname, "%sBOOK", mDNML->playerFolder);			mDNML->convertNative(fname);			if ((fp = fopen(fname, "rb")) != NULL) {				while (fread(&book, 1, sizeof(struct BOOK), fp)) {					if (!strcmp(cname, book.card)) {						mCARD->cardList->addCard(cname);						mCARD->cardList->setCardVal(cname, book.lval);						mCARD->cardList->setCardStr(cname, book.sval);						break;					}				}				fclose(fp);			}		} else		if (!stricmp(CSTR(c_src), "BOOKMARK")) {			strcpy(cname, CSTR(c_dest));			sprintf(fname, "%sBOOKMARK", mDNML->playerFolder);			mDNML->convertNative(fname);			if ((fp = fopen(fname, "rb")) != NULL) {				while (fread(&bookMark, 1, sizeof(struct BOOKMARK), fp)) {					if (!strcmp(mTitle, bookMark.title) && !strcmp(cname, bookMark.book.card)) {						mCARD->cardList->addCard(cname);						mCARD->cardList->setCardVal(cname, bookMark.book.lval);						mCARD->cardList->setCardStr(cname, bookMark.book.sval);						break;					}				}				fclose(fp);			}		} else {			strcpy(cname, CSTR(c_src));			if (mCARD->cardList->existCard(cname)) {				if (!stricmp(CSTR(c_dest), "BOOK")) {					struct	BOOK		bk;					memset(&bk, '\0', sizeof(struct BOOK));					strcpy(bk.card, cname);					bk.lval = mCARD->cardList->getCardVal(cname);					strcpy(bk.sval, mCARD->cardList->getCardStr(cname));					sprintf(fname, "%sBOOK", mDNML->playerFolder);					mDNML->convertNative(fname);					if ((fp = fopen(fname, "rb+")) == NULL) {						fp = fopen(fname, "ab+");					}					if (fp != NULL) {						Boolean		update = false;						fseek(fp, 0, SEEK_SET);						while (fread(&book, 1, sizeof(struct BOOK), fp)) {							if (!strcmp(cname, book.card)) {								fseek(fp, -sizeof(struct BOOK), SEEK_CUR);								fwrite(&bk, sizeof(struct BOOK), 1, fp);								update = true;								break;							}						}						if (!update) {							fseek(fp, 0, SEEK_END);							fwrite(&bk, sizeof(struct BOOK), 1, fp);						}						fclose(fp);					}				} else				if (!stricmp(CSTR(c_dest), "BOOKMARK")) {					struct	BOOKMARK	bk;					memset(&bk, '\0', sizeof(struct BOOKMARK));					strcpy(bk.title, mTitle);					strcpy(bk.book.card, cname);					bk.book.lval = mCARD->cardList->getCardVal(cname);					strcpy(bk.book.sval, mCARD->cardList->getCardStr(cname));					sprintf(fname, "%sBOOKMARK", mDNML->playerFolder);					mDNML->convertNative(fname);					if ((fp = fopen(fname, "rb+")) == NULL) {						fp = fopen(fname, "ab+");					}					if (fp != NULL) {						Boolean		update = false;						fseek(fp, 0, SEEK_SET);						while (fread(&bookMark, 1, sizeof(struct BOOKMARK), fp)) {							if (!strcmp(cname, bookMark.book.card)) {								fseek(fp, -sizeof(struct BOOKMARK), SEEK_CUR);								fwrite(&bk, sizeof(struct BOOKMARK), 1, fp);								update = true;								break;							}						}						if (!update) {							fseek(fp, 0, SEEK_END);							fwrite(&bk, sizeof(struct BOOKMARK), 1, fp);						}						fclose(fp);					}				}			}		}	}	// パラメータの後始末	if (c_src)		delete c_src;	if (c_dest)		delete c_dest;}// -------------------------------------------------------------------------------------------------//	･ DoNL// -------------------------------------------------------------------------------------------------// 単一関数呼び出しだけなので関数化しない。//void//CSystem::DoNL(//	CGameWindow		*inWindow )//{//	PutChar("\n", true);//}// -------------------------------------------------------------------------------------------------//	･ DoNP// -------------------------------------------------------------------------------------------------// 単一関数呼び出しだけなので関数化しない。//void//CSystem::DoNP(//	CGameWindow		*inWindow )//{//	ClearTEXT();//}// -------------------------------------------------------------------------------------------------//	･ DoP																	[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoP(	CGameWindow		*inWindow ){	if (!mSelectSkip) {		if (!mInProgress) {			mInProgress = true;			mActiveP    = true;//			mGraphics->UpdateScreen();			CSYS_COPYTO(CGB_BACKUP);		} else {			if (mPushMouse) {//				CSYS_COPYFROM(CGB_BACKUP);				ClearTEXT();				mInProgress = false;				mActiveP    = false;				mPushMouse  = false;				DispCreate(CGB_STAGE, true);				mGraphics->Copy(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_STAGE,								(mCurtainFlag) ? 0 : CSYS_OFFX(0),								(mCurtainFlag) ? 0 : CSYS_OFFY(0),								(mCurtainFlag) ? CGB_CURTAIN : 0,								0);			}		}	} else {		ClearTEXT();		mInProgress = false;		mActiveP    = false;		mPushMouse  = false;		DispCreate(CGB_STAGE, true);		mGraphics->Copy(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_STAGE,						(mCurtainFlag) ? 0 : CSYS_OFFX(0),						(mCurtainFlag) ? 0 : CSYS_OFFY(0),						(mCurtainFlag) ? CGB_CURTAIN : 0,						0);	}}// -------------------------------------------------------------------------------------------------//	･ DoPOSITION															[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoPOSITION(	CGameWindow		*inWindow ){	TagPosition		*tag = (TagPosition*)mCurTag;	// パラメータの置換	string	*c_top  = GetNativeParam(tag->k_top,  true);	string	*c_left = GetNativeParam(tag->k_left, true);	string	*c_name = GetNativeParam(tag->k_name, true);	int		base_no = BASE_SCREEN;	if (c_name) {		if (!stricmp(CSTR(c_name), "SPACE")) {			base_no = BASE_SPACE;		} else		if (!stricmp(CSTR(c_name), "SCREEN")) {			base_no = BASE_SCREEN;		} else {			base_no = BASE_STAGE;		}	}	GetParamLeftTop(c_left, c_top, base_no, -1, &mCurX, &mCurY);	// パラメータの後始末	if (c_top)		delete c_top;	if (c_left)		delete c_left;	if (c_name)		delete c_name;}// -------------------------------------------------------------------------------------------------//	･ DoQUESTION															[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoQUESTION(	CGameWindow		*inWindow ){	TagQuestion		*tag = (TagQuestion*)mCurTag;	// パラメータの置換	string	*c_answer = GetNativeParam(tag->k_answer, false);	string	*c_href   = GetNativeParam(tag->k_href,   true);	if (c_answer) {		mCARD->parse(c_answer, true);		if (mCARD->resultType == 0 && mCARD->resultVal > 0) {			if (c_href) {				if (*(CSTR(c_href)) != '\0') {					GotoHREF(CSTR(c_href));				}			}		}	}	// パラメータの後始末	if (c_answer)	delete c_answer;	if (c_href)		delete c_href;}// -------------------------------------------------------------------------------------------------//	･ DoS// -------------------------------------------------------------------------------------------------// 単一文だけなので関数化しない。//void//CSystem::DoS(//	CGameWindow		*inWindow )//{//	mErase = true;//}// -------------------------------------------------------------------------------------------------//	･ DoS_E// -------------------------------------------------------------------------------------------------// 単一文だけなので関数化しない。//void//CSystem::DoS_E(//	CGameWindow		*inWindow )//{//	mErase = false;//}// -------------------------------------------------------------------------------------------------//	･ DoSCREEN																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoSCREEN(	CGameWindow		*inWindow ){	TagScreen		*tag = (TagScreen*)mCurTag;	// パラメータの置換	string	*c_top    = GetNativeParam(tag->k_top,    true);	string	*c_left   = GetNativeParam(tag->k_left,   true);	string	*c_width  = GetNativeParam(tag->k_width,  true);	string	*c_height = GetNativeParam(tag->k_height, true);	string	*c_shut   = GetNativeParam(tag->k_shut,   true);	if (c_top) {		mScreenPoint.v = atol(CSTR(c_top));	}	if (c_left) {		mScreenPoint.h = atol(CSTR(c_left));	}	if (c_width) {		mScreenSize.h = atol(CSTR(c_width));	}	if (c_height) {		mScreenSize.v = atol(CSTR(c_height));	}	if (c_shut) {		mScreenShut = (!stricmp(CSTR(c_shut), "NONE")) ? SHUT_NONE : SHUT_AUTO;	} else {		mScreenShut = SHUT_AUTO;	}	mIX   = mScreenPoint.h;	mCurX = mScreenPoint.h;	mCurY = mScreenPoint.v;	ClearTEXT();	// パラメータの後始末	if (c_top)		delete c_top;	if (c_left)		delete c_left;	if (c_width)	delete c_width;	if (c_height)	delete c_height;	if (c_shut)		delete c_shut;}// -------------------------------------------------------------------------------------------------//	･ DoShadow// -------------------------------------------------------------------------------------------------// 単一文だけなので関数化しない。//void//CSystem::DoShadow(//	CGameWindow		*inWindow )//{//	mShadow = true;//}// -------------------------------------------------------------------------------------------------//	･ DoShadow_E// -------------------------------------------------------------------------------------------------// 単一文だけなので関数化しない。//void//CSystem::DoShadow_E(//	CGameWindow		*inWindow )//{//	mShadow = false;//}// -------------------------------------------------------------------------------------------------//	･ DoSPACE																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoSPACE(	CGameWindow		*inWindow ){	TagSpace		*tag = (TagSpace*)mCurTag;	// パラメータの置換	string	*c_top    = GetNativeParam(tag->k_top,    true);	string	*c_left   = GetNativeParam(tag->k_left,   true);	string	*c_width  = GetNativeParam(tag->k_width,  true);	string	*c_height = GetNativeParam(tag->k_height, true);	if (c_top) {		mSpacePoint.v = atol(CSTR(c_top));		if (mSpacePoint.v < 0) {			mSpacePoint.v = 0;		}		if (mSpacePoint.v > mStageSize.v - 1) {			mSpacePoint.v = mStageSize.v - 1;		}	}	if (c_left) {		mSpacePoint.h = atol(CSTR(c_left));		if (mSpacePoint.h < 0) {			mSpacePoint.h = 0;		}		if (mSpacePoint.h > mStageSize.h - 1) {			mSpacePoint.h = mStageSize.h - 1;		}	}	if (c_width) {		mSpaceSize.h = atol(CSTR(c_width));		if (mSpaceSize.h < 0) {			mSpaceSize.h = 0;		}		if (mSpaceSize.h + mSpacePoint.h > mStageSize.h) {			mSpaceSize.h = mStageSize.h - mSpacePoint.h;		}	}	if (c_height) {		mSpaceSize.v = atol(CSTR(c_height));		if (mSpaceSize.v < 0) {			mSpaceSize.v = 0;		}		if (mSpaceSize.v + mSpacePoint.v > mStageSize.v) {			mSpaceSize.v = mStageSize.v - mSpacePoint.v;		}	}	if (!mEnter) {		delete mEnter;	}	mEnter = new CEnter(mGraphics);	// for SPACE	CGBuffer	*cgb = mGraphics->GetPDT(CGB_SPACE);	if (cgb) {		delete cgb;	}	cgb = new CGBuffer(mWindowSize.h, mWindowSize.v, 3, mWindowSize.h*3, true, 0);	mGraphics->SetPDT(CGB_SPACE, cgb);	// パラメータの後始末	if (c_top)		delete c_top;	if (c_left)		delete c_left;	if (c_width)	delete c_width;	if (c_height)	delete c_height;}// -------------------------------------------------------------------------------------------------//	･ DoSTAGE																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoSTAGE(	CGameWindow		*inWindow ){	TagStage		*tag = (TagStage*)mCurTag;	int				ip;	Boolean			changeFlag = false;	unsigned char	*msk;	CGBuffer		*cgb;		// パラメータの置換	string	*c_width  = GetNativeParam(tag->k_width,  true);	string	*c_height = GetNativeParam(tag->k_height, true);	if (c_width) {		if ((ip = atol(CSTR(c_width))) != mStageSize.h) {			mStageSize.h = ip;			changeFlag   = true;		}	}	if (c_height) {		if ((ip = atol(CSTR(c_height))) != mStageSize.v) {			mStageSize.v = ip;			changeFlag   = true;		}	}	if (changeFlag) {		inWindow->SetScreenSize(mStageSize.h, mStageSize.v);		inWindow->Show();		inWindow->GetScreenSize(&mWindowSize.h, &mWindowSize.v);		inWindow->GetWindowOffset(&mWindowOffset);		if (mGraphics) {			delete mGraphics;		}		mGraphics = new CGraphics(this, inWindow->GetWindowPtr());		mGraphics->FillRect(0, 0, mWindowSize.h - 1, mWindowSize.v - 1, 0, 0, 0, 0);		mGraphics->AllCopy(0, CGB_STAGE,   0);		// for BACKG		mGraphics->AllCopy(0, CGB_BACKG,   0);		// for BACKG		mGraphics->AllCopy(0, CGB_BACKG01, 0);		// for BACKG loading file		mGraphics->AllCopy(0, CGB_WAKUG,   0);		// for WAKUG		mGraphics->AllCopy(0, CGB_WAKUG01, 0);		// for WAKUG loading file		mGraphics->AllCopy(0, CGB_MESWIN,  0);		// for MESWIN		mGraphics->AllCopy(0, CGB_CURTAIN, 0);		// for CURTAIN		mGraphics->AllCopy(0, CGB_BACKUP,  0);		// for BACKUP		mGraphics->AllCopy(0, CGB_HIDE,    0);		// for HIDE		mGraphics->AllCopy(0, CGB_STRETCH, 0);		// for STRETCH		// for SPACE		cgb = new CGBuffer(mWindowSize.h, mWindowSize.v, 3, mWindowSize.h*3, true, 0);		mGraphics->SetPDT(CGB_SPACE, cgb);		if (mEnter) {			delete mEnter;		}		mEnter = new CEnter(mGraphics);	} else {		// for SPACE （SPACE/ENTER のみクリア）		mGraphics->FillRect(0, 0, mWindowSize.h - 1, mWindowSize.v - 1, CGB_SPACE, 0, 0, 0);		cgb = mGraphics->GetPDT(CGB_SPACE);		msk = cgb->GetMaskBuffer();		memset(msk, '\0', cgb->GetSizeX() * cgb->GetSizeY());		if (mEnter) {			mEnter->initEnter();//			delete mEnter;		}//		mEnter = new CEnter(mGraphics);	}	mGraphics->DeleteBIcon();	mGraphics->DeletePIcon();	mActiveIcon = false;	// パラメータの後始末	if (c_width)	delete c_width;	if (c_height)	delete c_height;}// -------------------------------------------------------------------------------------------------//	･ DoSUNGLASS															[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoSUNGLASS(	CGameWindow		*inWindow ){	TagSunglass		*tag = (TagSunglass*)mCurTag;		// パラメータの置換	string	*c_color = GetNativeParam(tag->k_color, true);	if (c_color) {		char	*p;		if (*(p = CSTR(c_color)) == '#') {			if (GetParamColor(CSTR(c_color), &mSunglassR, &mSunglassG, &mSunglassB)) {				mSunglassMode = SUN_COLOR;				mSunglass     = true;			}		} else		if (!stricmp(p, "SUNSET")) {			mSunglassR    = 0xC0;			mSunglassG    = 0x80;			mSunglassB    = 0x40;			mSunglassMode = SUN_COLOR;			mSunglass     = true;		} else		if (!stricmp(p, "NIGHT")) {			mSunglassMode = SUN_NIGHT;			mSunglass     = true;		} else		if (!stricmp(p, "MIDNIGHT")) {			mSunglassMode = SUN_MIDNIGHT;			mSunglass     = true;		} else		if (!stricmp(p, "LIGHT")) {			mSunglassMode = SUN_LIGHT;			mSunglass     = true;		} else		if (!stricmp(p, "INVERSE")) {			mSunglassMode = SUN_INVERSE;			mSunglass     = true;		} else		if (!stricmp(p, "MONO")) {			mSunglassMode = SUN_MONO;			mSunglass     = true;		} else		if (!stricmp(p, "SEPIA")) {			mSunglassMode = SUN_SEPIA;			mSunglass     = true;		}	}	// パラメータの後始末	if (c_color)	delete c_color;}// -------------------------------------------------------------------------------------------------//	･ DoSUNGLASS_E// -------------------------------------------------------------------------------------------------// 単一文だけなので関数化しない。//void//CSystem::DoSUNGLASS_E(//	CGameWindow		*inWindow )//{//	mSunglass = false;//}// -------------------------------------------------------------------------------------------------//	･ DoTIMER																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoTIMER(	CGameWindow		*inWindow ){	TagTimer	*tag = (TagTimer*)mCurTag;	if (!mInProgress) {		// パラメータの置換		string	*c_time = GetNativeParam(tag->k_time, true);		if (c_time) {			mTimerWait  = (int)Time2Long(CSTR(c_time));			mInProgress = true;		} else {			mTimerBase = mGraphics->GetCurrentTimer();		}		// パラメータの後始末		if (c_time)	delete c_time;	} else {		if ((mGraphics->GetCurrentTimer() - mTimerBase) >= mTimerWait) {			mInProgress = false;			mTimerWait  = 0;		}	}}// -------------------------------------------------------------------------------------------------//	･ DoTITLE																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoTITLE(	CGameWindow		*inWindow ){	TagTitle	*tag = (TagTitle*)mCurTag;	Str255		ptitle;	// パラメータの置換	string	*c_alt = GetNativeParam(tag->k_alt, true);	if (c_alt) {		strcpy(mTitle,         CSTR(c_alt));		strcpy((char *)ptitle, CSTR(c_alt));		C2PStr((char *)ptitle);		inWindow->SetDescriptor(ptitle);	}	// パラメータの後始末	if (c_alt)	delete c_alt;}// -------------------------------------------------------------------------------------------------//	･ DoTRAP																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoTRAP(	CGameWindow		*inWindow ){	if (!mInProgress) {		mInProgress = true;		mActiveBR   = true;		mSelectSkip = false;		mActiveIcon  = true;		mGraphics->UpdateScreen();		CSYS_COPYTO(CGB_BACKUP);	} else {		if (mPushMouse) {			CSYS_COPYFROM(CGB_BACKUP);			mInProgress = false;			mActiveBR   = false;			mPushMouse  = false;			mTimeTEXT   = mCurTextTime;		}	}}// -------------------------------------------------------------------------------------------------//	･ DoU																	[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoU(	CGameWindow		*inWindow ){	int				fontSize;	FontInfo		finfo;		pushFont();	mFont->style |= underline;	fontSize      = mFont->x;	do {		FetchFontInfo(mFont->fontID, fontSize, mFont->style, &finfo);		fontSize--;	} while (finfo.ascent + finfo.descent > mFont->y ||			 finfo.widMax > mFont->x);	mFont->s = fontSize;}// -------------------------------------------------------------------------------------------------//	･ DoU_E// -------------------------------------------------------------------------------------------------// 単一関数呼び出しだけなので関数化しない。//void//CSystem::DoU_E(//	CGameWindow		*inWindow )//{//	popFont();//}// -------------------------------------------------------------------------------------------------//	･ DoW																	[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoW(	CGameWindow		*inWindow ){	if (!mSelectSkip) {		if (!mInProgress) {			TagW		*tag = (TagW*)mCurTag;			// パラメータの置換			string	*c_time = GetNativeParam(tag->k_time, true);			if (c_time) {				mWTime = atoi(CSTR(c_time));				mGraphics->ResetTimer();			}			mInProgress = true;			mActiveBR   = true;			mGraphics->UpdateScreen();			CSYS_COPYTO(CGB_BACKUP);						// パラメータの後始末			if (c_time)	delete c_time;		} else {			if (mPushMouse) {				CSYS_COPYFROM(CGB_BACKUP);				mWTime      = 0;				mInProgress = false;				mActiveBR   = false;				mPushMouse  = false;			} else {				if (mWTime && mGraphics->GetTimer() >= mWTime) {					CSYS_COPYFROM(CGB_BACKUP);					mWTime      = 0;					mInProgress = false;					mActiveBR   = false;				}			}		}	} else {		mWTime      = 0;		mInProgress = false;		mPushMouse  = false;	}}// -------------------------------------------------------------------------------------------------//	･ DoWAIT																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoWAIT(	CGameWindow		*inWindow ){	TagWait			*tag = (TagWait*)mCurTag;		// パラメータの置換	string	*c_text      = GetNativeParam(tag->k_text,      true);	string	*c_character = GetNativeParam(tag->k_character, true);	string	*c_back      = GetNativeParam(tag->k_back,      true);	string	*c_fade      = GetNativeParam(tag->k_fade,      true);	pushWait();	if (c_text) {		if (!mSelectSkip) {			if (!stricmp(CSTR(c_text), "USER")) {				mTimeTEXT = mPreset->textSpeed;			} else {				mTimeTEXT = atoi(CSTR(c_text)) / 2;			}		} else {			if (!stricmp(CSTR(c_text), "USER")) {				mCurTextTime = mPreset->textSpeed;			} else {				mCurTextTime = atoi(CSTR(c_text)) / 2;			}		}	}	if (c_character) {		if (!stricmp(CSTR(c_character), "USER")) {			mTimeSCREEN = mPreset->charSpeed;		} else {			mTimeSCREEN = atoi(CSTR(c_character)) / 2;		}	}	if (c_back) {		if (!stricmp(CSTR(c_back), "USER")) {			mTimeBACKG = mPreset->backSpeed;		} else {			mTimeBACKG = atoi(CSTR(c_back)) / 4;		}	}	if (c_fade) {		if (!stricmp(CSTR(c_fade), "USER")) {			mFadeTime = mPreset->wakuSpeed;		} else {			mFadeTime = atoi(CSTR(c_fade)) / 4;		}	}	// パラメータの後始末	if (c_text)			delete c_text;	if (c_character)	delete c_character;	if (c_back)			delete c_back;	if (c_fade)			delete c_fade;}// -------------------------------------------------------------------------------------------------//	･ DoWAIT_E// -------------------------------------------------------------------------------------------------// 単一関数呼び出しだけなので関数化しない。//void//CSystem::DoWAIT_E(//	CGameWindow		*inWindow )//{//	popWait();//}// -------------------------------------------------------------------------------------------------//	･ DoWINDOW																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoWINDOW(	CGameWindow		*inWindow ){	TagWindow		*tag = (TagWindow*)mCurTag;	char			imageName[256], alphaName[256];	int				mode, r, g, b, t = 0, l = 0, w, h, alp = 100;	Boolean			savFlagText = mFlagText;	Boolean			alphaFlag = false;		// パラメータの置換	string	*c_src         = GetNativeParam(tag->k_src,         true);	string	*c_folder      = GetNativeParam(tag->k_folder,      true);	string	*c_top         = GetNativeParam(tag->k_top,         true);	string	*c_left        = GetNativeParam(tag->k_left,        true);	string	*c_width       = GetNativeParam(tag->k_width,       true);	string	*c_height      = GetNativeParam(tag->k_height,      true);	string	*c_effect      = GetNativeParam(tag->k_effect,      true);	string	*c_alpha       = GetNativeParam(tag->k_alpha,       true);	string	*c_subfolder   = GetNativeParam(tag->k_subfolder,   true);	string	*c_shut        = GetNativeParam(tag->k_shut,        true);	string	*c_transparent = GetNativeParam(tag->k_transparent, true);	// 一度メッセージウィンドウを消去する	EraseMesWin(true);	// 画像の設定	if (GetParamFileName(c_folder, c_src, imageName)) {		// 画像ファイルのロード		r = g = b = -1;		if (c_transparent) {			if (!stricmp(CSTR(c_transparent), "NONE")) {				mode = MASK_NONE;			} else			if (!stricmp(CSTR(c_transparent), "AUTO")) {				mode = MASK_AUTO;			} else {				if (!GetParamColor(CSTR(c_transparent), &r, &g, &b)) {					r = g = b = 0;				}			}		} else {			mode = MASK_NONE;		}		// アルファ画像チェック		if (c_alpha) {			if ((alp = isdigits(CSTR(c_alpha))) == -1) {				if (!c_subfolder) {					alphaFlag = GetParamFileName(c_folder, c_alpha, alphaName);				} else {					alphaFlag = GetParamFileName(c_subfolder, c_alpha, alphaName);				}				if (alphaFlag) {					mode = MASK_ALPHA;				}			}		}		mGraphics->LoadFile(imageName, CGB_WAKUG01, mode, r, g, b);		CGBuffer		*imageCGB = mGraphics->GetPDT(CGB_WAKUG01);		if (alphaFlag) {			mGraphics->LoadFile(alphaName, CGB_WAKUG00, MASK_NONE, -1, -1, -1);			CGBuffer		*alphaCGB = mGraphics->GetPDT(CGB_WAKUG00);			unsigned char	*alphaSrc = alphaCGB->GetBuffer();			unsigned char	*imageMsk = imageCGB->GetMaskBuffer();			mGraphics->MakeMonochrome(0,									  0,									  alphaCGB->GetSizeX() - 1,									  alphaCGB->GetSizeY() - 1,									  CGB_WAKUG00);			int		maxX = (alphaCGB->GetSizeX() < imageCGB->GetSizeX()) ? alphaCGB->GetSizeX()																		 : imageCGB->GetSizeX();			int		maxY = (alphaCGB->GetSizeY() < imageCGB->GetSizeY()) ? alphaCGB->GetSizeY()																		 : imageCGB->GetSizeY();			for (int y = 0; y < maxY; y++) {				for (int x = 0; x < maxX; x++) {					*imageMsk++ = *alphaSrc;					alphaSrc += alphaCGB->GetBPP();				}			}			alp = 100;		}		// 画像バッファの初期化		mGraphics->FillRect(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_WAKUG, 0, 0, 0);		CGBuffer		*cgb = mGraphics->GetPDT(CGB_WAKUG);		unsigned char	*msk = cgb->GetMaskBuffer();		memset(msk, 0, cgb->GetSizeX() * cgb->GetSizeY());		// WAKUG プレーンへの設定		if (c_top) {			mWakuPoint.v = atoi(CSTR(c_top));		}		if (c_left) {			mWakuPoint.h = atoi(CSTR(c_left));		}		GetParamWidthHeight(c_width, c_height, BASE_FILE, CGB_WAKUG01, &w, &h);		mWakuSize.h = (short)w;		mWakuSize.v = (short)h;		if (w != imageCGB->GetSizeX() || h != imageCGB->GetSizeY()) {			CGBuffer		*scgb = mGraphics->GetPDT(CGB_STRETCH);			mGraphics->StretchCopy(0, 0, imageCGB->GetSizeX() - 1, imageCGB->GetSizeY() - 1, CGB_WAKUG01,								   0, 0, mWakuSize.h - 1, mWakuSize.v - 1, CGB_STRETCH);/////	要ー見直し　↓↓↓↓↓			if (imageCGB->GetSizeX() > 9 && imageCGB->GetSizeY() > 9) {				mGraphics->CreateMask(imageCGB->GetSizeX(),									  imageCGB->GetSizeY(),									  scgb->GetMaskBuffer());			}/////	要ー見直し　↑↑↑↑↑			mGraphics->CopyWithMask(0, 0, mWakuSize.h - 1, mWakuSize.v - 1, CGB_STRETCH,											mWakuPoint.h, mWakuPoint.v, CGB_WAKUG, alp, 0);		} else {			mGraphics->CopyWithMask(0, 0, mWakuSize.h - 1, mWakuSize.v - 1, CGB_WAKUG01,											mWakuPoint.h, mWakuPoint.v, CGB_WAKUG, alp, 0);		}		if (c_shut) {			mWakuShut = (!stricmp(CSTR(c_shut), "NONE")) ? SHUT_NONE : SHUT_AUTO;		} else {			mWakuShut = SHUT_AUTO;		}		if (c_effect) {			mEDefaultSCREEN = getEffectType(CSTR(c_effect));		} else {			mEDefaultSCREEN = EF_FADEIN;		}		mNovelMode  = false;		mWakuFlag   = true;		mWakuActive = false;		mFlagText   = false;	} else {		mGraphics->FillRect(0, 0, mStageSize.h - 1, mStageSize.v - 1, CGB_WAKUG, 0, 0, 0);		CGBuffer		*cgb = mGraphics->GetPDT(CGB_WAKUG);		unsigned char	*msk = cgb->GetMaskBuffer();		memset(msk, 0x80, cgb->GetSizeX() * cgb->GetSizeY());		mNovelMode      = true;		mWakuFlag       = true;		mWakuActive     = false;		mWakuShut       = SHUT_AUTO;		mScreenPoint.h  = 0;		mScreenPoint.v  = 0;		mScreenSize.h   = mStageSize.h;		mScreenSize.v   = mStageSize.v;		mEDefaultSCREEN = EF_OVERLAP;	}		// パラメータの後始末	if (c_src)			delete c_src;	if (c_folder)		delete c_folder;	if (c_top)			delete c_top;	if (c_left)			delete c_left;	if (c_width)		delete c_width;	if (c_height)		delete c_height;	if (c_effect)		delete c_effect;	if (c_alpha)		delete c_alpha;	if (c_subfolder)	delete c_subfolder;	if (c_shut)			delete c_shut;	if (c_transparent)	delete c_transparent;}// -------------------------------------------------------------------------------------------------//	･ DoWINDOW_E// -------------------------------------------------------------------------------------------------// 処理が単純なので関数化しない。//void//CSystem::DoWINDOW_E(//	CGameWindow		*inWindow )//{//	mWakuFlag  = false;//	EraseMesWin(CGB_STAGE, mEDefaultSCREEN);//}// -------------------------------------------------------------------------------------------------//	･ DoWRITE																[public]// -------------------------------------------------------------------------------------------------voidCSystem::DoWRITE(	CGameWindow		*inWindow ){	TagWrite		*tag = (TagWrite*)mCurTag;	char			*src = nil, *buff = new char[256];	strcpy(buff, "");	if (tag->k_src) {		if (mCARD->cardList->existCard(CSTR(tag->k_src))) {			// ターゲットはカード			sprintf(buff, "%s", mCARD->cardList->getCardStr(CSTR(tag->k_src)));		} else {													// ターゲットはエイリアス			if ((src = mAlias->getItem(CSTR(tag->k_src))) != nil) {				strcpy(buff, src);			}		}	}	PutStr(buff);	delete[] buff;}/*****************************************************************************************************		ＴＡＧ処理ー汎用関数***************************************************************************************************/// -------------------------------------------------------------------------------------------------//	･ GetParamColor															[public]// -------------------------------------------------------------------------------------------------BooleanCSystem::GetParamColor(	char		*inStr,	int			*outR,	int			*outG,	int			*outB ){	char		col[128], red[4], green[4], blue[4];	int			len;	Boolean		ret = false;		strcpy(col, "000000");	if (*inStr == '#') {		len = strlen(inStr + 1);		if (len > 6) {			len = 6;		}		memcpy(col + (6 - len), inStr + 1, len);		memset(red,   '\0', sizeof(red)  );		memset(green, '\0', sizeof(green));		memset(blue,  '\0', sizeof(blue) );		memcpy(red,   col + 0, 2);		memcpy(green, col + 2, 2);		memcpy(blue,  col + 4, 2);		*outR = Hex2Int(red);		*outG = Hex2Int(green);		*outB = Hex2Int(blue);		ret = true;	}	return ret;}// -------------------------------------------------------------------------------------------------//	･ GetParamFileName (Native file name)									[public]// -------------------------------------------------------------------------------------------------BooleanCSystem::GetParamFileName(	const	string	*inFolder,	const	string	*inFile,	char			*outFileName ){	Boolean		ret = false;	char		*src, *folder = nil;		if (inFile != nil) {		if ((src = mAlias->getItem(CSTR(inFile))) == nil) {			src = CSTR(inFile);		}		if (inFolder != nil) {			if (!stricmp(CSTR(inFolder), "PLAYER")) {				folder = mDNML->playerFolder;			} else			if (stricmp(CSTR(inFolder), "CURRENT")) {				if ((folder = mAlias->getItem(CSTR(inFolder))) == nil) {					folder = CSTR(inFolder);				}			}		}		if (!folder) {			sprintf(outFileName, "%s%s", mDNML->currentFolder, src);		} else {			if (*folder != '\0') {				if (folder[strlen(folder)-1] != '/') {					sprintf(outFileName, "%s/%s", folder, src);				} else {					sprintf(outFileName, "%s%s", folder, src);				}			} else {				strcpy(outFileName, src);			}		}		mDNML->convertNative(outFileName);		ret = true;	}	return ret;}// -------------------------------------------------------------------------------------------------//	･ GetParamWidthHeight													[public]// -------------------------------------------------------------------------------------------------voidCSystem::GetParamWidthHeight(	const	string	*inWidth,	const	string	*inHeight,	int				inBase,	int				inBufNo,	int				*outWidth,	int				*outHeight ){	char	*p, param[256];	int		pct = -1, ival = 0;		*outWidth = *outHeight = 0;	if (inBase == BASE_NONE) {		*outWidth  = atoi(CSTR(inWidth));		*outHeight = atoi(CSTR(inHeight));	} else {		if (inWidth) {			strcpy(param, CSTR(inWidth));			if ((p = strchr(param, '%')) != 0) {				*p   = '\0';				pct  = atoi(param);				switch (inBase) {					case BASE_STAGE:						*outWidth = mStageSize.h * pct / 100;						break;					case BASE_BACKG:						*outWidth = mStageSize.h * pct / 100;						break;					case BASE_SPACE:						*outWidth = mSpaceSize.h * pct / 100;						break;					case BASE_SCREEN:						*outWidth = mScreenSize.h * pct / 100;						break;					case BASE_FILE:						{							CGBuffer	*cgb = mGraphics->GetPDT(inBufNo);							if (cgb) {								*outWidth = cgb->GetSizeX() * pct / 100;							}						}						break;				}			} else {				*outWidth = atoi(param);			}		} else {			switch (inBase) {				case BASE_STAGE:					*outWidth = mStageSize.h;					break;				case BASE_BACKG:					*outWidth = mStageSize.h;					break;				case BASE_SPACE:					*outWidth = mSpaceSize.h;					break;				case BASE_SCREEN:					*outWidth = mScreenSize.h;					break;				case BASE_FILE:					{						CGBuffer	*cgb = mGraphics->GetPDT(inBufNo);						if (cgb) {							*outWidth = cgb->GetSizeX();						}					}					break;			}		}		if (inHeight) {			strcpy(param, CSTR(inHeight));			if ((p = strchr(param, '%')) != 0) {				*p   = '\0';				pct  = atoi(param);				switch (inBase) {					case BASE_STAGE:						*outHeight = mStageSize.v * pct / 100;						break;					case BASE_BACKG:						*outHeight = mStageSize.v * pct / 100;						break;					case BASE_SPACE:						*outHeight = mSpaceSize.v * pct / 100;						break;					case BASE_SCREEN:						*outHeight = mScreenSize.v * pct / 100;						break;					case BASE_FILE:						{							CGBuffer	*cgb = mGraphics->GetPDT(inBufNo);							if (cgb) {								*outHeight = cgb->GetSizeY() * pct / 100;							}						}						break;				}			} else {				*outHeight = atoi(param);			}		} else {			switch (inBase) {				case BASE_STAGE:					*outHeight = mStageSize.v;					break;				case BASE_BACKG:					*outHeight = mStageSize.v;					break;				case BASE_SPACE:					*outHeight = mSpaceSize.v;					break;				case BASE_SCREEN:					*outHeight = mScreenSize.v;					break;				case BASE_FILE:					{						CGBuffer	*cgb = mGraphics->GetPDT(inBufNo);						if (cgb) {							*outHeight = cgb->GetSizeY();						}					}					break;			}		}	}}// -------------------------------------------------------------------------------------------------//	･ GetParamLeftTop														[public]// -------------------------------------------------------------------------------------------------voidCSystem::GetParamLeftTop(	const	string	*inLeft,	const	string	*inTop,	int				inBase,	int				inBufNo,	int				*outLeft,	int				*outTop ){	char	*p, param[256];	int		pct = -1, ival = 0;	//	*outLeft = *outTop = 0;	if (inBase == BASE_NONE) {		*outLeft = atoi(CSTR(inLeft));		*outTop  = atoi(CSTR(inTop));	} else {		if (inLeft) {			strcpy(param, CSTR(inLeft));			if ((p = strchr(param, '%')) != 0) {				*p   = '\0';				pct  = atoi(param);				switch (inBase) {					case BASE_STAGE:					case BASE_BACKG:						*outLeft = mStageSize.h  * pct / 100;						break;					case BASE_SPACE:						*outLeft = mSpacePoint.h  + mSpaceSize.h  * pct / 100;						break;					case BASE_SCREEN:						*outLeft = mScreenPoint.h + mScreenSize.h * pct / 100;						break;					case BASE_FILE:						{							CGBuffer	*cgb = mGraphics->GetPDT(inBufNo);							if (cgb) {								*outLeft = cgb->GetSizeX() * pct / 100;							}						}						break;				}			} else {				if (*param == '+') {					pct = atoi(param + 1) + mCurX - mScreenPoint.h;				} else {					pct = atoi(param);				}				switch (inBase) {					case BASE_STAGE:					case BASE_BACKG:						*outLeft = mStageSize.h  + pct;						break;					case BASE_SPACE:						*outLeft = mSpacePoint.h  + pct;						break;					case BASE_SCREEN:						*outLeft = mScreenPoint.h + pct;						break;					case BASE_FILE:						{							CGBuffer	*cgb = mGraphics->GetPDT(inBufNo);							if (cgb) {								*outLeft = cgb->GetSizeX() + pct;							}						}						break;				}			}/*		} else {			switch (inBase) {				case BASE_STAGE:				case BASE_BACKG:				case BASE_FILE:					*outLeft = 0;					break;				case BASE_SPACE:					*outLeft = mSpacePoint.h;					break;				case BASE_SCREEN:					*outLeft = mScreenPoint.h;					break;			}*/		}		if (inTop) {			strcpy(param, CSTR(inTop));			if ((p = strchr(param, '%')) != 0) {				*p   = '\0';				pct  = atoi(param);				switch (inBase) {					case BASE_STAGE:					case BASE_BACKG:						*outTop = mStageSize.v * pct / 100;						break;					case BASE_SPACE:						*outTop = mSpacePoint.v  + mSpaceSize.v * pct / 100;						break;					case BASE_SCREEN:						*outTop = mScreenPoint.v + mScreenSize.v * pct / 100;						break;					case BASE_FILE:						{							CGBuffer	*cgb = mGraphics->GetPDT(inBufNo);							if (cgb) {								*outTop = cgb->GetSizeY() * pct / 100;							}						}						break;				}			} else {				if (*param == '+') {					pct = atoi(param + 1) + mCurY - mScreenPoint.v;				} else {					pct = atoi(param);				}				switch (inBase) {					case BASE_STAGE:					case BASE_BACKG:						*outTop = mStageSize.v  + pct;						break;					case BASE_SPACE:						*outTop = mSpacePoint.v  + pct;						break;					case BASE_SCREEN:						*outTop = mScreenPoint.v + pct;						break;					case BASE_FILE:						{							CGBuffer	*cgb = mGraphics->GetPDT(inBufNo);							if (cgb) {								*outTop = cgb->GetSizeY() + pct;							}						}						break;				}			}/*		} else {			switch (inBase) {				case BASE_STAGE:				case BASE_BACKG:				case BASE_FILE:					*outTop = 0;					break;				case BASE_SPACE:					*outTop = mSpacePoint.v;					break;				case BASE_SCREEN:					*outTop = mScreenPoint.v;					break;			}*/		}	}}// -------------------------------------------------------------------------------------------------//	･ getEffectType															[public]// -------------------------------------------------------------------------------------------------intCSystem::getEffectType(	char			*inStr ){	int		ret = -1;	char	*efct;		if ((efct = mAlias->getItem(inStr)) == nil) {		efct = inStr;	}		if (!stricmp(efct, "EF_FROM_LEFT")) {		ret = EF_FROM_LEFT;		// ◎画面左から表示	} else	if (!stricmp(efct, "EF_FROM_RIGHT")) {		ret = EF_FROM_RIGHT;		// ◎画面右から表示	} else	if (!stricmp(efct, "EF_FROM_TOP")) {		ret = EF_FROM_TOP;		// ◎画面上から表示	} else	if (!stricmp(efct, "EF_FROM_BOTTOM")) {		ret = EF_FROM_BOTTOM;		// ◎画面下から表示	} else	if (!stricmp(efct, "EF_BLIND_FROM_LEFT")) {		ret = EF_BLIND_FROM_LEFT;		// ◎ブラインドを降ろしたような効果で画面左から表示	} else	if (!stricmp(efct, "EF_BLIND_FROM_RIGHT")) {		ret = EF_BLIND_FROM_RIGHT;		// ◎ブラインドを降ろしたような効果で画面右から表示	} else	if (!stricmp(efct, "EF_BLIND_FROM_TOP")) {		ret = EF_BLIND_FROM_TOP;		// ◎ブラインドを降ろしたような効果で画面上から表示	} else	if (!stricmp(efct, "EF_BLIND_FROM_BOTTOM")) {		ret = EF_BLIND_FROM_BOTTOM;		// ◎ブラインドを降ろしたような効果で画面下から表示	} else	if (!stricmp(efct, "EF_FADEIN")) {		ret = EF_FADEIN;		// ◎画面全体からじわじわと表示	} else	if (!stricmp(efct, "EF_FADE_FROM_LEFT")) {		ret = EF_FADE_FROM_LEFT;		// ◎画面左からじわじわと表示	} else	if (!stricmp(efct, "EF_FADE_FROM_RIGHT")) {		ret = EF_FADE_FROM_RIGHT;		// ◎画面右からじわじわと表示	} else	if (!stricmp(efct, "EF_FADE_FROM_TOP")) {		ret = EF_FADE_FROM_TOP;		// ◎画面上からじわじわと表示	} else	if (!stricmp(efct, "EF_FADE_FROM_BOTTOM")) {		ret = EF_FADE_FROM_BOTTOM;		// ◎画面下からじわじわと表示	} else	if (!stricmp(efct, "EF_BRUSH_FROM_LEFT")) {		ret = EF_BRUSH_FROM_LEFT;		// ◎櫛形に左から表示	} else	if (!stricmp(efct, "EF_BRUSH_FROM_RIGHT")) {		ret = EF_BRUSH_FROM_RIGHT;		// ◎櫛形に右から表示	} else	if (!stricmp(efct, "EF_BRUSH_FROM_TOP")) {		ret = EF_BRUSH_FROM_TOP;		// ◎櫛形に上から表示	} else	if (!stricmp(efct, "EF_BRUSH_FROM_BOTTOM")) {		ret = EF_BRUSH_FROM_BOTTOM;		// ◎櫛形に下から表示	} else	if (!stricmp(efct, "EF_NONE")) {		ret = EF_NONE;		// ◎瞬間表示	} else	if (!stricmp(efct, "EF_OVERLAP")) {		ret = EF_OVERLAP;		// ◎半透明を使って重ねて表示	} else	if (!stricmp(efct, "EF_BLACK_WIPE")) {		ret = EF_BLACK_WIPE;		// ◎一度画面を黒くしてから櫛形に表示する。BACKGROUNDのみ指定可能	} else	if (!stricmp(efct, "EF_NORMAL")) {		ret = EF_BRUSH_FROM_LEFT;		// ◎櫛形に表示	} else {		ret = EF_NORMAL;	}	return ret;}// -------------------------------------------------------------------------------------------------//	･ GotoHREF																[public]// -------------------------------------------------------------------------------------------------voidCSystem::GotoHREF(	char			*inHref){	if (inHref[0] == '#') {			mDNML->gotoScenario(inHref);	} else	if (inHref[0] != '\0') {		char	file[256], ntag[256], href[256];		char	*sp, *dp;		memset(file, '\0', sizeof(file));		memset(ntag, '\0', sizeof(ntag));		for (sp = inHref, dp = file; *sp != '#' && *sp != '\0'; sp++, dp++) {			*dp = *sp;		}		*dp = '\0';		strcpy(mCurFolder, mDNML->currentFolder);		if (*sp == '#') {			for (dp = ntag; *sp != '\0'; sp++, dp++) {				*dp = *sp;			}			*dp = '\0';		}		delete mDNML;		sprintf(href, "%s%s", mCurFolder, file);		if ((mDNML = new dnmlparse(href)) != nil) {			if (!mDNML->yyparse()) {				if (ntag[0] == '#') {					mDNML->gotoScenario(href);				}				strcpy(mCurFolder, mDNML->currentFolder);			}		}	}}// -------------------------------------------------------------------------------------------------//	･ GetNativeParam														[public]// -------------------------------------------------------------------------------------------------string*CSystem::GetNativeParam(	string			*inStr,	Boolean			inReplace){	string		*str = nil;	char		*p;		if (inStr) {		if ((p = mAlias->getItem(CSTR(inStr))) == nil) {			if (!stricmp(CSTR(inStr), "CURRENT")) {				str = new string(mDNML->currentFolder);			} else {				str = new string(CSTR(inStr));			}		} else {			str = new string(p);		}		if (inReplace) {			mCARD->replaceCard(str);		}	}	return str;}// -------------------------------------------------------------------------------------------------//	･ GetActiveBGM															[public]// -------------------------------------------------------------------------------------------------BooleanCSystem::GetActiveBGM(void){	return mTagBGM->getActive();}// -------------------------------------------------------------------------------------------------//	･ SetActiveBGM															[public]// -------------------------------------------------------------------------------------------------voidCSystem::SetActiveBGM(Boolean inFlag){	if (!inFlag) {		mTagBGM->stop(nil);	}	mTagBGM->setActive(inFlag);}// -------------------------------------------------------------------------------------------------//	･ GetVolumeBGM															[public]// -------------------------------------------------------------------------------------------------intCSystem::GetVolumeBGM(void){	return mTagBGM->getVolume();}// -------------------------------------------------------------------------------------------------//	･ SetVolumeBGM															[public]// -------------------------------------------------------------------------------------------------voidCSystem::SetVolumeBGM(int inVol){	mTagBGM->setVolume(inVol);}// -------------------------------------------------------------------------------------------------//	･ GetActiveSND															[public]// -------------------------------------------------------------------------------------------------BooleanCSystem::GetActiveSND(void){	return mTagSOUND->getActive();}// -------------------------------------------------------------------------------------------------//	･ SetActiveSND															[public]// -------------------------------------------------------------------------------------------------voidCSystem::SetActiveSND(Boolean inFlag){	if (!inFlag) {		mTagSOUND->stop(nil);	}	mTagSOUND->setActive(inFlag);}// -------------------------------------------------------------------------------------------------//	･ GetVolumeSND															[public]// -------------------------------------------------------------------------------------------------intCSystem::GetVolumeSND(void){	return mTagSOUND->getVolume();}// -------------------------------------------------------------------------------------------------//	･ SetVolumeSND															[public]// -------------------------------------------------------------------------------------------------voidCSystem::SetVolumeSND(int inVol){	mTagSOUND->setVolume(inVol);}// -------------------------------------------------------------------------------------------------//	･ GetAntiAlias															[public]// -------------------------------------------------------------------------------------------------BooleanCSystem::GetAntiAlias(void){	return	mGraphics->GetAntiAlias();}// -------------------------------------------------------------------------------------------------//	･ SetAntiAlias															[public]// -------------------------------------------------------------------------------------------------voidCSystem::SetAntiAlias(Boolean inFlag){	mGraphics->SetAntiAlias(inFlag);}