													[protected, virtual]// -------------------------------------------------------------------------------------------------voidCCMWindowAttachment::PopulateMenu(	MenuHandle	inMenuH){	LCMAttachment::PopulateMenu(inMenuH);		for (SInt16 i = 1; i <= ::CountMenuItems(inMenuH); i++) {		LStr255 menuText;		::GetMenuItemText(inMenuH, i, menuText);		if (::EqualString( menuText, StringLiteral_("Close"), false, false)) {			menuText += StringLiteral_(" Window");			::SetMenuItemText(inMenuH, i, menuText);		}	}		/* And to show a few other things: */		// Add a divider line	AddCommand(inMenuH, cmd_Nothing);		// A command not already in the menu bar	AddCommand(inMenuH, cmd_OpenBook,    StringLiteral_("本を開く"));	AddCommand(inMenuH, cmd_Nothing);	AddCommand(inMenuH, cmd_NextChioce,  StringLiteral_("次の選択肢まで進む"));	AddCommand(inMenuH, cmd_EraseWindow, StringLiteral_("ウィンドウを消す"));//	AddCommand(inMenuH, cmd_SaveStatus,  StringLiteral_("現在のしおりへセーブ"));//	AddCommand(inMenuH, cmd_LoadStatus,  StringLiteral_("現在のしおりからロード"));//	AddCommand(inMenuH, cmd_MangStatus,  StringLiteral_("しおりの整理"));	AddCommand(inMenuH, cmd_Nothing);	AddCommand(inMenuH, cmd_Preference,  StringLiteral_("設定"));//	AddCommand(inMenuH, cmd_SaveScreen,  StringLiteral_("画像を保存"));	// Add a submenu	DisposeSubMenu();	SInt16		subID = 200;	mSubMenuH = LMenu::MakeNewMacMenu(subID, Str_Empty, false);	if (mSubMenuH) {		AddCommand(inMenuH,   cmd_ScreenMode,     StringLiteral_("画面"));		AddCommand(mSubMenuH, cmd_ScreenModeFull, StringLiteral_("フルスクリーン"));		AddCommand(mSubMenuH, cmd_ScreenModeWind, StringLiteral_("ウィンドウ"));		::MacInsertMenu(mSubMenuH, hierMenu);		::SetMenuItemHierarchicalID(inMenuH, ::CountMenuItems(inMenuH), subID);	}//	AddCommand(inMenuH, cmd_Nothing);//	AddCommand(inMenuH, cmd_System,      StringLiteral_("システム"));//	AddCommand(inMenuH, cmd_Internet,    StringLiteral_("インターネット"));//	AddCommand(inMenuH, cmd_Language,    StringLiteral_("Language"));	AddCommand(inMenuH, cmd_Nothing);	AddCommand(inMenuH, cmd_Quit,        StringLiteral_("終了"));}// -------------------------------------------------------------------------------------------------//	･ DiposeSubMenu															[protected]// -------------------------------------------------------------------------------------------------voidCCMWindowAttachment::DisposeSubMenu(){	if (mSubMenuH != nil) {		::MacDeleteMenu((*mSubMenuH)->menuID);		::DisposeMenu(mSubMenuH);		mSubMenuH = nil;	}}