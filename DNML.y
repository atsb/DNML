en	K_HEIGHT%token	K_HREF%token	K_LEFT%token	K_LOOP%token	K_MODE%token	K_NAME%token	K_PUT%token	K_SHUT%token	K_SIZE%token	K_SKIP%token	K_SRC%token	K_STOP%token	K_SUBFOLDER%token	K_TEXT%token	K_TIME%token	K_TOP%token	K_TRANSPARENT%token	K_TYPE%token	K_VALIGN%token	K_VALUE%token	K_VIEW%token	K_WAIT%token	K_WIDTH%token	K_AUTHOR%token	K_TITLE%token	K_MAIL%token	K_HOMEPAGE%token	K_DATE%token	K_COMMENT%token	K_GENRE%type	<name>	align_key%type	<name>	alpha_key%type	<name>	alt_key%type	<name>	answer_key%type	<name>	author_key%type	<name>	back_key%type	<name>	character_key%type	<name>	color_key%type	<name>	comment_key%type	<name>	date_key%type	<name>	dest_key%type	<name>	effect_key%type	<name>	enable_key%type	<name>	face_key%type	<name>	fade_key%type	<name>	folder_key%type	<name>	genre_key%type	<name>	height_key%type	<name>	homepage_key%type	<name>	href_key%type	<name>	left_key%type	<name>	loop_key%type	<name>	mail_key%type	<name>	mode_key%type	<name>	name_key%type	<name>	put_key%type	<name>	shut_key%type	<name>	size_key%type	<name>	skip_key%type	<name>	src_key%type	<name>	subfolder_key%type	<name>	text_key%type	<name>	time_key%type	<name>	title_key%type	<name>	top_key%type	<name>	transparent_key%type	<name>	type_key%type	<name>	valign_key%type	<name>	value_key%type	<name>	view_key%type	<name>	wait_key%type	<name>	width_key%type	<name>	STR%type	<name>	TEXT%type	<name>	CARD%%dtml_statement		:	/* empty */					|	dtml_statement a_href_def					|	dtml_statement a_name_def					|	dtml_statement act_def					|	dtml_statement alias_def					|	dtml_statement alias_e_def					|	dtml_statement b_def					|	dtml_statement b_e_def					|	dtml_statement background_def					|	dtml_statement bgm_def					|	dtml_statement bgm_e_def					|	dtml_statement bookmark_def					|	dtml_statement br_def					|	dtml_statement card_def					|	dtml_statement clip_def					|	dtml_statement clip_e_def					|	dtml_statement command_def					|	dtml_statement cover_def					|	dtml_statement cursor_def					|	dtml_statement curtain_def					|	dtml_statement curtain_e_def					|	dtml_statement end_def					|	dtml_statement enter_def					|	dtml_statement event_def					|	dtml_statement event_e_def					|	dtml_statement exit_def					|	dtml_statement font_def					|	dtml_statement font_e_def					|	dtml_statement form_def					|	dtml_statement form_e_def					|	dtml_statement i_def					|	dtml_statement i_e_def					|	dtml_statement icon_def					|	dtml_statement icon_e_def					|	dtml_statement include_def					|	dtml_statement indent_def					|	dtml_statement indent_e_def					|	dtml_statement input_def					|	dtml_statement kick_def					|	dtml_statement memo_def					|	dtml_statement newline_def					|	dtml_statement newpage_def					|	dtml_statement p_def					|	dtml_statement play_def					|	dtml_statement play_e_def					|	dtml_statement plugin_def					|	dtml_statement position_def					|	dtml_statement question_def					|	dtml_statement record_def					|	dtml_statement record_e_def					|	dtml_statement s_def					|	dtml_statement s_e_def					|	dtml_statement screen_def					|	dtml_statement shadow_def					|	dtml_statement shadow_e_def					|	dtml_statement snap_def					|	dtml_statement sound_def					|	dtml_statement sound_e_def					|	dtml_statement space_def					|	dtml_statement stage_def					|	dtml_statement sunglass_def					|	dtml_statement sunglass_e_def					|	dtml_statement timer_def					|	dtml_statement title_def					|	dtml_statement trap_def					|	dtml_statement u_def					|	dtml_statement u_e_def					|	dtml_statement w_def					|	dtml_statement wait_def					|	dtml_statement wait_e_def					|	dtml_statement window_def					|	dtml_statement window_e_def					|	dtml_statement write_def					|	dtml_statement text_string					|	dtml_statement card_string					|	dtml_statement error					;					text_string			:	TEXT						{  // fprintf(stderr, "text:[\n%s\n]\n", $1);							if (strcmp($1, "")) {								StrText		*tag = new StrText();								tag->tagType     = TEXT;								tag->string_data = new string($1);								curTag = (TagBasic*)tag;								tagArray->AddItem(&curTag, sizeof(TagBasic*));							}						}					;					card_string			:	CARD						{ // fprintf(stderr, "text:[\n%s\n]\n", $1);							StrCard		*tag = new StrCard();							tag->tagType     = CARD;							tag->card_name = new string($1);							curTag = (TagBasic*)tag;							tagArray->AddItem(&curTag, sizeof(TagBasic*));						}					;					a_href_def			:	LP T_A a_href_param RP						{ // fprintf(stderr, "a->                :\n");							tagArray->AddItem(&curTag, sizeof(TagBasic*));						}					;a_href_param		:	/* empty */						{							TagA		*tag = new TagA();							tag->tagType = T_A;							curTag = (TagBasic*)tag;						}					|	a_href_param href_key						{ // fprintf(stderr, "a->href            :[%s]\n", $2);							TagA		*tag = (TagA*)curTag;							if (tag->k_href) {								delete tag->k_href;							}							tag->k_href = new string($2);						}					|	a_href_param alt_key						{ // fprintf(stderr, "a->alt             :[%s]\n", $2);							TagA		*tag = (TagA*)curTag;							if (tag->k_alt) {								delete tag->k_alt;							}							tag->k_alt = new string($2);						}					|	a_href_param answer_key						{ // fprintf(stderr, "a->answer          :[%s]\n", $2);							TagA		*tag = (TagA*)curTag;							if (tag->k_answer) {								delete tag->k_answer;							}							tag->k_answer = new string($2);						}					|	a_href_param view_key						{ // fprintf(stderr, "a->view            :[%s]\n", $2);							TagA		*tag = (TagA*)curTag;							if (tag->k_view) {								delete tag->k_view;							}							tag->k_view = new string($2);						}					|	a_href_param enable_key						{ // fprintf(stderr, "a->enable          :[%s]\n", $2);							TagA		*tag = (TagA*)curTag;							if (tag->k_enable) {								delete tag->k_enable;							}							tag->k_enable = new string($2);						}					|	a_href_param error					;a_name_def			:	LP T_A name_key RP						{ // fprintf(stderr, "a_name->name       :[%2]\n", $3);							TagAct		*tag = new TagAct();							tag->tagType = T_A;							tag->k_name  = new string($3);							curTag = (TagBasic*)tag;							tagArray->AddItem(&curTag, sizeof(TagBasic*));						}					;					act_def				:	LP T_ACT act_param RP						{ // fprintf(stderr, "act->              :\n");							tagArray->AddItem(&curTag, sizeof(TagBasic*));						}					;act_param			:	/* empty */						{							TagAct		*tag = new TagAct();							tag->tagType = T_ACT;							curTag = (TagBasic*)tag;						}					|	act_param name_key						{ // fprintf(stderr, "act->name          :[%s]\n", $2);							TagAct		*tag = (TagAct*)curTag;							if (tag->k_name) {								delete tag->k_name;							}							tag->k_name = new string($2);						}					|	act_param src_key						{ // fprintf(stderr, "act->src           :[%s]\n", $2);							TagAct		*tag = (TagAct*)curTag;							if (tag->k_src) {								delete tag->k_src;							}							tag->k_src = new string($2);						}					|	act_param folder_key						{ // fprintf(stderr, "act->folder        :[%s]\n", $2);							TagAct		*tag = (TagAct*)curTag;							if (tag->k_folder) {								delete tag->k_folder;							}							tag->k_folder = new string($2);						}					|	act_param mode_key						{ // fprintf(stderr, "act->mode          :[%s]\n", $2);							TagAct		*tag = (TagAct*)curTag;							if (tag->k_mode) {								delete tag->k_mode;							}							tag->k_mode = new string($2);						}					|	act_param top_key						{ // fprintf(stderr, "act->top           :[%s]\n", $2);							TagAct		*tag = (TagAct*)curTag;							if (tag->k_top) {								delete tag->k_top;							}							tag->k_top = new string($2);						}					|	act_param left_key						{ // fprintf(stderr, "act->left          :[%s]\n", $2);							TagAct		*tag = (TagAct*)curTag;							if (tag->k_left) {								delete tag->k_left;							}							tag->k_left = new string($2);						}					|	act_param width_key						{ // fprintf(stderr, "act->width         :[%s]\n", $2);							TagAct		*tag = (TagAct*)curTag;							if (tag->k_width) {								delete tag->k_width;							}							tag->k_width = new string($2);						}					|	act_param height_key						{ // fprintf(stderr, "act->height        :[%s]\n", $2);							TagAct		*tag = (TagAct*)curTag;							if (tag->k_height) {								delete tag->k_height;							}							tag->k_height = new string($2);						}					|	act_param effect_key						{ // fprintf(stderr, "act->effect        :[%s]\n", $2);							TagAct		*tag = (TagAct*)curTag;							if (tag->k_effect) {								delete tag->k_effect;							}							tag->k_effect = new string($2);						}					|	act_param alpha_key						{ // fprintf(stderr, "act->alpha         :[%s]\n", $2);							TagAct		*tag = (TagAct*)curTag;							if (tag->k_alpha) {								delete tag->k_alpha;							}							tag->k_alpha = new string($2);						}					|	act_param subfolder_key						{ // fprintf(stderr, "act->subfolder     :[%s]\n", $2);							TagAct		*tag = (TagAct*)curTag;							if (tag->k_subfolder) {								delete tag->k_subfolder;							}							tag->k_subfolder = new string($2);						}					|	act_param transparent_key						{ // fprintf(stderr, "act->transparent   :[%s]\n", $2);							TagAct		*tag = (TagAct*)curTag;							if (tag->k_transparent) {								delete tag->k_transparent;							}							tag->k_transparent = new string($2);						}					|	act_param put_key						{ // fprintf(stderr, "act->put           :\n");							TagAct		*tag = (TagAct*)curTag;							if (tag->k_put) {								delete tag->k_put;							}							tag->k_put = new string($2);						}					|	act_param error					;					alias_def			:	LP T_ALIAS alias_param RP						{ // fprintf(stderr, "alias->            :\n");							tagArray->AddItem(&curTag, sizeof(TagBasic*));						}					;alias_param			:	/* empty */						{							TagAlias	*tag = new TagAlias();							tag->tagType = T_ALIAS;							curTag = (TagBasic*)tag;						}					|	alias_param src_key						{ // fprintf(stderr, "alias->src         :[%s]\n", $2);							TagAlias	*tag = (TagAlias*)curTag;							if (tag->k_src) {								delete tag->k_src;							}							tag->k_src = new string($2);						}					|	alias_param dest_key						{ // fprintf(stderr, "alias->dest        :[%s]\n", $2);							TagAlias	*tag = (TagAlias*)curTag;							if (tag->k_dest) {								delete tag->k_dest;							}							tag->k_dest = new string($2);						}					|	alias_param error					;					alias_e_def			:	LP T_ALIAS_E src_key RP						{ // fprintf(stderr, "/alias->name       :[%s]\n", $3);							TagEAlias	*tag = new TagEAlias();							tag->tagType = T_ALIAS_E;							tag->k_src   = new string($3);							curTag = (TagBasic*)tag;							tagArray->AddItem(&curTag, sizeof(TagBasic*));						}					;				b_def				:	LP T_B RP						{ // fprintf(stderr, "b->                :\n");							TagB		*tag = new TagB();							tag->tagType = T_B;							curTag = (TagBasic*)tag;							tagArray->AddItem(&curTag, sizeof(TagBasic*));						}					;				b_e_def				:	LP T_B_E RP						{ // fprintf(stderr, "/b->               :\n");							TagEB		*tag = new TagEB();							tag->tagType = T_B_E;							curTag = (TagBasic*)tag;							tagArray->AddItem(&curTag, sizeof(TagBasic*));						}					;background_def		:	LP T_BACKGROUND background_param RP						{ // fprintf(stderr, "background->       :\n");							tagArray->AddItem(&curTag, sizeof(TagBasic*));						}					;background_param	:	/* empty */						{							TagBackground	*tag = new TagBackground();							tag->tagType = T_BACKGROUND;							curTag = (TagBasic*)tag;						}					|	background_param color_key						{ // fprintf(stderr, "background->color      :[%s]\n", $2);							TagBackground	*tag = (TagBackground*)curTag;							if (tag->k_color) {								delete tag->k_color;							}	