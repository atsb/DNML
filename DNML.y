gEIndent*)btag);				break;			case T_INPUT:				delete ((TagInput*)btag);				break;			case T_KICK:				delete ((TagKick*)btag);				break;			case T_MEMO:				delete ((TagMemo*)btag);				break;			case T_NL:				delete ((TagNewline*)btag);				break;			case T_NP:				delete ((TagNewpage*)btag);				break;			case T_P:				delete ((TagP*)btag);				break;			case T_PLAY:				delete ((TagPlay*)btag);				break;			case T_PLAY_E:				delete ((TagEPlay*)btag);				break;			case T_PLUGIN:				delete ((TagPlugin*)btag);				break;			case T_POSITION:				delete ((TagPosition*)btag);				break;			case T_QUESTION:				delete ((TagQuestion*)btag);				break;			case T_RECORD:				delete ((TagRecord*)btag);				break;			case T_RECORD_E:				delete ((TagERecord*)btag);				break;			case T_S:				delete ((TagS*)btag);				break;			case T_S_E:				delete ((TagES*)btag);				break;			case T_SCREEN:				delete ((TagScreen*)btag);				break;			case T_SHADOW:				delete ((TagShadow*)btag);				break;			case T_SHADOW_E:				delete ((TagEShadow*)btag);				break;			case T_SNAP:				delete ((TagSnap*)btag);				break;			case T_SOUND:				delete ((TagSound*)btag);				break;			case T_SOUND_E:				delete ((TagESound*)btag);				break;			case T_SPACE:				delete ((TagSpace*)btag);				break;			case T_STAGE:				delete ((TagStage*)btag);				break;			case T_SUNGLASS:				delete ((TagSunglass*)btag);				break;			case T_SUNGLASS_E:				delete ((TagESunglass*)btag);				break;			case T_TIMER:				delete ((TagTimer*)btag);				break;			case T_TITLE:				delete ((TagTitle*)btag);				break;			case T_TRAP:				delete ((TagTrap*)btag);				break;			case T_U:				delete ((TagU*)btag);				break;			case T_U_E:				delete ((TagEU*)btag);				break;			case T_W:				delete ((TagW*)btag);				break;			case T_WAIT:				delete ((TagWait*)btag);				break;			case T_WAIT_E:				delete ((TagEWait*)btag);				break;			case T_WINDOW:				delete ((TagWindow*)btag);				break;			c