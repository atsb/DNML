// =================================================================================================//	CDnmlApp.cp//		DNML for Macintosh メイン処理////	Copyright 2001, A.Iisaka// =================================================================================================#include "CDnmlApp.h"#include <LGrowZone.h>#include <LWindow.h>#include <LDialogBox.h>#include <LPushButton.h>#include <LSlider.h>#include <LCheckBox.h>#include <LRadioGroup.h>#include <PP_Messages.h>#include <PP_Resources.h>#include <UDrawingState.h>#include <UMemoryMgr.h>#include <URegistrar.h>#include <UEnvironment.h>#include <UControlRegistry.h>#include <LPreferencesFile.h>#include <LCMAttachment.h>#include <UCMMUtils.h>#include <UConditionalDialogs.h>#include <Appearance.h>#include <Timer.h>#include <OSAGeneric.h>#include "CGameWindow.h"#include "CCMWindowAttachment.h"typedef	struct	{	FSSpec		spec;	DInfo		dinf;}	DeskInfoRec, *DeskInfoPtr;// =================================================================================================//	･ main// =================================================================================================int main(){								// Set Debugging options	SetDebugThrow_(debugAction_Alert);	SetDebugSignal_(debugAction_Alert);	// Initialize Memory Manager. Parameter is the number of	// master pointer blocks to allocate	InitializeHeap(3);		// Initialize standard Toolbox managers	UQDGlobals::InitializeToolbox(&qd);		// Initialize Contextual Menu support	UCMMUtils::Initialize();	// Install a GrowZone to catch low-memory situations		new LGrowZone(20000);	// Create the application object and run	CDnmlApp	theApp;	theApp.Run();		return 0;}// -------------------------------------------------------------------------------------------------//	･ CDnmlApp																[public]// -------------------------------------------------------------------------------------------------CDnmlApp::CDnmlApp(){	// Register ourselves with the Appearance Manager	if (UEnvironment::HasFeature(env_HasAppearance)) {		::RegisterAppearanceClient();	}	RegisterClasses();	mSleepTime = 0;		AddAttachment(new LCMAttachment);	EnterMovies();	GetPreset();	if (ScriptInit()) {		mDesktopInfo = new LArray(sizeof(DeskInfoRec));		GetDesktop();	} else {		mDesktopInfo = nil;	}	mSystem    = nil;	mStartDNML = false;}// -------------------------------------------------------------------------------------------------//	･ ~CDnmlApp																[public, virtual]// -------------------------------------------------------------------------------------------------CDnmlApp::~CDnmlApp(){	PutPreset();		if (mDesktopInfo) {		PutDesktop();		delete mDesktopInfo;	}	if (mSystem)		delete mSystem;	ExitMovies();}// -------------------------------------------------------------------------------------------------//	･ StartUp																[protected, virtual]// -------------------------------------------------------------------------------------------------voidCDnmlApp::StartUp(){	CGameWindow	*theGameWindow = dynamic_cast<CGameWindow*>(LWindow::CreateWindow(PPob_GameWindow, this));	ThrowIfNil_(theGameWindow);	theGameWindow->SetScreenSize(640, 480);	theGameWindow->SetFullScreen(mPreset.fullScreen);	theGameWindow->Show();}// -------------------------------------------------------------------------------------------------//	･ ObeyCommand															[public, virtual]// -------------------------------------------------------------------------------------------------BooleanCDnmlApp::ObeyCommand(	CommandT	inCommand,	void*		ioParam){	Boolean		cmdHandled = true;	CGameWindow	*theWindow = dynamic_cast<CGameWindow*>(LWindow::FindWindowByID(PPob_GameWindow));	switch (inCommand) {		case cmd_OpenBook:	{						// 本を開く			FSSpec		theSpec;			char		fileName[256];			Boolean		savStartDNML;						savStartDNML = mStartDNML;			mStartDNML   = false;			if (UConditionalDialogs::AskChooseOneFile('TEXT', theSpec, 0)) {				theWindow->SetSystem(nil);				if (mSystem) {					mSystem->DnmlTaskEnd();					delete mSystem;				}				CreateFullPath(theSpec, fileName, true);				if ((mSystem = new CSystem(fileName, &mPreset)) != nil) {					theWindow->SetSystem(mSystem);					mStartDNML = true;				}			} else {				mStartDNML = savStartDNML;			}			break;		}		case cmd_NextChioce: {			if (mSystem) {				mSystem->SetSkipStatus();			}			break;		}				case cmd_EraseWindow: {			if (mSystem) {				mSystem->SwitchText();			}			break;		}				case cmd_Preference: {						// 設定			StDialogHandler	theHandler(PPob_Preference, nil);			LWindow			*theDialog = theHandler.GetDialog();			ThrowIfNil_(theDialog);			PresetRec		bakPreset;						memcpy(&bakPreset, &mPreset, sizeof(PresetRec));						LPushButton	*theDetail = dynamic_cast<LPushButton*>(theDialog->FindPaneByID(402));			LPushButton	*theReturn = dynamic_cast<LPushButton*>(theDialog->FindPaneByID(403));			LSlider		*theTextLS = dynamic_cast<LSlider*>(theDialog->FindPaneByID(11));			LSlider		*theCharLS = dynamic_cast<LSlider*>(theDialog->FindPaneByID(21));			LSlider		*theBackLS = dynamic_cast<LSlider*>(theDialog->FindPaneByID(31));			LSlider		*theWakuLS = dynamic_cast<LSlider*>(theDialog->FindPaneByID(41));			LSlider		*theBlghtL = dynamic_cast<LSlider*>(theDialog->FindPaneByID(51));			LCheckBox	*theTextCB = dynamic_cast<LCheckBox*>(theDialog->FindPaneByID(10));			LCheckBox	*theCharCB = dynamic_cast<LCheckBox*>(theDialog->FindPaneByID(20));			LCheckBox	*theBackCB = dynamic_cast<LCheckBox*>(theDialog->FindPaneByID(30));			LCheckBox	*theWakuCB = dynamic_cast<LCheckBox*>(theDialog->FindPaneByID(40));			LCheckBox	*theBlghtC = dynamic_cast<LCheckBox*>(theDialog->FindPaneByID(50));			LCheckBox	*theBgmCB  = dynamic_cast<LCheckBox*>(theDialog->FindPaneByID(60));			LCheckBox	*theSndCB  = dynamic_cast<LCheckBox*>(theDialog->FindPaneByID(70));			LSlider		*theBgmLS  = dynamic_cast<LSlider*>(theDialog->FindPaneByID(84));			LSlider		*theSndLS  = dynamic_cast<LSlider*>(theDialog->FindPaneByID(85));			LCheckBox	*theAlisCB = dynamic_cast<LCheckBox*>(theDialog->FindPaneByID(81));			LCheckBox	*theProgCB = dynamic_cast<LCheckBox*>(theDialog->FindPaneByID(82));			LCheckBox	*theGrafCB = dynamic_cast<LCheckBox*>(theDialog->FindPaneByID(83));			LSlider		*theJpegLS = dynamic_cast<LSlider*>(theDialog->FindPaneByID(86));			theDetail->Show();			theReturn->Hide();						if (mSystem) {				// 動的に変更が必要な項目				bakPreset.textSpeed = mSystem->GetTimeTEXT();				bakPreset.charSpeed = mSystem->GetTimeCHAR();				bakPreset.backSpeed = mSystem->GetTimeBACK();				bakPreset.wakuSpeed = mSystem->GetTimeWAKU();				bakPreset.bgmActive = mSystem->GetActiveBGM();				bakPreset.sndActive = mSystem->GetActiveSND();				bakPreset.bgmVolume = mSystem->GetVolumeBGM();				bakPreset.sndVolume = mSystem->GetVolumeSND();				bakPreset.antiAlias = mSystem->GetAntiAlias();			}			theTextLS->SetValue(bakPreset.textSpeed);			theCharLS->SetValue(bakPreset.charSpeed);			theBackLS->SetValue(bakPreset.backSpeed);			theWakuLS->SetValue(bakPreset.wakuSpeed);			theBlghtL->SetValue(bakPreset.blgtSpeed);			theTextCB->SetValue((bakPreset.textDisable)   ? 1 : 0);			theCharCB->SetValue((bakPreset.charDisable)   ? 1 : 0);			theBackCB->SetValue((bakPreset.backDisable)   ? 1 : 0);			theWakuCB->SetValue((bakPreset.wakuDisable)   ? 1 : 0);			theBlghtC->SetValue((bakPreset.blgtDisable)   ? 1 : 0);			theBgmCB->SetValue((bakPreset.bgmActive)      ? 1 : 0);			theSndCB->SetValue((bakPreset.sndActive)      ? 1 : 0);			theBgmLS->SetValue(bakPreset.bgmVolume);			theSndLS->SetValue(bakPreset.sndVolume);			theAlisCB->SetValue((bakPreset.antiAlias)     ? 1 : 0);			theProgCB->SetValue((bakPreset.extProgActive) ? 1 : 0);			theGrafCB->SetValue((bakPreset.readGraphics)  ? 1 : 0);			theJpegLS->SetValue(bakPreset.jpegQuality);						theDialog->Show();			while (true) {				MessageT	hitMessage = theHandler.DoDialog();				if (hitMessage == msg_OK) {			// ＯＫ					bakPreset.textSpeed     = theTextLS->GetValue();					bakPreset.charSpeed     = theCharLS->GetValue();					bakPreset.backSpeed     = theBackLS->GetValue();					bakPreset.wakuSpeed     = theWakuLS->GetValue();					bakPreset.blgtSpeed     = theBlghtL->GetValue();					bakPreset.textDisable   = (theTextCB->GetValue()) ? true : false;					bakPreset.charDisable   = (theCharCB->GetValue()) ? true : false;					bakPreset.backDisable   = (theBackCB->GetValue()) ? true : false;					bakPreset.wakuDisable   = (theWakuCB->GetValue()) ? true : false;					bakPreset.blgtDisable   = (theBlghtC->GetValue()) ? true : false;					bakPreset.bgmActive     = (theBgmCB->GetValue())  ? true : false;					bakPreset.sndActive     = (theSndCB->GetValue())  ? true : false;					bakPreset.bgmVolume     = theBgmLS->GetValue();					bakPreset.sndVolume     = theSndLS->GetValue();					bakPreset.antiAlias     = (theAlisCB->GetValue()) ? true : false;					bakPreset.extProgActive = (theProgCB->GetValue()) ? true : false;					bakPreset.readGraphics  = (theGrafCB->GetValue()) ? true : false;					bakPreset.jpegQuality   = theJpegLS->GetValue();					if (mSystem) {						// 動的に変更が必要な項目						mSystem->SetTimeTEXT(bakPreset.textSpeed);						mSystem->SetTimeCHAR(bakPreset.charSpeed);						mSystem->SetTimeBACK(bakPreset.backSpeed);						mSystem->SetTimeWAKU(bakPreset.wakuSpeed);						mSystem->SetActiveBGM(bakPreset.bgmActive);						mSystem->SetActiveSND(bakPreset.sndActive);						mSystem->SetVolumeBGM(bakPreset.bgmVolume);						mSystem->SetVolumeSND(bakPreset.sndVolume);						mSystem->SetAntiAlias(bakPreset.antiAlias);					}					memcpy(&mPreset, &bakPreset, sizeof(PresetRec));					PutPreset();					break;				} else				if (hitMessage == msg_Cancel) {		// キャンセル					break;				} else				if (hitMessage == 402) {			// 詳細					theDialog->ResizeWindowTo(497, 257);					theDialog->MoveWindowBy(-99, 0);					theDetail->Hide();					theReturn->Show();				} else				if (hitMessage == 403) {			// 戻る					theDialog->ResizeWindowTo(299, 257);					theDialog->MoveWindowBy(99, 0);					theDetail->Show();					theReturn->Hide();				}			}			break;		}				case cmd_ScreenModeFull: {					// 画面（フルスクリーン）			mPreset.fullScreen = true;			if (theWindow != nil) {				theWindow->SetFullScreen(true);			}			if (mSystem) {				mSystem->UpdateWindow();			}			break;		}				case cmd_ScreenModeWind: {					// 画面（ウィンドウ）			if (theWindow != nil) {				theWindow->SetFullScreen(false);				ShowMenuBar();				if (mSystem) {					mSystem->UpdateWindow();				}			}			mPreset.fullScreen = false;			break;		}		default: {			if (inCommand == cmd_Quit) {				if (mSystem) {					mSystem->DnmlTaskEnd();					delete mSystem;					mSystem    = nil;					mStartDNML = false;				}			}			cmdHandled = LApplication::ObeyCommand(inCommand, ioParam);			break;		}	}		return cmdHandled;}// -------------------------------------------------------------------------------------------------//	･ FindCommandStatus														[public, virtual]// -------------------------------------------------------------------------------------------------voidCDnmlApp::FindCommandStatus(	CommandT	inCommand,	Boolean&	outEnabled,	Boolean&	outUsesMark,	UInt16&		outMark,	Str255		outName){	switch (inCommand) {		case cmd_OpenBook:		case cmd_NextChioce:		case cmd_EraseWindow:		case cmd_Preference:		case cmd_ScreenMode:		case cmd_ScreenModeFull:		case cmd_ScreenModeWind: {			outEnabled = true;			break;		}		case cmd_SaveStatus:		case cmd_LoadStatus:		case cmd_MangStatus:		case cmd_SaveScreen:		case cmd_System:		case cmd_Internet:		case cmd_Language: {			outEnabled = false;			break;		}		default: {			LApplication::FindCommandStatus(inCommand, outEnabled,											outUsesMark, outMark, outName);			break;		}	}}// -------------------------------------------------------------------------------------------------//	･ RegisterClasses														[protected]// -------------------------------------------------------------------------------------------------voidCDnmlApp::RegisterClasses(){	// Register core PowerPlant classes.	RegisterClass_(LWindow);	RegisterClass_(LDialogBox);	RegisterClass_(LPushButton);	RegisterClass_(LSlider);	RegisterClass_(LCheckBox);	RegisterClass_(LRadioGroup);	// Register other PowerPlant classes.	RegisterClass_(LCMAttachment);	// Register user classes.	RegisterClass_(CGameWindow);	RegisterClass_(CCMWindowAttachment);		UControlRegistry::RegisterClasses();}// -------------------------------------------------------------------------------------------------//	･ UseIdleTime															[protected]// -------------------------------------------------------------------------------------------------voidCDnmlApp::UseIdleTime(	const EventRecord&	inMacEvent ){	if (mSystem && mStartDNML) {		Point		pt = {0,0};		if (!mSystem->DnmlTask(pt, false)) {			CGameWindow	*theWindow = dynamic_cast<CGameWindow*>(LWindow::FindWindowByID(PPob_GameWindow));			theWindow->SetSystem(nil);			mSystem->DnmlTaskEnd();			delete mSystem;			mSystem = nil;		}	}	LApplication::UseIdleTime(inMacEvent);}// -------------------------------------------------------------------------------------------------//	･ HandleAppleEvent														[protected]// -------------------------------------------------------------------------------------------------voidCDnmlApp::HandleAppleEvent(	const AppleEvent&	inAppleEvent,	AppleEvent&			outAEReply,	AEDesc&				outResult,	SInt32				inAENumber){	if (inAENumber == ae_OpenDoc) {		AEDescList	docList;		OSErr		err = AEGetParamDesc(&inAppleEvent,								keyDirectObject, typeWildCard, &docList);		if (err != noErr) Throw_(err);			SInt32	numDocs;		err = AECountItems(&docList, &numDocs);		if (err != noErr) Throw_(err);		AEKeyword	theKey;		DescType	theType;		FSSpec		theFileSpec;		Size		theSize;		err = AEGetNthPtr(&docList, 1, typeFSS, &theKey, &theType,							(Ptr) &theFileSpec, sizeof(FSSpec), &theSize);		if (err != noErr) Throw_(err);				// check file type		FInfo	finf;		if (FSpGetFInfo(&theFileSpec, &finf) == noErr) {			if (finf.fdType == 'TEXT') {				// open document				CGameWindow	*theWindow = dynamic_cast<CGameWindow*>(LWindow::FindWindowByID(PPob_GameWindow));				if (theWindow == nil) {					theWindow = dynamic_cast<CGameWindow*>(LWindow::CreateWindow(PPob_GameWindow, this));					ThrowIfNil_(theWindow);					theWindow->SetScreenSize(640, 480);					theWindow->SetFullScreen(mPreset.fullScreen);					theWindow->Show();				} else {					theWindow->SetSystem(nil);					if (mSystem) {						mSystem->DnmlTaskEnd();						delete mSystem;					}				}				char		fileName[256];				CreateFullPath(theFileSpec, fileName, true);				mSystem = new CSystem(fileName, &mPreset);				ThrowIfNil_(mSystem);				theWindow->SetSystem(mSystem);				mStartDNML = true;			}		}		AEDisposeDesc(&docList);		SetUpdateCommandStatus(false);	} else {		LApplication::HandleAppleEvent(inAppleEvent, outAEReply, outResult, inAENumber);	}}// -------------------------------------------------------------------------------------------------//	･ GetPreset																[protected]// -------------------------------------------------------------------------------------------------voidCDnmlApp::GetPreset(void){	try {		LPreferencesFile	thePref("\pPrefDNML");		thePref.OpenOrCreateResourceFork(fsWrPerm, 'DNML', 'pref', smSystemScript);		StResource	theH('PSET', 128, false, true);		PresetPtr	*thePreset = reinterpret_cast<PresetPtr*>(Handle(theH));		if (thePreset != nil) {			memcpy(&mPreset, *thePreset, sizeof(PresetRec));		}	} catch (...) {		memset(&mPreset, '\0', sizeof(mPreset));		mPreset.fullScreen    = false;		mPreset.textSpeed     = 20;		mPreset.textDisable   = false;		mPreset.charSpeed     = 25;		mPreset.charDisable   = false;		mPreset.backSpeed     = 25;		mPreset.backDisable   = false;		mPreset.wakuSpeed     = 25;		mPreset.wakuDisable   = false;		mPreset.blgtSpeed     = 0;		mPreset.blgtDisable   = false;		mPreset.bgmActive     = true;		mPreset.sndActive     = true;		mPreset.antiAlias     = true;		mPreset.extProgActive = false;		mPreset.readGraphics  = true;		mPreset.bgmVolume     = 127;		mPreset.sndVolume     = 127;		mPreset.jpegQuality   = 70;		PutPreset();	}}// -------------------------------------------------------------------------------------------------//	･ PutPreset																[protected]// -------------------------------------------------------------------------------------------------voidCDnmlApp::PutPreset(void){	try {		LPreferencesFile	thePref("\pPrefDNML");		thePref.OpenOrCreateResourceFork(fsWrPerm, 'DNML', 'pref', smSystemScript);				Handle	theH = Get1Resource('PSET', 128);		if (theH != nil) {			RemoveResource(theH);		}				theH = NewHandle(sizeof(PresetRec));		ThrowIfNil_(theH);				**(reinterpret_cast<PresetPtr*>(theH)) = mPreset;		AddResource(theH, 'PSET', 128, "\p");		WriteResource(theH);	} catch (...) {		// empty	}}// -------------------------------------------------------------------------------------------------//	･ CreateFullPath														[protected]// -------------------------------------------------------------------------------------------------BooleanCDnmlApp::CreateFullPath(	FSSpec	inSpec,	char	*outFullPath,	Boolean	inFlag){	Boolean			ret = true;	Str255			pname;	CInfoPBRec		paramBlock;	OSErr			err;	char			tmpBuff[256], fname[128];	memset(fname, '\0', sizeof(fname));	memcpy(fname, inSpec.name, inSpec.name[0] + 1);	P2CStr((unsigned char *)fname);	strcpy(outFullPath, "");	for ( paramBlock.dirInfo.ioDrDirID = inSpec.parID; paramBlock.dirInfo.ioDrDirID != 1; ) {		paramBlock.dirInfo.ioCompletion = 0l;		paramBlock.dirInfo.ioNamePtr    = pname;		paramBlock.dirInfo.ioVRefNum    = inSpec.vRefNum;		paramBlock.dirInfo.ioFRefNum    = 0;		paramBlock.dirInfo.ioFDirIndex  = -1;		err = PBGetCatInfo(&paramBlock, false);		if ( err != noErr ) {			ret = false;			break;		}		memset(tmpBuff, '\0', sizeof(tmpBuff));		memcpy(tmpBuff, &pname[1], (Size)pname[0]);		strcat(tmpBuff, (inFlag) ? "/" : ":");		strcat(tmpBuff, outFullPath);		strcpy(outFullPath, tmpBuff);		paramBlock.dirInfo.ioDrDirID    = paramBlock.dirInfo.ioDrParID;		paramBlock.dirInfo.ioDrParID    = 0;	}	strcpy(tmpBuff, outFullPath);	sprintf(outFullPath, (inFlag) ? "/%s%s" : "%s%s", tmpBuff, fname);	return ret;}// -------------------------------------------------------------------------------------------------//	･ GetDesktop															[protected]// -------------------------------------------------------------------------------------------------voidCDnmlApp::GetDesktop(void){	CInfoPBRec		paramBlock;	DeskInfoRec		rec;	short			foundVRefNum, index;	long			foundDirID;	Str255			pname;	OSErr			err;		FindFolder(kOnSystemDisk, kDesktopFolderType, false, &foundVRefNum, &foundDirID);	for (index = 1; ; index++) {		memset(&paramBlock, '\0', sizeof(paramBlock));		paramBlock.dirInfo.ioCompletion = 0l;		paramBlock.dirInfo.ioNamePtr    = pname;		paramBlock.dirInfo.ioVRefNum    = foundVRefNum;		paramBlock.dirInfo.ioFRefNum    = 0;		paramBlock.dirInfo.ioFDirIndex  = index;		paramBlock.dirInfo.ioDrDirID    = foundDirID;		if ((err = PBGetCatInfo(&paramBlock, false)) != noErr) {			break;		}		rec.spec.vRefNum = paramBlock.dirInfo.ioVRefNum;		rec.spec.parID   = paramBlock.dirInfo.ioDrParID;		memcpy(rec.spec.name, pname, pname[0] + 1);		memcpy(&rec.dinf, &paramBlock.dirInfo.ioDrUsrWds, sizeof(DInfo));		mDesktopInfo->AddItem(&rec, sizeof(DeskInfoRec));	}}// -------------------------------------------------------------------------------------------------//	･ PutDesktop															[protected]// -------------------------------------------------------------------------------------------------voidCDnmlApp::PutDesktop(void){	FSSpec	check;	char	*templ = new char[256];	char	*scrpt = new char[256];	char	*fname = new char[256];		strcpy(templ, "tell application \"Finder\"\r");	strcat(templ, "set position of folder \"%s\" to {%d,%d}\r");	strcat(templ, "end tell\r");		for (int index = 1; index <= mDesktopInfo->GetCount(); index++) {		DeskInfoRec	*pb = (DeskInfoRec*)(mDesktopInfo->GetItemPtr(index));		if (FSMakeFSSpec(pb->spec.vRefNum, pb->spec.parID, pb->spec.name, &check) == noErr) {			CreateFullPath(pb->spec, fname, false);			sprintf(scrpt, templ, fname, pb->dinf.frLocation.h, pb->dinf.frLocation.v);			ProcessScript(scrpt);		}		if (!memcmp(&pb->spec.name[1], "問題連絡票", 10)) {			SysBeep(1);		}	}	delete[] fname;	delete[] scrpt;	delete[] templ;}// -------------------------------------------------------------------------------------------------//	･ ScriptInit															[protected]// -------------------------------------------------------------------------------------------------BooleanCDnmlApp::ScriptInit(void){	OSErr		err;		mGenericSC = OpenDefaultComponent(kOSAComponentType, kOSAGenericScriptingComponentSubtype);	if ((err = OSASetDefaultScriptingComponent(mGenericSC, kAppleScriptSubtype)) != noErr) {		mGenericSC = nil;	}	return (err == noErr) ? true : false;}// -------------------------------------------------------------------------------------------------//	･ ProcessScript															[protected]// -------------------------------------------------------------------------------------------------voidCDnmlApp::ProcessScript(	char				*inScript){	OSAID		scriptID;	short		startRange = 0, endRange = 0;	Str255		pscript;		if (mGenericSC == nil || strlen(inScript) >= 256) {		return;	}	strcpy((char *)pscript, inScript);	C2PStr((char *)pscript);		scriptID = kOSANullScript;	if (CompileScript(pscript, &scriptID, &startRange, &endRange)) {		ExecuteScript(scriptID, &startRange, &endRange);	}}// -------------------------------------------------------------------------------------------------//	･ CompileScript															[protected]// -------------------------------------------------------------------------------------------------BooleanCDnmlApp::CompileScript(	Str255				scriptStr,	OSAID				*scriptIDPtr,	short				*startRangePtr,	short				*endRangePtr){	OSAError	errOSA;	AEDesc		errorDesc = {typeNull, NULL};	AEDesc		textDesc  = {typeNull, NULL};		if (mGenericSC == nil) {		return false;	}	if (AECreateDesc( typeChar, &scriptStr[ 1 ], scriptStr[ 0 ], &textDesc ) != noErr) {		return false;	}		errOSA = OSACompile(mGenericSC, &textDesc, kOSAModeAlwaysInteract, scriptIDPtr );	AEDisposeDesc( &textDesc );		if (errOSA == errOSAScriptError) {		errOSA = OSAScriptError(mGenericSC, kOSAErrorRange, typeOSAErrorRange, &errorDesc);		AEDisposeDesc( &errorDesc );		return false;	} else	if (errOSA != noErr) {		return false;	}	return true;}// -------------------------------------------------------------------------------------------------//	･ ExecuteScript															[protected]// -------------------------------------------------------------------------------------------------BooleanCDnmlApp::ExecuteScript(	OSAID				scriptID,	short				*startRangePtr,	short				*endRangePtr){	OSAID		resultID;	OSAError	errOSA;	AEDesc		errorDesc = {typeNull, NULL};		if (mGenericSC == nil) {		return false;	}	errOSA = OSAExecute(mGenericSC, scriptID, kOSANullScript, kOSAModeAlwaysInteract, &resultID);	if (errOSA == errOSAScriptError) {		errOSA = OSAScriptError(mGenericSC, kOSAErrorRange, typeOSAErrorRange, &errorDesc);		AEDisposeDesc( &errorDesc );		return false;	}	else	if (errOSA != noErr) {		return false;	}	return true;}