;		if (!mScreenBackuped) {			EndFullScreen(mBkfullScreen, 0);		} else {			EndFullScreen(mOriginalScreen, 0);		}	}}// -------------------------------------------------------------------------------------------------//	･ FinishCreateSelf															[protected]// -------------------------------------------------------------------------------------------------voidCGameWindow::FinishCreateSelf(){	// Link the window (the listener) with its controls (the broadcasters).	UReanimator::LinkListenerToControls( this, this, PPob_GameWindow );		mFullScreen     = false;	mScreenBackuped = false;	mWindowSize.h   = 640;	mWindowSize.v   = 480;	mWindowOffset.h = 0;	mWindowOffset.v = 0;	mEvent          = nil;	mSystem         = nil;	AddAttachment(mWinAttach = new CGameWindowAttachment());		mouseTracker = new LMouseTracker();	mouseTracker->StartIdling();}// -------------------------------------------------------------------------------------------------//	･ HandleClick																[protected]// -------------------------------------------------------------------------------------------------voidCGameWindow::HandleClick(	const EventRecord	&inMacEvent,	SInt16				inPart ){	mEvent = (EventRecord *)&inMacEvent;	if (mSystem) {		Point	pt = {0,0};		mSystem->DnmlTask(pt, false);	}	LWindow::HandleClick(inMacEvent, inPart);}// -------------------------------------------------------------------------------------------------//	･ DrawSelf																	[protected]// -------------------------------------------------------------------------------------------------voidCGameWindow::DrawSelf(void){	LWindow::DrawSelf();	if (mFullScreen) {		HideMenuBar();	}	if (mSystem) {		mSystem->UpdateWindow();	}}// -------------------------------------------------------------------------------------------------//	･ MouseWithin																[protected]// -------------------------------------------------------------------------------------------------voidCGameWindow::MouseWithin(	Point				port,	const EventRecord	&inMacEvent){	mEvent = (EventRecord *)&inMacEvent;	if (mSystem) {		mSystem->DnmlTask(port, true);	}	LWindow::MouseWithin(port, inMacEvent);}// -------------------------------------------------------------------------------------------------//	･ ListenToMessage															[public, virtual]// -------------------------------------------------------------------------------------------------voidCGameWindow::ListenToMessage( 	MessageT	inMessage,	void		*ioParam ){#pragma unused( ioParam )	switch ( inMessage ) {			default:			break;	}}// -------------------------------------------------------------------------------------------------//	･ SetFullScreen																[public]// -------------------------------------------------------------------------------------------------voidCGameWindow::SetFullScreen(	Boolean		inFullMode ){	short	w, h;		if ( inFullMode ) {		if ( !mFullScreen ) {			mFullScreen = true;			if ( mWindowSize.h <= 640 && mWindowSize.v <= 480 ) {				w = 640;				h = 480;			} else			if ( mWindowSize.h <= 800 && mWindowSize.v <= 600 ) {				w = 800;				h = 600;			} else {				w = 1024;				h =  768;			}			ResizeWindowTo(w, h);			mWindowOffset.h = (w - mWindowSize.h) / 2;			mWindowOffset.v = (h - mWindowSize.v) / 2;						RGBColor	col = {0, 0, 0};			BeginFullScreen(&mBkfullScreen, 0, &w, &h, nil, &col, 0);			if (!mScreenBackuped) {				mOriginalScreen = mBkfullScreen;				mScreenBackuped = true;			}		    HideMenuBar();			mWindowPoint.h = 0;			mWindowPoint.v = 0;			PortToGlobalPoint(mWindowPoint);			MoveWindowBy(-mWindowPoint.h, -mWindowPoint.v);		}	} else {		if ( mFullScreen ) {			mFullScreen = false;			if (!mScreenBackuped) {				EndFullScreen(mBkfullScreen, 0);			} else {				EndFullScreen(mOriginalScreen, 0);			}			ResizeWindowTo(mWindowSize.h, mWindowSize.v);			MoveWindowBy(mWindowPoint.h, mWindowPoint.v);		}	}}// -------------------------------------------------------------------------------------------------//	･ SetScreenSize																[public]// -------------------------------------------------------------------------------------------------voidCGameWindow::SetScreenSize(	SInt16		inWidth,	SInt16		inHeight ){	ResizeWindowTo(inWidth, inHeight);	if (mFullScreen) {		if (mWindowSize.h != inWidth || mWindowSize.v != inHeight) {			if (!mScreenBackuped) {				EndFullScreen(mBkfullScreen, 0);			} else {				EndFullScreen(mOriginalScreen, 0);			}			SetFullScreen(true);		}	}	mWindowSize.h = inWidth;	mWindowSize.v = inHeight;}// -------------------------------------------------------------------------------------------------//	･ GetScreenSize																[public]// -------------------------------------------------------------------------------------------------voidCGameWindow::GetScreenSize(	SInt16		*outWidth,	SInt16		*outHeight ){	*outWidth  = mWindowSize.h;	*outHeight = mWindowSize.v;}// -------------------------------------------------------------------------------------------------//	･ GetWindowOffset															[public]// -------------------------------------------------------------------------------------------------voidCGameWindow::GetWindowOffset(	Point *outPoint ){	outPoint->h = mWindowOffset.h;	outPoint->v = mWindowOffset.v;}// -------------------------------------------------------------------------------------------------//	･ GetWindowPtr																[public]// -------------------------------------------------------------------------------------------------WindowPtrCGameWindow::GetWindowPtr(void){	return mMacWindowP;}// -------------------------------------------------------------------------------------------------//	･ ExecuteSelf							Control for Context Menu			[protected]// -------------------------------------------------------------------------------------------------voidCGameWindowAttachment::ExecuteSelf(MessageT inMess, void *ioParm){	CGameWindow		*theWindow = dynamic_cast<CGameWindow*>(LWindow::FindWindowByID(PPob_GameWindow));	ThrowIfNil_(theWindow);		EventRecord		*theEvent  = (EventRecord*)ioParm;	CSystem			*theSystem = theWindow->GetSystem();		theWindow->SetEvent(theEvent);	if (theSystem) {		Point	pt = {0,0};		theSystem->DnmlTask(pt, false);	}}