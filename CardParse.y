%name CardParse%header{#include <iostream>#include "CCard.h"%}%define	PURE%define ERROR_BODY  {}/* %define ERROR_BODY  { cerr << "Error: " << msg << endl; } */%define LEX_BODY    =0%define	MEMBERS		~CardParse();					\					CCard		*cardList;			\					int			resultType;			\					long		resultVal;			\					char		*resultStr;			\					char		curCardName[128];%define	CONSTRUCTOR_CODE	{						\			cardList = new CCard();					\		}%union{	long		lval;	char		name[128];}%token	VAR%token	NUMBER%token	STR%token	'(' ')' '{' '}' '[' ']'%right	'='%right	'?'%left	'>' '<' GTE LTE%left	'&' '|' '^'%left	'+' '-'%left	'*' '/' '%'%left	'!'%right	UNARYMINUS%type	<lval>	val_expr NUMBER%%card_expr	:	'(' val_expr ')'		{					if (resultType != 2) {						resultType = 0;						resultVal  = $2;						resultStr  = nil;					}				}			|	'{' VAR '}'				{					resultType = 1;					if (!cardList->existCard($<name>2)) {						resultStr = "";						resultVal = 0;					} else {						resultStr = cardList->getCardStr($<name>2);						resultVal = cardList->getCardVal($<name>2);					}				}			|	VAR						{					resultType = 0;					if (!cardList->existCard($<name>1)) {						cardList->addCard($<name>1);						cardList->setCardStr($<name>1, "1");						cardList->setCardVal($<name>1, 1);					}					resultStr = cardList->getCardStr($<name>1);					resultVal = cardList->getCardVal($<name>1);				}			|	error					{					resultType = -1;					resultVal  = -1;					resultStr  = nil;				}			;			val_expr	:	val_expr '>' val_expr	{					$$ =  ($1 > $3);					resultType = 0;					resultVal  = $$;				}			|	val_expr GTE val_expr	{					$$ =  ($1 >= $3);					resultType = 0;					resultVal  = $$;				}			|	val_expr '<' val_expr	{					$$ =  ($1 < $3);					resultType = 0;					resultVal  = $$;				}			|	val_expr LTE val_expr	{					$$ =  ($1 <= $3);					resultType = 0;					resultVal  = $$;				}			|	val_expr '&' val_expr	{					$$ =  ($1 && $3);					resultType = 0;					resultVal  = $$;				}			|	val_expr '|' val_expr	{					$$ =  ($1 || $3);					resultType = 0;					resultVal  = $$;				}			|	val_expr '+' val_expr	{					$$ =  $1 + $3;					resultType = 0;					resultVal  = $$;				}			|	val_expr '-' val_expr	{					$$ =  $1 - $3;					resultType = 0;					resultVal  = $$;				}			|	val_expr '*' val_expr	{					$$ =  $1 * $3;					resultType = 0;					resultVal  = $$;				}			|	val_expr '/' val_expr	{					$$ =  $1 / $3;					resultType = 0;					resultVal  = $$;				}			|	val_expr '%' val_expr	{					$$ =  $1 % $3;					resultType = 0;					resultVal  = $$;				}			|	val_expr '?' val_expr	{					if (resultType == 1) {						if (!cardList->existCard(curCardName)) {							$$ = 0;						} else {							$$ = cardList->cmpCardStr(curCardName, resultStr);						}					} else {						$$ =  ($1 == $3);					}					resultVal  = $$;					resultType = 0;				}			|	val_expr '^' STR		{					$$ = $1;					resultType = 2;					resultStr  = $<name>3;					resultVal  = $$;				}			|	'!' val_expr			{					$$ = !$2;					resultType = 0;					resultVal  = $$;				}			|	'(' val_expr ')'		{					$$ =  $2;					resultType = 0;					resultVal  = $$;				}			|	NUMBER					{					$$ =  $1;					resultType = 0;					resultVal  = $$;				}			|	'-' val_expr %prec UNARYMINUS	{					$$ =  -$2;					resultType = 0;					resultVal  = $$;				}			|	'[' VAR ']'				{					resultType = 1;					resultStr  = $<name>2;					$$ = 1;				}			|	'{' VAR '}'				{					resultType = 1;					if (!cardList->existCard($<name>2)) {						$$ = 0;						resultStr = "";					} else {						$$        = cardList->getCardVal($<name>2);						resultStr = cardList->getCardStr($<name>2);					}				}			|	VAR						{					strcpy(curCardName, $<name>1);					if (!cardList->existCard($<name>1)) {						$$ = 0;					} else {						$$ = cardList->getCardVal($<name>1);					}				}			|	VAR      '=' val_expr	{					if (resultType == 0) {						if (!cardList->existCard($<name>1)) {							cardList->addCard($<name>1);						}						char	tmp[32];						sprintf(tmp, "%d", $3);						cardList->setCardStr($<name>1, tmp);						cardList->setCardVal($<name>1, $3);						$$ = $3;					} else {						if (!cardList->existCard($<name>1)) {							cardList->addCard($<name>1);							cardList->setCardVal($<name>1, 1);						}						if (!atoi(cardList->getCardStr($<name>1))) {							char	tmp[32];							sprintf(tmp, "%d", $3);							cardList->setCardStr($<name>1, tmp);						} else {							cardList->setCardStr($<name>1, resultStr);						}						$$ = cardList->getCardVal($<name>1);					}				}			;%%#ifdef YY_USE_CLASSYY_CardParse_CLASS::#endif~YY_CardParse_CLASS(){	delete cardList;}